# HTTP
KRILL_LISTEN_ADDR=:8080
# Postgres (локальный из docker-compose.dev.yml)
KRILL_DATABASE_URL=postgres://krill:krill@localhost:5432/krill?sslmode=disable
# Seed-админ (создаётся при старте, если отсутствует)
KRILL_ADMIN_EMAIL=admin@krill.local
KRILL_ADMIN_PASSWORD=changeme
# Docker (Colima): Go SDK не читает docker context — указываем сокет явно
KRILL_DOCKER_HOST=unix://$HOME/.colima/default/docker.sock
# Локальные домены приложений через sslip.io
KRILL_BASE_DOMAIN=127-0-0-1.sslip.io
# Overlay-сеть Swarm
KRILL_NETWORK=krill-net
# В локальной http-разработке cookie без Secure
KRILL_COOKIE_SECURE=false

# Для тестов с testcontainers на Colima (если docker context не colima):
# export DOCKER_HOST=unix://$HOME/.colima/default/docker.sock
# export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock

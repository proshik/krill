# HTTP
KRILL_LISTEN_ADDR=:8080
# Postgres (local, from docker-compose.dev.yml)
KRILL_DATABASE_URL=postgres://krill:krill@localhost:5432/krill?sslmode=disable
# Seed admin (created on startup if missing)
KRILL_ADMIN_EMAIL=admin@krill.local
KRILL_ADMIN_PASSWORD=changeme
# Docker (Colima): the Go SDK does not read the docker context — specify the socket explicitly
KRILL_DOCKER_HOST=unix://$HOME/.colima/default/docker.sock
# Local application domains via sslip.io
KRILL_BASE_DOMAIN=127-0-0-1.sslip.io
# Swarm overlay network
KRILL_NETWORK=krill-net
# In local http development, cookie without Secure
KRILL_COOKIE_SECURE=false
# Logging: level (debug|info|warn|error) and format (text|json)
KRILL_LOG_LEVEL=info
KRILL_LOG_FORMAT=text
# Let's Encrypt: contact email (falls back to KRILL_ADMIN_EMAIL) and staging CA toggle
KRILL_ACME_EMAIL=
KRILL_ACME_STAGING=false

# For tests with testcontainers on Colima (if the docker context is not colima):
# export DOCKER_HOST=unix://$HOME/.colima/default/docker.sock
# export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock

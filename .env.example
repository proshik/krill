# HTTP
KRILL_LISTEN_ADDR=:8080
# Postgres (local, from docker-compose.dev.yml)
KRILL_DATABASE_URL=postgres://krill:krill@localhost:5432/krill?sslmode=disable
# Seed admin (created on startup if missing)
KRILL_ADMIN_EMAIL=admin@krill.local
KRILL_ADMIN_PASSWORD=changeme
# Docker (Colima): the Go SDK does not read the docker context — specify the socket explicitly
KRILL_DOCKER_HOST=unix://$HOME/.colima/default/docker.sock
# Local application domains via sslip.io
KRILL_BASE_DOMAIN=127-0-0-1.sslip.io
# Swarm overlay network
KRILL_NETWORK=krill-net
# In local http development, cookie without Secure
KRILL_COOKIE_SECURE=false
# Trust X-Forwarded-For for the client IP (login rate limiting). Enable only
# behind a reverse proxy that sets the header; otherwise clients can forge it.
KRILL_TRUST_PROXY=false
# Logging: level (debug|info|warn|error) and format (text|json)
KRILL_LOG_LEVEL=info
KRILL_LOG_FORMAT=text
# Let's Encrypt: contact email (falls back to KRILL_ADMIN_EMAIL) and staging CA toggle
KRILL_ACME_EMAIL=
KRILL_ACME_STAGING=false

# Default resource limits for apps/DB instances with no explicit value of their
# own (an unlimited container can take the whole host and starve every other
# tenant). Human units; empty disables the default. The Advanced tab overrides
# these per app.
KRILL_DEFAULT_MEMORY_LIMIT=512m
KRILL_DEFAULT_CPU_LIMIT=1.0

# The build queue is one worker shared by every tenant: cap how many deploys
# one organization may have in flight at once (<= 0 disables the cap), and
# prune the BuildKit cache on an interval so a small VPS's disk doesn't fill
# silently (empty KRILL_BUILD_CACHE_LIMIT or a non-positive interval disables
# pruning).
KRILL_MAX_BUILDS_PER_ORG=2
KRILL_BUILD_CACHE_LIMIT=5gb
KRILL_BUILD_PRUNE_INTERVAL=24h

# Backups (Phase 4) need no env — S3 destinations are configured in the UI per organization.

# For tests with testcontainers on Colima (if the docker context is not colima):
# export DOCKER_HOST=unix://$HOME/.colima/default/docker.sock
# export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock

# Self-update (Settings → Updates)
# KRILL_UPDATE_CHECK_INTERVAL=24h
# KRILL_UPDATE_REPO=proshik/krill

package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
)

// DatabaseCtx — данные detail-страницы БД (engine + одна из строк + connection strings + база URL).
type DatabaseCtx struct {
	Org      db.Organization
	Role     string
	Project  db.Project
	Env      db.Environment
	Engine   string // "postgres" | "redis"
	ID       int64
	Name     string
	Image    string
	Status   string
	Internal string
	External string
	Base     string // путь до /databases/{engine}/{id}
	Tab      string
}

templ DatabaseDetail(c DatabaseCtx) {
	@Layout(c.Name, c.Org, c.Role) {
		<p class="k-crumbs mb-3">
			<a href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID) + "/projects/" + itoa(c.Project.ID)) }>{ c.Project.Name }</a> /
			{ c.Env.Name } / { c.Name }
		</p>
		<div class="k-frame"><div class="k-panel">
			<div class="k-panel-head">
				<div><div class="k-panel-title">{ c.Name }</div><div class="k-panel-desc k-mono">{ c.Image }</div></div>
				<div class="flex items-center gap-2">
					<span hx-get={ c.Base + "/status" } hx-trigger="every 2s" hx-target="this" hx-swap="outerHTML">@StatusBadge(c.Status)</span>
				</div>
			</div>
			<div class="k-panel-body flex flex-col gap-4">
				if c.Role == "owner" || c.Role == "admin" {
					<div class="flex gap-2 flex-wrap">
						<form method="post" action={ templ.SafeURL(c.Base + "/deploy") }><button class="k-btn k-btn-primary">{ i18n.T(ctx, "db.deploy") }</button></form>
						<form method="post" action={ templ.SafeURL(c.Base + "/start") }><button class="k-btn k-btn-secondary">{ i18n.T(ctx, "db.start") }</button></form>
						<form method="post" action={ templ.SafeURL(c.Base + "/stop") }><button class="k-btn k-btn-secondary">{ i18n.T(ctx, "db.stop") }</button></form>
						<form method="post" action={ templ.SafeURL(c.Base + "/delete") } onsubmit="return confirm('Delete database?')" class="flex items-center gap-2">
							<button class="k-btn k-btn-danger">{ i18n.T(ctx, "db.delete") }</button>
							<label class="k-label"><input type="checkbox" name="destroy_data"/> { i18n.T(ctx, "db.delete.destroyData") }</label>
						</form>
					</div>
					<form method="post" action={ templ.SafeURL(c.Base + "/version") } class="flex items-end gap-2">
						<div class="flex-1"><label class="k-label">{ i18n.T(ctx, "db.change_version") }</label><input class="k-input" name="image" value={ c.Image }/></div>
						<button class="k-btn k-btn-secondary">{ i18n.T(ctx, "db.deploy") }</button>
					</form>
				}
				<div>
					<div class="k-label">{ i18n.T(ctx, "db.connection") } — { i18n.T(ctx, "db.internal") }</div>
					<input class="k-input k-mono" readonly value={ c.Internal }/>
					if c.External != "" {
						<div class="k-label">{ i18n.T(ctx, "db.connection") } — { i18n.T(ctx, "db.external") }</div>
						<input class="k-input k-mono" readonly value={ c.External }/>
					}
				</div>
				<div>
					<div class="k-label">Logs</div>
					<div id="terminal" data-ws={ c.Base + "/logs" }></div>
					<script src="/static/xterm.js"></script>
					<script src="/static/addon-fit.js"></script>
					<script src="/static/app.js"></script>
					<script>mountLogTerminal(document.getElementById('terminal').dataset.ws);</script>
				</div>
			</div>
		</div></div>
	}
}

package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/dbservice"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// LogicalDBCtx holds the logical-database page data. Lifecycle (deploy/start/
// stop/version/node/logs) lives on the server's page, not here.
type LogicalDBCtx struct {
	Shell   Shell
	Org     db.Organization
	Role    string
	Project db.Project
	Env     db.Environment
	LDB     db.LogicalDatabase
	Inst    db.DbInstance
	Node    string // where the server runs

	Internal string
	External string
	Base     string // path to /databases/{id}

	Users  []UsedBy
	Backup BackupBlock

	Conn    *dbservice.ConnStats // connection budget (admins; nil when not read)
	ConnErr bool                 // the stats could not be read
}

templ DatabaseDetail(c LogicalDBCtx) {
	@Page(c.Shell) {
		<main class="wrap wrap--narrow">
			<div class="page-head page-head--obj">
				<div class="sheet-title">
					@ui.Glyph("i-pg")
					<h1>{ c.LDB.Name }</h1>
					@ServerStateBadge(c.Inst.Status, "/orgs/"+itoa(c.Org.ID)+"/db-servers/"+itoa(c.Inst.ID)+"/status")
				</div>
				<p class="run-meta">
					{ i18n.T(ctx, "ldb.on_server") + " " }
					<a href={ templ.SafeURL(orgURL(c.Org.ID) + "/db-servers/" + itoa(c.Inst.ID)) }>{ c.Inst.Name }</a>
					if c.Node != "" {
						{ ", " + c.Node }
					}
				</p>
			</div>
			<section class="sec" aria-labelledby="cn-h">
				<h2 id="cn-h">{ i18n.T(ctx, "db.connection") }</h2>
				if isAdmin(c.Role) && c.Internal != "" {
					@ui.CopyField("dburl", i18n.T(ctx, "db.url_internal"), c.Internal, true, i18n.T(ctx, "common.copy"), i18n.T(ctx, "common.reveal"))
					if c.External != "" {
						@ui.CopyField("dburl-ext", i18n.T(ctx, "db.url_external"), c.External, true, i18n.T(ctx, "common.copy"), i18n.T(ctx, "common.reveal"))
					}
				} else if isAdmin(c.Role) {
					<p class="field-err">{ i18n.T(ctx, "db.password_unreadable") }</p>
				}
				<div class="row row--even">
					@ui.CopyField("dbuser", i18n.T(ctx, "db.user"), c.LDB.Username, false, i18n.T(ctx, "common.copy"), "")
					@ui.CopyField("dbname", i18n.T(ctx, "db.database"), c.LDB.DbName, false, i18n.T(ctx, "common.copy"), "")
				</div>
				<p class="hint">{ i18n.T(ctx, "db.links_hint") }</p>
			</section>
			<section class="sec" aria-labelledby="ub-h">
				<h2 id="ub-h">{ i18n.T(ctx, "envdb.used_by") }</h2>
				@usedByList(c.Users, i18n.T(ctx, "db.no_users"))
			</section>
			if isAdmin(c.Role) {
				@connSection(c)
				@backupBlock(c.Backup)
				<form class="sec sec--danger" method="post" hx-boost="false" action={ templ.SafeURL(c.Base + "/delete") } data-confirm={ i18n.Tf(ctx, "confirm.delete_ldb", c.LDB.Name) } data-more={ i18n.T(ctx, "db.delete_more") } data-ok={ i18n.T(ctx, "common.delete") } onsubmit="return krillConfirm(this)" aria-labelledby="dd-h">
					<h2 id="dd-h">{ i18n.T(ctx, "db.delete") }</h2>
					<p class="hint">{ i18n.Tf(ctx, "db.delete_hint", c.Inst.Name) }</p>
					<div><button type="submit" class="pill pill--danger">{ i18n.Tf(ctx, "common.delete_named", c.LDB.Name) }</button></div>
				</form>
			}
		</main>
	}
}

// usedByList is the cross-link list of the apps that use something.
templ usedByList(users []UsedBy, empty string) {
	if len(users) == 0 {
		<p class="empty">{ empty }</p>
	} else {
		<span class="reg-apps">
			for _, u := range users {
				<a href={ templ.SafeURL(u.Href) }>
					{ u.Name }
					if u.Note != "" {
						<em>{ u.Note }</em>
					}
				</a>
			}
		</span>
	}
}

// ServerStateBadge is a server's live state, refreshing itself.
templ ServerStateBadge(status, pollURL string) {
	{{ kind, text := ServerState(ctx, status) }}
	<span class={ "state", "state--" + kind } hx-get={ pollURL } hx-trigger="every 3s" hx-swap="outerHTML">
		@ui.Sig(kind)
		{ text }
	</span>
}

templ connSection(c LogicalDBCtx) {
	<section class="sec" aria-labelledby="conn-h">
		<h2 id="conn-h">{ i18n.T(ctx, "conn.section") }</h2>
		if c.ConnErr {
			<p class="empty">{ i18n.T(ctx, "conn.unavailable") }</p>
		} else if c.Conn != nil {
			<dl class="facts">
				<div><dt>{ i18n.T(ctx, "conn.server") }</dt><dd>{ i18n.Tf(ctx, "conn.of_max", c.Conn.Total, c.Conn.Max) }</dd></div>
				<div><dt>{ i18n.T(ctx, "conn.database") }</dt><dd>{ itoa(int64(c.Conn.Database)) }</dd></div>
				<div><dt>{ i18n.T(ctx, "conn.role") }</dt><dd>{ itoa(int64(c.Conn.Role)) }</dd></div>
				<div><dt>{ i18n.T(ctx, "conn.idle_tx") }</dt><dd>{ itoa(int64(c.Conn.IdleInTx)) }</dd></div>
				<div><dt>{ i18n.T(ctx, "conn.advisory") }</dt><dd>{ itoa(int64(c.Conn.AdvisoryLocks)) }</dd></div>
			</dl>
			for _, w := range connWarnings(ctx, *c.Conn) {
				<p class="callout callout--warn">{ w }</p>
			}
			<p class="hint">{ i18n.T(ctx, "conn.note") }</p>
		}
	</section>
}

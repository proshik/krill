package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
)

// LogicalDBCtx holds the logical-database detail-page data (the row + its
// instance + connection strings + base URL). Lifecycle (deploy/start/stop/
// version/node/logs) lives on the instance detail page, not here.
type LogicalDBCtx struct {
	Org     db.Organization
	Role    string
	Project db.Project
	Env     db.Environment
	LDB     db.LogicalDatabase
	Inst    db.DbInstance

	Internal string
	External string
	Base     string // path to /databases/{id}

	Backups      []db.ListBackupsByLogicalDBRow // configured backups
	Destinations []db.Destination               // org S3 destinations
}

templ DatabaseDetail(c LogicalDBCtx) {
	@Layout(c.LDB.Name, c.Org, c.Role) {
		<p class="k-crumbs mb-3">
			<a href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID) + "/projects/" + itoa(c.Project.ID)) }>{ c.Project.Name }</a> /
			<a href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID) + "/projects/" + itoa(c.Project.ID) + "/environments/" + itoa(c.Env.ID)) }>{ c.Env.Name }</a> / { c.LDB.Name }
		</p>
		<div class="k-frame"><div class="k-panel">
			<div class="k-panel-head">
				<div><div class="k-panel-title">{ c.LDB.Name }</div><div class="k-panel-desc k-mono">{ c.LDB.DbName + " @ " + c.Inst.Name }</div></div>
				<div class="flex items-center gap-2">
					<span hx-get={ "/orgs/" + itoa(c.Org.ID) + "/db-servers/" + itoa(c.Inst.ID) + "/status" } hx-trigger="every 2s" hx-target="this" hx-swap="outerHTML">@StatusBadge(c.Inst.Status)</span>
				</div>
			</div>
			<div class="k-panel-body flex flex-col gap-4">
				<p class="k-mono text-xs">
					<a class="underline" href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID) + "/db-servers/" + itoa(c.Inst.ID)) }>{ i18n.T(ctx, "ldb.view_instance") }</a>
				</p>
				if c.Role == "owner" || c.Role == "admin" {
					<div>
						<div class="k-label">{ i18n.T(ctx, "db.connection") } — { i18n.T(ctx, "db.internal") }</div>
						<div class="flex items-center gap-2">
							<input class="k-input k-mono" type="password" readonly value={ c.Internal }/>
							<button type="button" class="k-copy" onclick="krillReveal(this)" aria-label={ i18n.T(ctx, "common.reveal") }>👁</button>
							<button type="button" class="k-copy" data-copy={ c.Internal } onclick="krillCopyToClip(this.dataset.copy, 'Connection string')">{ i18n.T(ctx, "common.copy") }</button>
						</div>
						if c.External != "" {
							<div class="k-label">{ i18n.T(ctx, "db.connection") } — { i18n.T(ctx, "db.external") }</div>
							<div class="flex items-center gap-2">
								<input class="k-input k-mono" type="password" readonly value={ c.External }/>
								<button type="button" class="k-copy" onclick="krillReveal(this)" aria-label={ i18n.T(ctx, "common.reveal") }>👁</button>
								<button type="button" class="k-copy" data-copy={ c.External } onclick="krillCopyToClip(this.dataset.copy, 'Connection string')">{ i18n.T(ctx, "common.copy") }</button>
							</div>
						}
					</div>
					@backupsSection(c)
					<form method="post" hx-boost="false" action={ templ.SafeURL(c.Base + "/delete") } data-confirm={ i18n.Tf(ctx, "confirm.delete_ldb", c.LDB.Name) } onsubmit="return krillConfirm(this, this.dataset.confirm)">
						<button class="k-btn k-btn-danger">{ i18n.T(ctx, "db.delete") }</button>
					</form>
				}
			</div>
		</div></div>
	}
}

templ backupsSection(c LogicalDBCtx) {
	<div>
		<div class="k-label">{ i18n.T(ctx, "backup.section") }</div>
		if len(c.Backups) == 0 {
			<p class="k-muted">{ i18n.T(ctx, "backup.none") }</p>
		} else {
			<table class="k-table">
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "backup.destination") }</th>
						<th>{ i18n.T(ctx, "backup.schedule") }</th>
						<th>{ i18n.T(ctx, "backup.retention") }</th>
						<th>{ i18n.T(ctx, "backup.enabled") }</th>
						<th>{ i18n.T(ctx, "backup.last_run") }</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, b := range c.Backups {
						<tr>
							<td>{ destName(c.Destinations, b.DestinationID) }</td>
							<td>{ scheduleLabel(ctx, b.Schedule) }</td>
							<td>{ itoa(int64(b.Retention)) }</td>
							<td>
								if b.Enabled {
									<span class="k-badge k-badge-running"><span class="k-dot"></span>{ i18n.T(ctx, "backup.enabled") }</span>
								} else {
									<span class="k-badge k-badge-idle"><span class="k-dot"></span>—</span>
								}
							</td>
							<td>
								<div>{ tsStr(b.LastRunAt) } { b.LastStatus }</div>
								if b.LastError != "" {
									<div class="text-xs" style="color:var(--color-err)">{ b.LastError }</div>
								}
							</td>
							<td>
								<div class="flex items-center gap-2 flex-wrap">
									<form method="post" action={ templ.SafeURL(c.Base + "/backups/" + itoa(b.ID) + "/run") } data-busy={ i18n.T(ctx, "backup.running") } onsubmit="krillBusy(this.querySelector('button'), this.dataset.busy)" class="inline">
										<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "backup.run_now") }</button>
									</form>
									<form method="post" action={ templ.SafeURL(c.Base + "/backups/" + itoa(b.ID) + "/toggle") } class="inline">
										<input type="hidden" name="enabled" value={ onOff(!b.Enabled) }/>
										if b.Enabled {
											<button class="k-btn k-btn-secondary">{ i18n.T(ctx, "backup.pause") }</button>
										} else {
											<button class="k-btn k-btn-secondary">{ i18n.T(ctx, "backup.resume") }</button>
										}
									</form>
									<form method="post" hx-boost="false" action={ templ.SafeURL(c.Base + "/backups/" + itoa(b.ID) + "/delete") } data-confirm={ i18n.Tf(ctx, "confirm.delete_backup", destName(c.Destinations, b.DestinationID)) } onsubmit="return krillConfirm(this, this.dataset.confirm)" class="inline">
										<button class="k-btn k-btn-danger">{ i18n.T(ctx, "backup.delete") }</button>
									</form>
								</div>
							</td>
						</tr>
						<tr>
							<td colspan="6">
								<div class="k-label">{ i18n.T(ctx, "backup.objects") }</div>
								<div hx-get={ c.Base + "/backups/" + itoa(b.ID) + "/objects" } hx-trigger="load" hx-swap="innerHTML"></div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		if len(c.Destinations) == 0 {
			<p class="k-muted">{ i18n.T(ctx, "backup.no_destinations") }</p>
			@inlineDestinationForm(c.Org.ID, c.Base)
		} else {
			<form method="post" action={ templ.SafeURL(c.Base + "/backups") } class="mt-4 flex flex-col gap-2">
				<div>
					<label class="k-label">{ i18n.T(ctx, "backup.destination") }</label>
					<select class="k-select" name="destination_id">
						for _, d := range c.Destinations {
							<option value={ itoa(d.ID) }>{ d.Name }</option>
						}
					</select>
				</div>
				@scheduleSelect()
				<div>
					<label class="k-label">{ i18n.T(ctx, "backup.retention") }</label>
					<input class="k-input" name="retention" type="number" value="7" min="1"/>
				</div>
				@backupAdvanced()
				<div><button class="k-btn k-btn-primary">{ i18n.T(ctx, "backup.add") }</button></div>
			</form>
		}
	</div>
}

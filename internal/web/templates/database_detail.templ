package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
)

// DatabaseCtx holds the database detail-page data (engine + one of the rows + connection strings + base URL).
type DatabaseCtx struct {
	Org      db.Organization
	Role     string
	Project  db.Project
	Env      db.Environment
	Engine   string // "postgres" | "redis"
	ID       int64
	Name     string
	Image    string
	Status   string
	Internal string
	External string
	Base     string // path to /databases/{engine}/{id}
	Tab      string

	Backups      []db.Backup      // postgres only: configured backups
	Destinations []db.Destination // postgres only: org S3 destinations
}

templ DatabaseDetail(c DatabaseCtx) {
	@Layout(c.Name, c.Org, c.Role) {
		<p class="k-crumbs mb-3">
			<a href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID) + "/projects/" + itoa(c.Project.ID)) }>{ c.Project.Name }</a> /
			<a href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID) + "/projects/" + itoa(c.Project.ID) + "/environments/" + itoa(c.Env.ID)) }>{ c.Env.Name }</a> / { c.Name }
		</p>
		<div class="k-frame"><div class="k-panel">
			<div class="k-panel-head">
				<div><div class="k-panel-title">{ c.Name }</div><div class="k-panel-desc k-mono">{ c.Image }</div></div>
				<div class="flex items-center gap-2">
					<span hx-get={ c.Base + "/status" } hx-trigger="every 2s" hx-target="this" hx-swap="outerHTML">@StatusBadge(c.Status)</span>
				</div>
			</div>
			<div class="k-panel-body flex flex-col gap-4">
				if c.Role == "owner" || c.Role == "admin" {
					<div class="flex gap-2 flex-wrap">
						<form method="post" action={ templ.SafeURL(c.Base + "/deploy") } onsubmit="krillBusy(this.querySelector('button'), 'Deploying…')"><button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "db.deploy") }</button></form>
						<form method="post" action={ templ.SafeURL(c.Base + "/start") } onsubmit="krillBusy(this.querySelector('button'), 'Starting…')"><button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "db.start") }</button></form>
						<form method="post" action={ templ.SafeURL(c.Base + "/stop") } onsubmit="krillBusy(this.querySelector('button'), 'Stopping…')"><button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "db.stop") }</button></form>
						<form method="post" action={ templ.SafeURL(c.Base + "/delete") } data-db-name={ c.Name } onsubmit="return krillConfirmDbDelete(this)" class="flex items-center gap-2">
							<button class="k-btn k-btn-danger">{ i18n.T(ctx, "db.delete") }</button>
							<label class="k-label"><input type="checkbox" name="destroy_data"/> { i18n.T(ctx, "db.delete.destroyData") }</label>
						</form>
					</div>
					<form method="post" action={ templ.SafeURL(c.Base + "/version") } onsubmit="krillBusy(this.querySelector('button'), 'Updating…')" class="flex items-end gap-2">
						<div class="flex-1"><label class="k-label">{ i18n.T(ctx, "db.change_version") }</label><input class="k-input" name="image" value={ c.Image }/></div>
						<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "db.deploy") }</button>
					</form>
				}
				<div>
					<div class="k-label">{ i18n.T(ctx, "db.connection") } — { i18n.T(ctx, "db.internal") }</div>
					<div class="flex items-center gap-2">
						<input class="k-input k-mono" readonly value={ c.Internal }/>
						<button type="button" class="k-copy" data-copy={ c.Internal } onclick="krillCopyToClip(this.dataset.copy, 'Connection string')">Copy</button>
					</div>
					if c.External != "" {
						<div class="k-label">{ i18n.T(ctx, "db.connection") } — { i18n.T(ctx, "db.external") }</div>
						<div class="flex items-center gap-2">
							<input class="k-input k-mono" readonly value={ c.External }/>
							<button type="button" class="k-copy" data-copy={ c.External } onclick="krillCopyToClip(this.dataset.copy, 'Connection string')">Copy</button>
						</div>
					}
				</div>
				<div>
					<div class="k-label">Logs</div>
					<div id="terminal" data-ws={ c.Base + "/logs" }></div>
					<script src="/static/xterm.js"></script>
					<script src="/static/addon-fit.js"></script>
					<script src="/static/app.js"></script>
					<script>mountLogTerminal(document.getElementById('terminal').dataset.ws);</script>
				</div>
				if c.Engine == "postgres" && (c.Role == "owner" || c.Role == "admin") {
					@backupsSection(c)
				}
			</div>
		</div></div>
	}
}

templ backupsSection(c DatabaseCtx) {
	<div>
		<div class="k-label">{ i18n.T(ctx, "backup.section") }</div>
		if len(c.Backups) == 0 {
			<p class="k-muted">{ i18n.T(ctx, "backup.none") }</p>
		} else {
			<table class="k-table">
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "backup.destination") }</th>
						<th>{ i18n.T(ctx, "backup.schedule") }</th>
						<th>{ i18n.T(ctx, "backup.retention") }</th>
						<th>{ i18n.T(ctx, "backup.enabled") }</th>
						<th>{ i18n.T(ctx, "backup.last_run") }</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, b := range c.Backups {
						<tr>
							<td>{ destName(c.Destinations, b.DestinationID) }</td>
							<td class="k-mono">{ b.Schedule }</td>
							<td>{ itoa(int64(b.Retention)) }</td>
							<td>
								if b.Enabled {
									<span class="k-badge k-badge-running"><span class="k-dot"></span>{ i18n.T(ctx, "backup.enabled") }</span>
								} else {
									<span class="k-badge k-badge-idle"><span class="k-dot"></span>—</span>
								}
							</td>
							<td>
								<div>{ tsStr(b.LastRunAt) } { b.LastStatus }</div>
								if b.LastError != "" {
									<div class="text-xs" style="color:var(--color-err)">{ b.LastError }</div>
								}
							</td>
							<td>
								<div class="flex items-center gap-2 flex-wrap">
									<form method="post" action={ templ.SafeURL(c.Base + "/backups/" + itoa(b.ID) + "/run") } onsubmit="krillBusy(this.querySelector('button'), 'Running…')" class="inline">
										<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "backup.run_now") }</button>
									</form>
									<form method="post" action={ templ.SafeURL(c.Base + "/backups/" + itoa(b.ID) + "/toggle") } class="inline">
										<button class="k-btn k-btn-secondary">{ i18n.T(ctx, "backup.toggle") }</button>
									</form>
									<form method="post" action={ templ.SafeURL(c.Base + "/backups/" + itoa(b.ID) + "/delete") } data-dest={ destName(c.Destinations, b.DestinationID) } onsubmit="return confirm('Delete backup schedule for ' + this.dataset.dest + '?')" class="inline">
										<button class="k-btn k-btn-danger">{ i18n.T(ctx, "backup.delete") }</button>
									</form>
								</div>
							</td>
						</tr>
						<tr>
							<td colspan="6">
								<div class="k-label">{ i18n.T(ctx, "backup.objects") }</div>
								<div hx-get={ c.Base + "/backups/" + itoa(b.ID) + "/objects" } hx-trigger="load" hx-swap="innerHTML"></div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		if len(c.Destinations) == 0 {
			<p class="k-muted">
				{ i18n.T(ctx, "backup.no_destinations") }
				<a class="underline" href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID) + "/destinations") }>{ i18n.T(ctx, "dest.link") }</a>
			</p>
		} else {
			<form method="post" action={ templ.SafeURL(c.Base + "/backups") } class="mt-4 flex flex-col gap-2">
				<div>
					<label class="k-label">{ i18n.T(ctx, "backup.destination") }</label>
					<select class="k-select" name="destination_id">
						for _, d := range c.Destinations {
							<option value={ itoa(d.ID) }>{ d.Name }</option>
						}
					</select>
				</div>
				<div>
					<label class="k-label k-label-required">{ i18n.T(ctx, "backup.schedule") }</label>
					<input class="k-input" name="schedule" required placeholder="0 3 * * *"/>
				</div>
				<div>
					<label class="k-label">{ i18n.T(ctx, "backup.retention") }</label>
					<input class="k-input" name="retention" type="number" value="7" min="1"/>
				</div>
				<div>
					<label class="k-label">{ i18n.T(ctx, "backup.prefix") }</label>
					<input class="k-input" name="prefix"/>
				</div>
				<div><button class="k-btn k-btn-primary">{ i18n.T(ctx, "backup.add") }</button></div>
			</form>
		}
	</div>
}

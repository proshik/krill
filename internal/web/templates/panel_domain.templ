package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// PanelDomainView is the state of the Krill UI's own domain.
type PanelDomainView struct {
	Available        bool   // the gateway can reach Krill; the domain can be set
	UnavailableKey   string // i18n key explaining why it cannot
	Host             string
	State            string // off | pending | active
	AllowedIPs       string // newline-separated
	HSTSMaxAge       int32
	HSTSPresets      []int32
	OnDomain         bool   // this page was loaded through the domain over HTTPS
	DomainURL        string // this page on the domain
	DirectURL        string // a public address of the UI port, e.g. http://203.0.113.10:8080; "" if unknown
	DirectPort       string // the UI port, for when no address is known
	HostDirectClosed bool   // the host's live ruleset closes the UI port to the world
	DirectDrift      bool   // ... and that disagrees with DirectPortClosed
	// KrillTableMissing: the drift is that Krill's own table is not on the
	// host at all, so Krill does not know whether another firewall closes it.
	KrillTableMissing bool
	DirectPortClosed bool
	ClosePending     bool // a close is applied and awaits confirmation
	CloseReverted    bool // a close was not confirmed in time and reverted
	FirewallWired    bool
	FirewallLocked   bool
	ClientIP         string
}

// PanelDomain renders the panel domain settings: the domain and its
// confirmation, the IP allowlist, HSTS, and closing the direct UI port.
templ PanelDomain(org db.Organization, role string, v PanelDomainView) {
	@SettingsPage(org, role, "panel", i18n.T(ctx, "panel.title")) {
		if !v.Available {
			<div class="callout callout--warn"><div class="callout-body"><p>{ i18n.T(ctx, v.UnavailableKey) }</p></div></div>
		} else {
			<section class="sec" aria-labelledby="pd-h">
				<div class="sec-head">
					<h3 id="pd-h">{ i18n.T(ctx, "panel.domain") }</h3>
					switch v.State {
						case "pending":
							@ui.State("warn", i18n.T(ctx, "panel.state.pending"))
						case "active":
							@ui.State("ok", i18n.T(ctx, "panel.state.active"))
						default:
							@ui.State("idle", i18n.T(ctx, "panel.state.off"))
					}
				</div>
				<p class="hint">{ i18n.T(ctx, "panel.desc") }</p>
				if v.State == "pending" {
					<div class="callout callout--warn">
						<div class="callout-body">
							if v.OnDomain {
								<p>{ i18n.T(ctx, "panel.pending_on_domain") }</p>
								<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/panel-domain/confirm") }>
									<button type="submit" class="btn btn--primary">{ i18n.T(ctx, "panel.confirm") }</button>
								</form>
							} else {
								<p>{ i18n.T(ctx, "panel.pending_off_domain") }</p>
								<p><a href={ templ.SafeURL(v.DomainURL) } target="_blank" rel="noopener">{ v.DomainURL }</a></p>
							}
						</div>
					</div>
				}
				if v.State == "active" && !v.OnDomain {
					<p class="hint">
						{ i18n.T(ctx, "panel.active_off_domain") + " " }
						<a href={ templ.SafeURL(v.DomainURL) }>{ v.DomainURL }</a>
					</p>
				}
				<form class="add-row" method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/panel-domain") }>
					<div class="field">
						<label for="phost">{ i18n.T(ctx, "panel.host") }</label>
						<input class="input input--mono" id="phost" name="host" value={ v.Host } placeholder="krill.example.com" required autocomplete="off" spellcheck="false" aria-describedby="phost-hint"/>
					</div>
					<button type="submit" class="pill">{ i18n.T(ctx, "common.save") }</button>
					<p class="field-hint" id="phost-hint">{ i18n.T(ctx, "panel.host_hint") }</p>
				</form>
				if v.State != "off" && !v.DirectPortClosed && !v.ClosePending {
					<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/panel-domain/disable") } data-confirm={ i18n.T(ctx, "panel.confirm.disable") } data-more={ i18n.T(ctx, "panel.disable_more") } data-ok={ i18n.T(ctx, "common.remove") } onsubmit="return krillConfirm(this)">
						<button type="submit" class="pill pill--danger">{ i18n.T(ctx, "panel.disable") }</button>
					</form>
				}
			</section>
			if v.State == "active" && v.FirewallWired {
				<section class="sec" aria-labelledby="da-h">
					<div class="sec-head">
						<h3 id="da-h">{ i18n.T(ctx, "panel.direct") }</h3>
						if v.ClosePending {
							@ui.State("warn", i18n.T(ctx, "panel.direct_state_pending"))
						} else if v.DirectPortClosed {
							@ui.State("ok", i18n.T(ctx, "panel.direct_state_closed"))
						} else {
							@ui.State("warn", i18n.T(ctx, "panel.direct_state_open"))
						}
					</div>
					if v.CloseReverted {
						<div class="callout callout--err"><p>{ i18n.T(ctx, "panel.direct_reverted") }</p></div>
					}
					if v.DirectDrift {
						<div class="callout callout--err">
							<p>
								if v.HostDirectClosed {
									{ i18n.T(ctx, "panel.direct_drift_host_closed") }
								} else if v.KrillTableMissing {
									{ i18n.T(ctx, "panel.direct_drift_no_table") }
								} else {
									{ i18n.T(ctx, "panel.direct_drift_host_open") }
								}
							</p>
						</div>
					}
					if v.ClosePending {
						<div class="callout callout--warn">
							<div class="callout-body">
								<p>{ i18n.T(ctx, "panel.direct_pending") }</p>
								if v.OnDomain {
									<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/panel-domain/direct-port/confirm") }>
										<button type="submit" class="btn btn--primary">{ i18n.T(ctx, "panel.direct_confirm") }</button>
									</form>
								}
							</div>
						</div>
					} else if v.DirectPortClosed {
						if !v.KrillTableMissing {
							<p class="hint">{ i18n.T(ctx, "panel.direct_closed") }</p>
						}
						if v.KrillTableMissing {
							// Its own route: it only clears the record, and refuses
							// should Krill's table be back.
							<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/panel-domain/direct-port/record") }>
								<button type="submit" class="pill">{ i18n.T(ctx, "panel.direct_record_open") }</button>
							</form>
						} else {
							<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/panel-domain/direct-port/open") }>
								<button type="submit" class="pill">{ i18n.T(ctx, "panel.direct_open") }</button>
							</form>
						}
					} else {
						if !v.DirectDrift && v.DirectURL != "" {
							<p class="hint">{ i18n.Tf(ctx, "panel.direct_open_desc", v.DirectURL) }</p>
						} else if !v.DirectDrift {
							<p class="hint">{ i18n.Tf(ctx, "panel.direct_open_desc_port", v.DirectPort) }</p>
						}
						if v.DirectDrift {
							// The host already closes the port the stored state calls open:
							// reopening rewrites the ruleset from the stored state.
							<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/panel-domain/direct-port/open") }>
								<button type="submit" class="pill">{ i18n.T(ctx, "panel.direct_open") }</button>
							</form>
						}
						if !v.FirewallLocked {
							<p class="hint">{ i18n.T(ctx, "panel.direct_needs_lockdown") }</p>
						} else if !v.OnDomain {
							<p class="hint">{ i18n.T(ctx, "panel.direct_needs_domain") }</p>
						} else {
							<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/panel-domain/direct-port/close") } data-confirm={ i18n.T(ctx, "panel.confirm.close") } data-more={ i18n.T(ctx, "panel.close_more") } data-ok={ i18n.T(ctx, "panel.direct_close") } onsubmit="return krillConfirm(this)">
								<button type="submit" class="pill pill--danger">{ i18n.T(ctx, "panel.direct_close") }</button>
							</form>
						}
					}
				</section>
			}
			if v.State == "active" {
				<form class="sec" method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/panel-domain/hsts") } aria-labelledby="hs-h">
					<h3 id="hs-h">{ i18n.T(ctx, "panel.hsts") }</h3>
					<div class="seg seg--tight" role="group" aria-label={ i18n.T(ctx, "panel.hsts_max_age") }>
						for _, p := range v.HSTSPresets {
							<button type="submit" name="max_age" value={ itoa(int64(p)) } aria-pressed={ boolStr(p == v.HSTSMaxAge) }>{ i18n.T(ctx, hstsPresetKey(p)) }</button>
						}
					</div>
					<p class="hint">{ i18n.T(ctx, "panel.hsts_desc") }</p>
				</form>
			}
			if v.State != "off" {
				<form class="sec" method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/panel-domain/allowed-ips") } aria-labelledby="al-h">
					<h3 id="al-h">{ i18n.T(ctx, "panel.allowlist") }</h3>
					<div class="field">
						<label for="pips">{ i18n.T(ctx, "panel.addresses") }</label>
						<textarea class="input input--mono textarea" id="pips" name="allowed_ips" rows="3" placeholder={ i18n.T(ctx, "panel.everyone") } spellcheck="false" aria-describedby="pips-hint">{ v.AllowedIPs }</textarea>
						<p class="field-hint" id="pips-hint">{ i18n.Tf(ctx, "panel.allowlist_desc", v.ClientIP) }</p>
					</div>
					<div><button type="submit" class="pill">{ i18n.T(ctx, "common.save") }</button></div>
				</form>
			}
		}
	}
}

// hstsPresetKey is the i18n key labelling an HSTS max-age preset.
func hstsPresetKey(seconds int32) string {
	return "panel.hsts_preset." + itoa(int64(seconds))
}

package templates

import (
	"strings"
	"time"

	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// ObservabilityView is the Observability settings page.
type ObservabilityView struct {
	Wired              bool
	Enabled            bool
	MemoryLimit        string // human text, e.g. "256 MiB"
	MetricsURL         string
	MetricsUser        string
	MetricsHasPassword bool
	LogsURL            string
	LogsUser           string
	LogsHasPassword    bool
	Busy               bool
	LastRun            time.Time
	LastErr            string
	Found              bool
	Running            int
	Desired            int
	Failed             int
	StateErr           string
	// CoverageExpected/CoverageDeployed/CoverageMissing describe the last
	// pass's node coverage (see observability.Coverage): CoverageExpected is
	// 0 whenever there is nothing to report (agent off, or every ready node
	// covered).
	CoverageExpected int
	CoverageDeployed int
	CoverageMissing  []string

	AppsWanted  bool
	AppsRunning int
	AppsDesired int
	AppsErr     string
}

func observabilityPath(orgID int64) string {
	return "/orgs/" + itoa(orgID) + "/observability"
}

templ Observability(org db.Organization, role string, v ObservabilityView) {
	@SettingsPage(org, role, "observability", i18n.T(ctx, "obs.title")) {
		<p class="hint">{ i18n.T(ctx, "obs.desc") }</p>
		if !v.Wired {
			<div class="callout callout--warn"><p>{ i18n.T(ctx, "obs.unwired") }</p></div>
		} else {
			@observabilityState(org.ID, v)
			<form class="sec" method="post" action={ templ.SafeURL(observabilityPath(org.ID)) } autocomplete="off" aria-labelledby="obs-t-h">
				<h3 id="obs-t-h">{ i18n.T(ctx, "obs.targets") }</h3>
				@observabilityTarget("metrics", i18n.T(ctx, "obs.metrics"), i18n.T(ctx, "obs.url_hint_metrics"), v.MetricsURL, v.MetricsUser, v.MetricsHasPassword)
				@observabilityTarget("logs", i18n.T(ctx, "obs.logs"), i18n.T(ctx, "obs.url_hint_logs"), v.LogsURL, v.LogsUser, v.LogsHasPassword)
				<div class="sec-add">
					<button type="submit" class="btn btn--primary">{ i18n.T(ctx, "obs.save") }</button>
					<button type="submit" class="pill" form="obs-check">{ i18n.T(ctx, "obs.check") }</button>
				</div>
				<p class="hint">{ i18n.T(ctx, "obs.check_hint") }</p>
			</form>
			<form id="obs-check" method="post" action={ templ.SafeURL(observabilityPath(org.ID) + "/check") }></form>
		}
	}
}

templ observabilityTarget(name, title, hint, url, user string, hasPassword bool) {
	<div class="obs-target stack">
		<h4 class="list-head">{ title }</h4>
		<div class="field">
			<label for={ name + "_url" }>{ i18n.T(ctx, "obs.url") }</label>
			<input class="input input--mono" id={ name + "_url" } name={ name + "_url" } type="url" value={ url } spellcheck="false" aria-describedby={ name + "_url_hint" }/>
			<p class="field-hint" id={ name + "_url_hint" }>{ hint }</p>
		</div>
		<div class="row row--even">
			<div class="field">
				<label for={ name + "_user" }>{ i18n.T(ctx, "obs.user") }</label>
				<input class="input input--mono" id={ name + "_user" } name={ name + "_user" } value={ user } spellcheck="false"/>
			</div>
			<div class="field">
				<label for={ name + "_password" }>{ i18n.T(ctx, "obs.password") }</label>
				if hasPassword {
					<input class="input input--mono" id={ name + "_password" } name={ name + "_password" } type="password" autocomplete="new-password" placeholder={ i18n.T(ctx, "obs.password_keep") } aria-describedby={ name + "_password_hint" }/>
					<p class="field-hint" id={ name + "_password_hint" }>{ i18n.T(ctx, "obs.password_keep_hint") }</p>
				} else {
					<input class="input input--mono" id={ name + "_password" } name={ name + "_password" } type="password" autocomplete="new-password"/>
				}
			</div>
		</div>
		<p class="field-hint">{ i18n.T(ctx, "obs.password_clear_hint") }</p>
		<label class="check" for={ name + "_clear" }>
			<input type="checkbox" id={ name + "_clear" } name={ name + "_clear" }/>
			{ i18n.T(ctx, "obs.clear_confirm") }
		</label>
	</div>
}

templ observabilityState(orgID int64, v ObservabilityView) {
	<section class="sec" aria-labelledby="obs-h">
		<div class="sec-head">
			<h3 id="obs-h">{ i18n.T(ctx, "obs.agent") }</h3>
			if v.Enabled {
				<form method="post" hx-boost="false" action={ templ.SafeURL(observabilityPath(orgID) + "/disable") } data-confirm={ i18n.T(ctx, "obs.confirm.disable") } data-ok={ i18n.T(ctx, "obs.disable") } onsubmit="return krillConfirm(this)">
					@SwitchButton(true, i18n.T(ctx, "obs.state.on"), i18n.T(ctx, "obs.state.off"))
				</form>
			} else {
				<form method="post" hx-boost="false" action={ templ.SafeURL(observabilityPath(orgID) + "/enable") } data-confirm={ i18n.T(ctx, "obs.confirm.enable") } data-ok={ i18n.T(ctx, "obs.enable") } data-kind="primary" onsubmit="return krillConfirm(this)">
					@SwitchButton(false, i18n.T(ctx, "obs.state.on"), i18n.T(ctx, "obs.state.off"))
				</form>
			}
		</div>
		<ul class="links">
			if v.StateErr != "" {
				<li class="row-item"><span class="link-var">{ i18n.T(ctx, "obs.agent") }</span><span class="link-src"></span>@ui.State("err", i18n.Tf(ctx, "obs.status.state_err", v.StateErr))</li>
			} else if v.Found {
				<li class="row-item">
					<span class="link-var">{ i18n.T(ctx, "obs.agent") }</span>
					<span class="link-src">{ i18n.Tf(ctx, "obs.status.agents", v.Running, v.Desired) }</span>
					if v.Busy {
						@ui.State("warn", i18n.T(ctx, "obs.status.busy"))
					} else if v.Failed > 0 {
						@ui.State("err", i18n.Tf(ctx, "obs.status.failed", v.Failed))
					} else {
						@ui.State("ok", i18n.T(ctx, "obs.sending"))
					}
				</li>
			} else if v.Enabled {
				<li class="row-item"><span class="link-var">{ i18n.T(ctx, "obs.agent") }</span><span class="link-src">{ i18n.T(ctx, "obs.status.none") }</span>@ui.State("idle", i18n.T(ctx, "obs.state.off"))</li>
			}
			if v.AppsWanted {
				<li class="row-item">
					<span class="link-var">{ i18n.T(ctx, "obs.apps_collector") }</span>
					<span class="link-src">{ i18n.Tf(ctx, "obs.apps.running", v.AppsRunning, v.AppsDesired) }</span>
					if v.AppsErr != "" {
						@ui.State("err", v.AppsErr)
					} else {
						<span></span>
					}
				</li>
			}
		</ul>
		if v.Found && v.Failed > 0 && v.Busy {
			<div class="callout callout--err"><p>{ i18n.Tf(ctx, "obs.status.failed", v.Failed) }</p></div>
		}
		if v.LastErr != "" {
			<div class="callout callout--err"><p>{ i18n.Tf(ctx, "obs.status.last_err", v.LastErr) }</p></div>
		}
		if len(v.CoverageMissing) > 0 {
			<div class="callout callout--warn">
				<div class="callout-body">
					<p>{ i18n.Tn(ctx, "obs.coverage.partial", v.CoverageExpected, v.CoverageDeployed, strings.Join(v.CoverageMissing, ", ")) }</p>
					<p class="hint">{ i18n.T(ctx, "obs.coverage.hint") }</p>
				</div>
			</div>
		}
		<p class="hint">{ i18n.Tf(ctx, "obs.cost", v.MemoryLimit) }</p>
		<p class="hint">{ i18n.T(ctx, "obs.manual_alloy") }</p>
		<p class="hint">{ i18n.T(ctx, "obs.labels_note") }</p>
	</section>
}

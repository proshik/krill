package templates

import db "github.com/proshik/krill/internal/database/gen"

templ Project(org db.Organization, role string, project db.Project, envs []db.Environment, active db.Environment, apps []db.Application) {
	@Layout(project.Name, org, role) {
		<p class="k-crumbs mb-3">
			<a href={ templ.SafeURL("/orgs/" + itoa(org.ID)) }>{ org.Name }</a> / { project.Name }
		</p>
		<div class="k-card flex items-center gap-1 mb-4 py-2 px-4">
			for _, e := range envs {
				<a
					class={ "k-tab", templ.KV("k-tab-active", e.ID == active.ID) }
					href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/environments/" + itoa(e.ID)) }
				>{ e.Name }</a>
			}
			if role == "owner" || role == "admin" {
				<details class="inline ml-2">
					<summary class="cursor-pointer k-mono text-xs">+ env</summary>
					<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/environments") } class="mt-2">
						<input class="k-input" name="name" required placeholder="staging"/>
						<button type="submit" class="k-btn k-btn-secondary mt-2">OK</button>
					</form>
				</details>
			}
		</div>
		if active.ID != 0 {
			<div class="flex justify-between items-center mb-3">
				<h3 class="text-xl">{ active.Name }</h3>
				if role == "owner" || role == "admin" {
					<details>
						<summary class="cursor-pointer"><span class="k-btn k-btn-primary">+ Приложение</span></summary>
						@appCreateForm(org.ID, project.ID, active.ID)
					</details>
				}
			</div>
			if len(apps) == 0 {
				<div class="k-card"><p class="k-mono">Нет приложений в этом окружении.</p></div>
			} else {
				<div class="grid grid-cols-2 gap-3">
					for _, a := range apps {
						<a class="k-card hover:border-[color:var(--color-border-strong)]" href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/environments/" + itoa(active.ID) + "/apps/" + itoa(a.ID)) }>
							<div class="font-semibold text-base mb-1">{ a.Name }</div>
							<div class="k-mono text-xs mb-3">{ a.Image }:{ a.Tag }</div>
							@StatusBadge(a.Status)
						</a>
					}
				</div>
			}
		} else {
			<div class="k-card"><p class="k-mono">Создайте окружение, чтобы добавлять приложения.</p></div>
		}
	}
}

templ appCreateForm(orgID, projID, envID int64) {
	<form method="post" action={ templ.SafeURL("/orgs/" + itoa(orgID) + "/projects/" + itoa(projID) + "/environments/" + itoa(envID) + "/apps") } class="k-card mt-2">
		<label class="k-label">Имя (slug)</label>
		<input class="k-input" name="name" required pattern="[a-z0-9-]+" placeholder="web"/>
		<label class="k-label">Источник</label>
		<select class="k-select" name="source_type" onchange="krillToggleSource(this.value)">
			<option value="image">Готовый образ</option>
			<option value="dockerfile">Сборка из Dockerfile</option>
		</select>
		<div data-src="image">
			<label class="k-label">Образ</label>
			<input class="k-input" name="image" placeholder="nginx"/>
			<label class="k-label">Тег</label>
			<input class="k-input" name="tag" value="latest"/>
		</div>
		<div data-src="dockerfile" style="display:none;">
			<label class="k-label">Git URL (публичный)</label>
			<input class="k-input" name="git_url" placeholder="https://github.com/user/repo.git"/>
			<label class="k-label">Ветка</label>
			<input class="k-input" name="git_branch" value="main"/>
			<label class="k-label">Путь к Dockerfile</label>
			<input class="k-input" name="dockerfile_path" value="Dockerfile"/>
		</div>
		<label class="k-label">Домен (пусто = авто)</label>
		<input class="k-input" name="domain" placeholder="(авто)"/>
		<label class="k-label">Порт</label>
		<input class="k-input" name="port" type="number" value="80" required/>
		<label class="k-label">ENV (KEY=VALUE)</label>
		<textarea class="k-textarea" name="env" rows="3"></textarea>
		<div class="mt-2"><button type="submit" class="k-btn k-btn-primary">Создать</button></div>
		<script src="/static/app.js"></script>
		<script>krillToggleSource('image');</script>
	</form>
}

package templates

import (
	"strings"

	"github.com/proshik/krill/internal/topology"
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
)

// EnvResources are the environment's resources beyond apps and logical
// databases: its buckets, and the organization's S3 servers a new one can go on.
type EnvResources struct {
	Buckets []db.ListS3BucketsByEnvironmentRow
	S3Insts []db.DbInstance
	View    topology.EnvView // apps grouped into systems with the resources they use
}

templ Project(org db.Organization, role string, project db.Project, envs []db.Environment, active db.Environment, apps []db.Application, dbs []db.ListLogicalDatabasesByEnvironmentRow, pgInsts []db.DbInstance, registries []db.Registry, res EnvResources, clone ...EnvironmentCloneView) {
	@Layout(project.Name, org, role) {
		<p class="k-crumbs mb-3">
			<a href={ templ.SafeURL("/orgs/" + itoa(org.ID)) }>{ org.Name }</a> / { project.Name }
		</p>
		if role == "owner" || role == "admin" {
			<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/rename") } class="flex items-end gap-2 mb-3">
				<input class="k-input" name="name" value={ project.Name } required/>
				<button type="submit" class="k-btn">{ i18n.T(ctx, "project.rename_btn") }</button>
			</form>
		}
		<div class="k-frame">
			<div class="k-panel">
				<div class="k-panel-head">
					<div class="flex items-center gap-1 flex-wrap">
						for _, e := range envs {
							<a
								class={ "k-tab", templ.KV("k-tab-active", e.ID == active.ID) }
								href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/environments/" + itoa(e.ID)) }
							>{ e.Name }</a>
						}
						if role == "owner" || role == "admin" {
							<button type="button" class="k-tab-add" onclick="krillOpenModal('new-env')">+ { i18n.T(ctx, "project.add_env") }</button>
						}
					</div>
					if role == "owner" || role == "admin" {
						<div class="flex items-center gap-2 flex-wrap">
							if active.ID != 0 {
								if cloneInfo(clone).RequestKey != "" {
									<button type="button" class="k-btn k-btn-secondary" onclick="krillOpenModal('clone-env')">{ i18n.T(ctx, "clone.button") }</button>
								}
								<button type="button" class="k-btn k-btn-primary" onclick="krillOpenModal('new-app')">+ { i18n.T(ctx, "project.new_app") }</button>
								<form method="post" hx-boost="false" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/environments/" + itoa(active.ID) + "/delete") } data-confirm={ i18n.Tf(ctx, "confirm.delete_env", active.Name) } onsubmit="return krillConfirm(this, this.dataset.confirm)">
									<button type="submit" class="k-btn k-btn-danger">{ i18n.T(ctx, "env.delete") }</button>
								</form>
							}
							<form method="post" hx-boost="false" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/delete") } data-confirm={ i18n.Tf(ctx, "confirm.delete_project", project.Name) } onsubmit="return krillConfirm(this, this.dataset.confirm)">
								<button type="submit" class="k-btn k-btn-danger">{ i18n.T(ctx, "projects.delete") }</button>
							</form>
						</div>
					}
				</div>
				<div class="k-panel-body">
					if cloneInfo(clone).Cloned {
						<div class="k-card mb-4" data-clone-notice><p>{ i18n.T(ctx, "clone.review") }</p><p class="mt-2">{ i18n.T(ctx, "clone.servers") } <a class="underline" href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/db-servers") }>{ i18n.T(ctx,"dbi.title") }</a></p></div>
					}
					if cloneInfo(clone).Pending {
						<p class="k-card mb-4">{ i18n.T(ctx,"clone.pending") }</p>
					}
					if active.ID != 0 {
						<div class="flex justify-end items-center gap-3 mb-3">
							<button id="status-refresh" type="button" class="k-copy" hx-get={ "/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/environments/" + itoa(active.ID) + "/statuses" } hx-swap="none">↻ { i18n.T(ctx, "status.refresh") }</button>
							<label class="k-mono text-xs flex items-center gap-1" style="color:var(--color-muted)"><input class="k-check" type="checkbox" data-target="status-refresh" onchange="krillAutoRefresh(this)"/> { i18n.T(ctx, "status.autorefresh") }</label>
							if role == "owner" || role == "admin" {
								<button type="button" class="k-btn k-btn-secondary" onclick="krillOpenModal('new-system')">+ { i18n.T(ctx, "system.new") }</button>
							}
						</div>
						if len(apps) == 0 {
							<div class="k-card flex items-center justify-between gap-3 flex-wrap">
								<p class="k-mono">{ i18n.T(ctx, "project.no_apps") }</p>
								if role == "owner" || role == "admin" {
									<button type="button" class="k-btn k-btn-secondary" onclick="krillOpenModal('new-app')">{ i18n.T(ctx, "project.create_app") }</button>
								}
							</div>
						} else if len(res.View.Systems) > 0 {
							@envSystems(org, project, active, role, res.View)
						} else {
							<div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-5">
								for _, a := range apps {
									<a class="k-card hover:border-[color:var(--color-border-strong)] flex flex-col gap-2" href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/environments/" + itoa(active.ID) + "/apps/" + itoa(a.ID)) }>
										<div class="flex items-center justify-between">
											<div class="font-semibold text-base">{ a.Name }</div>
											@CardStatus("cs-app-"+itoa(a.ID), a.Status, false)
										</div>
										<div class="k-mono text-xs">{ a.Image }:{ a.Tag }</div>
									</a>
								}
							</div>
						}
						<h3 class="text-xl mt-8 mb-3">{ i18n.T(ctx, "db.section") }</h3>
						if active.ID != 0 && (role == "owner" || role == "admin") {
							<div class="mb-3"><button type="button" class="k-btn k-btn-primary" onclick="krillOpenModal('new-db')">+ { i18n.T(ctx, "db.new") }</button></div>
						}
						if len(dbs) == 0 {
							<div class="k-card"><p class="k-mono">{ i18n.T(ctx, "db.empty") }</p></div>
						} else {
							<div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-5">
								for _, d := range dbs {
									<a class="k-card hover:border-[color:var(--color-border-strong)] flex flex-col gap-2" href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/environments/" + itoa(active.ID) + "/databases/" + itoa(d.ID)) }>
										<div class="flex items-center justify-between">
											<div class="font-semibold text-base"><span aria-hidden="true">🐘</span> { d.Name }</div>@CardStatus("cs-ldb-"+itoa(d.ID), d.InstanceStatus, false)
										</div>
										<div class="k-mono text-xs">{ d.DbName + " @ " + d.InstanceName }</div>
									</a>
								}
							</div>
						}
						@envBuckets(org, project, active, role, res)
					} else {
						<div class="flex flex-col items-center justify-center min-h-[36vh] gap-3">
							<p class="k-mono">{ i18n.T(ctx, "project.create_env_hint") }</p>
							if role == "owner" || role == "admin" {
								<button type="button" class="k-btn k-btn-secondary" onclick="krillOpenModal('new-env')">{ i18n.T(ctx, "project.create_env") }</button>
							}
						</div>
					}
				</div>
			</div>
		</div>
		if role == "owner" || role == "admin" {
			if cloneInfo(clone).RequestKey != "" && active.ID != 0 {
				<dialog id="clone-env" class="k-modal">
					<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/environments/" + itoa(active.ID) + "/clone") }>
						<input type="hidden" name="request_key" value={ cloneInfo(clone).RequestKey }/>
						<div class="k-modal-head">
							<button type="button" class="k-modal-x" aria-label={ i18n.T(ctx, "common.close") } onclick="krillCloseModal('clone-env')">✕</button>
							<div class="k-modal-title">{ i18n.T(ctx,"clone.button") }</div>
							<div class="k-modal-desc">{ i18n.Tf(ctx,"clone.source",active.Name) }</div>
						</div>
						<div class="k-modal-body">
							<label class="k-label k-label-required" for="clone-name">{ i18n.T(ctx,"common.name") }</label>
							<input id="clone-name" class="k-input" name="name" required value={ cloneDefaultName(active) }/>
							<p class="text-sm mt-3">{ i18n.T(ctx,"clone.review") }</p>
							<p class="text-sm mt-2">{ i18n.T(ctx,"clone.servers") }</p>
						</div>
						<div class="k-modal-foot">
							<button type="button" class="k-btn k-btn-secondary" onclick="krillCloseModal('clone-env')">{ i18n.T(ctx,"common.cancel") }</button>
							<button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx,"common.create") }</button>
						</div>
					</form>
				</dialog>
			}
			<dialog id="new-env" class="k-modal">
				<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/environments") }>
					<div class="k-modal-head">
						<button type="button" class="k-modal-x" aria-label={ i18n.T(ctx, "common.close") } onclick="krillCloseModal('new-env')">✕</button>
						<div class="k-modal-title">{ i18n.T(ctx, "env.new_modal_title") }</div>
						<div class="k-modal-desc">{ i18n.T(ctx, "env.new_modal_desc") }</div>
					</div>
					<div class="k-modal-body">
						<div>
							<label class="k-label k-label-required">{ i18n.T(ctx, "common.name") }</label>
							<input class="k-input" name="name" required placeholder="staging"/>
						</div>
					</div>
					<div class="k-modal-foot">
						<button type="button" class="k-btn k-btn-secondary" onclick="krillCloseModal('new-env')">{ i18n.T(ctx, "common.cancel") }</button>
						<button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "common.create") }</button>
					</div>
				</form>
			</dialog>
			if active.ID != 0 {
				@systemCreateModal(org, project, active)
				@bucketCreateModal(org, project, active, res)
				@appCreateModal(org.ID, project.ID, active.ID, registries)
				<dialog id="new-db" class="k-modal">
					<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/environments/" + itoa(active.ID) + "/databases") }>
						<div class="k-modal-head"><button type="button" class="k-modal-x" aria-label={ i18n.T(ctx, "common.close") } onclick="krillCloseModal('new-db')">✕</button><div class="k-modal-title">{ i18n.T(ctx, "db.new") }</div></div>
						<div class="k-modal-body">
							<div>
								<label class="k-label k-label-required">{ i18n.T(ctx, "ldb.instance") }</label>
								<select class="k-select" name="instance_id" required>
									for _, in := range pgInsts {
										<option value={ itoa(in.ID) }>{ in.Name } ({ in.Image })</option>
									}
								</select>
								if len(pgInsts) == 0 {
									<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "ldb.no_instances") } <a class="underline" href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/db-servers") }>{ i18n.T(ctx, "dbi.title") }</a></p>
								}
							</div>
							<div><label class="k-label k-label-required">{ i18n.T(ctx, "dbi.name") }</label><input class="k-input" name="name" required/></div>
							<div><label class="k-label">{ i18n.T(ctx, "ldb.db_name") }</label><input class="k-input k-mono" name="db_name" placeholder={ i18n.T(ctx, "ldb.auto") }/></div>
							<div><label class="k-label">{ i18n.T(ctx, "ldb.username") }</label><input class="k-input k-mono" name="username" placeholder={ i18n.T(ctx, "ldb.auto") }/></div>
						</div>
						<div class="k-modal-foot">
							<button type="button" class="k-btn k-btn-secondary" onclick="krillCloseModal('new-db')">{ i18n.T(ctx, "common.cancel") }</button>
							<button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "common.create") }</button>
						</div>
					</form>
				</dialog>
			}
		}
	}
}

templ appCreateModal(orgID, projID, envID int64, registries []db.Registry) {
	<dialog id="new-app" class="k-modal">
		<form method="post" action={ templ.SafeURL("/orgs/" + itoa(orgID) + "/projects/" + itoa(projID) + "/environments/" + itoa(envID) + "/apps") }>
			<div class="k-modal-head">
				<button type="button" class="k-modal-x" aria-label={ i18n.T(ctx, "common.close") } onclick="krillCloseModal('new-app')">✕</button>
				<div class="k-modal-title">{ i18n.T(ctx, "app.new_modal_title") }</div>
				<div class="k-modal-desc">{ i18n.T(ctx, "app.new_modal_desc") }</div>
			</div>
			<div class="k-modal-body">
				<div>
					<label class="k-label k-label-required">{ i18n.T(ctx, "app.name_slug") }</label>
					<input class="k-input" name="name" required pattern="[a-z0-9-]+" placeholder="web"/>
				</div>
				<div>
					<label class="k-label">{ i18n.T(ctx, "app.source") }</label>
					<select class="k-select" name="source_type" onchange="krillToggleSource(this.value)">
						<option value="image">{ i18n.T(ctx, "app.source_image") }</option>
						<option value="dockerfile">{ i18n.T(ctx, "app.source_dockerfile") }</option>
					</select>
				</div>
				<div data-src="image" class="grid gap-3">
					<div>
						<label class="k-label">{ i18n.T(ctx, "app.image") }</label>
						<input class="k-input" name="image" placeholder="ghcr.io/owner/name (full ref) or nginx"/>
					</div>
					<div>
						<label class="k-label">{ i18n.T(ctx, "app.tag") }</label>
						<input class="k-input" name="tag" value="latest"/>
					</div>
				</div>
				<div data-src="dockerfile" class="grid gap-3" style="display:none;">
					<div>
						<label class="k-label">{ i18n.T(ctx, "app.git_url") }</label>
						<input class="k-input" name="git_url" placeholder="https://github.com/user/repo.git"/>
					</div>
					<div>
						<label class="k-label">{ i18n.T(ctx, "app.git_branch") }</label>
						<input class="k-input" name="git_branch" value="main"/>
					</div>
					<div>
						<label class="k-label">{ i18n.T(ctx, "app.dockerfile_path") }</label>
						<input class="k-input" name="dockerfile_path" value="Dockerfile"/>
					</div>
				</div>
				<div>
					<label class="k-label">{ i18n.T(ctx, "app.domain") }</label>
					<input class="k-input" name="domain" placeholder={ i18n.T(ctx, "app.domain_auto") }/>
				</div>
				<div>
					<label class="k-label k-label-required">{ i18n.T(ctx, "app.port") }</label>
					<input class="k-input" name="port" type="number" value="80" required/>
				</div>
				<div>
					<label class="k-label">{ i18n.T(ctx, "app.registry") }</label>
					<select class="k-select" name="registry_id">
						<option value="">{ i18n.T(ctx, "app.registry_public") }</option>
						for _, reg := range registries {
							<option value={ itoa(reg.ID) }>{ reg.Name }</option>
						}
					</select>
				</div>
			</div>
			<div class="k-modal-foot">
				<button type="button" class="k-btn k-btn-secondary" onclick="krillCloseModal('new-app')">{ i18n.T(ctx, "common.cancel") }</button>
				<button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "common.create") }</button>
			</div>
		</form>
		<script>krillToggleSource('image');</script>
	</dialog>
}

type EnvironmentCloneView struct {
	RequestKey      string
	Cloned, Pending bool
}

func cloneInfo(values []EnvironmentCloneView) EnvironmentCloneView {
	if len(values) > 0 {
		return values[0]
	}
	return EnvironmentCloneView{}
}

func cloneDefaultName(source db.Environment) string {
	if source.Slug == "production" {
		return "staging"
	}
	return source.Name + "-copy"
}

templ envBuckets(org db.Organization, project db.Project, active db.Environment, role string, res EnvResources) {
	<h3 class="text-xl mt-8 mb-3">{ i18n.T(ctx, "bucket.section") }</h3>
	if role == "owner" || role == "admin" {
		<div class="mb-3"><button type="button" class="k-btn k-btn-primary" onclick="krillOpenModal('new-bucket')">+ { i18n.T(ctx, "bucket.new") }</button></div>
	}
	if len(res.Buckets) == 0 {
		<div class="k-card"><p class="k-mono">{ i18n.T(ctx, "bucket.empty") }</p></div>
	} else {
		<div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-5">
			for _, b := range res.Buckets {
				<a class="k-card hover:border-[color:var(--color-border-strong)] flex flex-col gap-2" href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/environments/" + itoa(active.ID) + "/buckets/" + itoa(b.ID)) }>
					<div class="flex items-center justify-between">
						<div class="font-semibold text-base"><span aria-hidden="true">🪣</span> { b.Name }</div>
						@StatusBadge(b.InstanceStatus)
					</div>
					<div class="k-mono text-xs">{ b.Name + " @ " + b.InstanceName }</div>
				</a>
			}
		</div>
	}
}

templ bucketCreateModal(org db.Organization, project db.Project, active db.Environment, res EnvResources) {
	<dialog id="new-bucket" class="k-modal">
		<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(project.ID) + "/environments/" + itoa(active.ID) + "/buckets") }>
			<div class="k-modal-head">
				<button type="button" class="k-modal-x" aria-label={ i18n.T(ctx, "common.close") } onclick="krillCloseModal('new-bucket')">✕</button>
				<div class="k-modal-title">{ i18n.T(ctx, "bucket.new") }</div>
				<div class="k-modal-desc">{ i18n.T(ctx, "bucket.new_desc") }</div>
			</div>
			<div class="k-modal-body">
				<div>
					<label class="k-label k-label-required" for="bucket-instance">{ i18n.T(ctx, "bucket.instance") }</label>
					<select id="bucket-instance" class="k-select" name="instance_id" required>
						for _, in := range res.S3Insts {
							<option value={ itoa(in.ID) }>{ in.Name } ({ in.Image })</option>
						}
					</select>
					if len(res.S3Insts) == 0 {
						<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "bucket.no_instances") } <a class="underline" href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/db-servers") }>{ i18n.T(ctx, "dbi.title") }</a></p>
					}
				</div>
				<div>
					<label class="k-label k-label-required" for="bucket-name">{ i18n.T(ctx, "bucket.name") }</label>
					<input id="bucket-name" class="k-input k-mono" name="name" required pattern="[a-z0-9][a-z0-9\-]{1,61}[a-z0-9]" placeholder="penpot"/>
					<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "bucket.name_hint") }</p>
				</div>
				<fieldset class="flex flex-col gap-1">
					<legend class="k-label">{ i18n.T(ctx, "bucket.mode") }</legend>
					<label class="flex items-center gap-2 text-sm"><input type="radio" name="mode" value="create" checked onchange="document.getElementById('bucket-import').hidden = true"/> { i18n.T(ctx, "bucket.mode_create") }</label>
					<label class="flex items-center gap-2 text-sm"><input type="radio" name="mode" value="import" onchange="document.getElementById('bucket-import').hidden = false"/> { i18n.T(ctx, "bucket.mode_import") }</label>
				</fieldset>
				<div id="bucket-import" class="flex flex-col gap-2" hidden>
					<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "bucket.import_hint") }</p>
					<div>
						<label class="k-label" for="bucket-ak">{ i18n.T(ctx, "bucket.access_key") }</label>
						<input id="bucket-ak" class="k-input k-mono" name="access_key" autocomplete="off"/>
					</div>
					<div>
						<label class="k-label" for="bucket-sk">{ i18n.T(ctx, "bucket.secret_key") }</label>
						<input id="bucket-sk" class="k-input k-mono" name="secret_key" type="password" autocomplete="off"/>
					</div>
				</div>
			</div>
			<div class="k-modal-foot">
				<button type="button" class="k-btn k-btn-secondary" onclick="krillCloseModal('new-bucket')">{ i18n.T(ctx, "common.cancel") }</button>
				<button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "common.create") }</button>
			</div>
		</form>
	</dialog>
}

templ systemCreateModal(org db.Organization, project db.Project, active db.Environment) {
	<dialog id="new-system" class="k-modal">
		<form method="post" action={ templ.SafeURL(envBase(org, project, active) + "/systems") }>
			<div class="k-modal-head">
				<button type="button" class="k-modal-x" aria-label={ i18n.T(ctx, "common.close") } onclick="krillCloseModal('new-system')">✕</button>
				<div class="k-modal-title">{ i18n.T(ctx, "system.new") }</div>
				<div class="k-modal-desc">{ i18n.T(ctx, "system.new_desc") }</div>
			</div>
			<div class="k-modal-body">
				<label class="k-label k-label-required" for="system-name">{ i18n.T(ctx, "common.name") }</label>
				<input id="system-name" class="k-input" name="name" required maxlength="80" placeholder="Penpot"/>
			</div>
			<div class="k-modal-foot">
				<button type="button" class="k-btn k-btn-secondary" onclick="krillCloseModal('new-system')">{ i18n.T(ctx, "common.cancel") }</button>
				<button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "common.create") }</button>
			</div>
		</form>
	</dialog>
}

templ envSystems(org db.Organization, project db.Project, active db.Environment, role string, view topology.EnvView) {
	<div class="flex flex-col gap-4">
		for _, sy := range view.Systems {
			@systemCard(org, project, active, role, view, sy, sy.Name)
		}
		if len(view.Ungrouped.Apps) > 0 {
			@systemCard(org, project, active, role, view, view.Ungrouped, i18n.T(ctx, "system.ungrouped"))
		}
	</div>
}

templ systemCard(org db.Organization, project db.Project, active db.Environment, role string, view topology.EnvView, sy topology.SystemView, name string) {
	<details class="k-card k-sys" open data-sys>
		<summary>
			<span class="k-sys-caret" aria-hidden="true">▸</span>
			<span class="font-semibold text-base">{ name }</span>
			<span class="k-mono text-xs" style="color:var(--color-muted)">{ systemSummary(ctx, sy) }</span>
			if len(sy.Resources) > 0 {
				<span class="k-sys-collapsed k-mono text-xs" style="color:var(--color-faint)">{ collapsedResources(ctx, sy) }</span>
			}
		</summary>
		<div class="flex flex-col gap-4 mt-4">
			if len(sy.Resources) > 0 {
				<ul class="flex flex-wrap gap-2" aria-label={ i18n.T(ctx, "system.resources") }>
					for _, r := range sy.Resources {
						<li>
							@resourceChip(r)
						</li>
					}
				</ul>
			} else {
				<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "system.no_resources") }</p>
			}
			if len(sy.Apps) == 0 {
				<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "system.no_apps") }</p>
			} else {
				<div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4">
					for _, a := range sy.Apps {
						<a class="k-card hover:border-[color:var(--color-border-strong)] flex flex-col gap-2" data-sys-app={ itoa(a.ID) } data-uses={ strings.Join(a.Uses, " ") } href={ templ.SafeURL(envBase(org, project, active) + "/apps/" + itoa(a.ID)) }>
							<div class="flex items-center justify-between">
								<div class="font-semibold text-base">{ a.Name }</div>
								@CardStatus("cs-app-"+itoa(a.ID), a.Status, false)
							</div>
							<div class="k-mono text-xs">{ a.Image }</div>
						</a>
					}
				</div>
			}
			if sy.ID != 0 && (role == "owner" || role == "admin") {
				@systemManage(org, project, active, view, sy)
			}
		</div>
	</details>
}

templ resourceChip(r topology.ResourceView) {
	<a class="k-chip" href={ templ.SafeURL(r.Href) } data-sys-res={ r.Key } data-users={ joinIDs(r.Users) } title={ strings.Join(r.Vars, ", ") } aria-label={ resourceAria(ctx, r) }>
		<span aria-hidden="true">{ resourceIcon(r) }</span>
		<span>{ resourceKind(r) }</span>
		<span>{ resourceLabel(r) }</span>
		if r.Shared {
			<span class="k-chip-tag">⇄ { i18n.T(ctx, "system.shared") }</span>
		}
		if r.Detected {
			<span class="k-chip-tag">{ i18n.T(ctx, "system.detected") }</span>
		}
	</a>
}

templ systemManage(org db.Organization, project db.Project, active db.Environment, view topology.EnvView, sy topology.SystemView) {
	<details class="k-sys-manage">
		<summary class="k-mono text-xs" style="color:var(--color-muted)">{ i18n.T(ctx, "system.manage") }</summary>
		<div class="flex flex-col gap-3 mt-3">
			<form method="post" action={ templ.SafeURL(envBase(org, project, active) + "/systems/" + itoa(sy.ID) + "/rename") } class="flex items-end gap-2 flex-wrap">
				<div>
					<label class="k-label" for={ "sys-name-" + itoa(sy.ID) }>{ i18n.T(ctx, "common.name") }</label>
					<input id={ "sys-name-" + itoa(sy.ID) } class="k-input" name="name" value={ sy.Name } required maxlength="80"/>
				</div>
				<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "project.rename_btn") }</button>
			</form>
			if cands := systemCandidates(view, sy.ID); len(cands) > 0 {
				<form method="post" action={ templ.SafeURL(envBase(org, project, active) + "/systems/" + itoa(sy.ID) + "/apps") } class="flex items-end gap-2 flex-wrap">
					<div>
						<label class="k-label" for={ "sys-add-" + itoa(sy.ID) }>{ i18n.T(ctx, "system.add_app") }</label>
						<select id={ "sys-add-" + itoa(sy.ID) } class="k-select" name="app_id">
							for _, c := range cands {
								<option value={ itoa(c.ID) }>{ c.Name }</option>
							}
						</select>
					</div>
					<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "system.add") }</button>
				</form>
			}
			if len(sy.Apps) > 0 {
				<ul class="flex flex-wrap gap-2" aria-label={ i18n.T(ctx, "system.members") }>
					for _, a := range sy.Apps {
						<li>
							<form method="post" action={ templ.SafeURL(envBase(org, project, active) + "/systems/" + itoa(sy.ID) + "/apps/" + itoa(a.ID) + "/remove") }>
								<button type="submit" class="k-chip" aria-label={ i18n.Tf(ctx, "system.remove_app", a.Name) }>{ a.Name } ✕</button>
							</form>
						</li>
					}
				</ul>
			}
			<form method="post" hx-boost="false" action={ templ.SafeURL(envBase(org, project, active) + "/systems/" + itoa(sy.ID) + "/delete") } data-confirm={ i18n.Tf(ctx, "system.confirm_delete", sy.Name) } onsubmit="return krillConfirm(this, this.dataset.confirm)">
				<button type="submit" class="k-btn k-btn-danger">{ i18n.T(ctx, "system.delete") }</button>
			</form>
		</div>
	</details>
}

package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// EnvStatuses renders the out-of-band state updates for every app and
// logical database card of an environment (the canvas's live refresh).
templ EnvStatuses(apps []db.Application, ldbs []db.ListLogicalDatabasesByEnvironmentRow) {
	for _, a := range apps {
		@appStateOOB(a)
	}
	for _, d := range ldbs {
		@ldbStateOOB(d)
	}
}

templ appStateOOB(a db.Application) {
	{{ kind, text := AppState(ctx, a.Status) }}
	@ui.StateID("cs-app-"+itoa(a.ID), kind, text, true)
}

templ ldbStateOOB(d db.ListLogicalDatabasesByEnvironmentRow) {
	{{ kind, text := ServerState(ctx, d.InstanceStatus) }}
	@ui.StateID("cs-ldb-"+itoa(d.ID), kind, text, true)
}

package templates

import (
	"context"

	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/dbservice/drivers"
	"github.com/proshik/krill/internal/docker"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// ServerCard is one database server on the servers page.
type ServerCard struct {
	Inst      db.DbInstance
	Status    string // live display status
	Holds     []ServerHold
	Node      string
	MemUsed   int64 // bytes, 0 when not shown (instance operators only)
	MemLimit  int64
}

// ServerHold is something a server holds or serves: a database, a bucket or
// an app linked to a whole server.
type ServerHold struct {
	Name  string
	Where string // "project environment"
	Href  string
}

// DBServersView is the servers page, optionally with a server's sheet or
// the new-server sheet over it.
type DBServersView struct {
	Cards []ServerCard
	Nodes []docker.SwarmNode
	New   bool
	Sheet *DBServerCtx
}

// DBServerCtx is one server's sheet.
type DBServerCtx struct {
	Org    db.Organization
	Role   string
	Inst   db.DbInstance
	Status string
	Tab    string
	Card   ServerCard
	Nodes  []docker.SwarmNode
	Conn   []drivers.ConnField // admin-only; the engine driver's connection panel
	Base   string
	Host   string // control-plane host, for the external-access "host:port" line
	Backups []EnvResourceRow // per-database backups of a Postgres server
}

func (c DBServerCtx) admin() bool { return isAdmin(c.Role) }

func serverGlyph(engine string) string {
	switch engine {
	case "postgres":
		return "i-pg"
	case "minio":
		return "i-bucket"
	}
	return "i-kv"
}

templ DBServers(org db.Organization, role string, v DBServersView) {
	@Page(Shell{Title: i18n.Sentence(i18n.T(ctx, "dbi.title")), Org: org, Role: role, Tab: "db-servers", Body: dashBody(v.New || v.Sheet != nil)}) {
		<main class="wrap wrap--wide">
			<div class="page-head">
				<h1>{ i18n.T(ctx, "dbi.title") }</h1>
				if isAdmin(role) {
					<a class="btn btn--primary" href={ templ.SafeURL(orgURL(org.ID) + "/db-servers?new=server") }>
						@ui.Icon("i-plus")
						{ i18n.T(ctx, "dbi.new") }
					</a>
				}
			</div>
			if len(v.Cards) == 0 {
				<div class="empty-card">
					<p class="empty-title">{ i18n.T(ctx, "dbi.empty") }</p>
					<p class="hint">{ i18n.T(ctx, "dbi.desc") }</p>
				</div>
			} else {
				<ul class="servers">
					for _, c := range v.Cards {
						<li>
							<a class="server" href={ templ.SafeURL(orgURL(org.ID) + "/db-servers/" + itoa(c.Inst.ID)) } { ariaCurrent(v.Sheet != nil && v.Sheet.Inst.ID == c.Inst.ID, "true")... }>
								<span class="server-top">
									@ui.Glyph(serverGlyph(c.Inst.Engine))
									<span class="svc-name">{ c.Inst.Name }</span>
									{{ kind, text := ServerState(ctx, c.Status) }}
									@ui.State(kind, text)
								</span>
								<span class="svc-sub">{ engineLabel(c.Inst.Engine) + ", " + c.Inst.Image }</span>
								<span class="holds">
									if len(c.Holds) == 0 {
										<span class="hold hold--none">{ i18n.T(ctx, "dbi.nothing_linked") }</span>
									}
									for _, h := range c.Holds {
										<span class="hold">{ h.Name }<em>{ h.Where }</em></span>
									}
								</span>
								<span class="svc-foot">
									<span class="where">
										@ui.Icon("i-node")
										{ c.Node }
									</span>
									if c.MemLimit > 0 {
										<span class="use">
											@ui.Meter(int(c.MemUsed*100/c.MemLimit), c.MemUsed*100/c.MemLimit >= 85)
											{ humanBytes(c.MemUsed) + " / " + humanBytes(c.MemLimit) }
										</span>
									}
								</span>
							</a>
						</li>
					}
				</ul>
			}
		</main>
		if v.New {
			@newServerSheet(org, v.Nodes)
		}
		if v.Sheet != nil {
			@serverSheet(*v.Sheet)
		}
	}
}

templ newServerSheet(org db.Organization, nodes []docker.SwarmNode) {
	@Sheet(i18n.T(ctx, "dbi.new"), "i-pg", orgURL(org.ID)+"/db-servers") {
		<form class="form" method="post" action={ templ.SafeURL(orgURL(org.ID) + "/db-servers") }>
			<fieldset class="choice choice--three">
				<legend>{ i18n.T(ctx, "dbi.engine") }</legend>
				for i, d := range drivers.Registry.List() {
					<label class="choice-card">
						<input type="radio" name="engine" value={ d.Engine() } checked?={ i == 0 } data-default-image={ d.DefaultImage() }/>
						<span class="choice-name">{ d.Label() }</span>
						<span class="choice-sub">{ i18n.T(ctx, "dbi.engine_sub."+d.Engine()) }</span>
					</label>
				}
			</fieldset>
			<div class="field">
				<label for="sv-name">{ i18n.T(ctx, "common.name") }</label>
				<input class="input input--mono" id="sv-name" name="name" required placeholder="main-db" autocomplete="off" spellcheck="false"/>
			</div>
			<div class="field">
				<label for="sv-version">{ i18n.T(ctx, "dbi.version") }</label>
				<input class="input input--mono" id="sv-version" name="version" placeholder={ firstEngineDefaultImage() } autocomplete="off" spellcheck="false" aria-describedby="sv-version-hint"/>
				<p class="field-hint" id="sv-version-hint">{ i18n.T(ctx, "dbi.version_hint") }</p>
			</div>
			<div class="row row--even">
				<div class="field">
					<label for="sv-node">{ i18n.T(ctx, "dbnode.label") }</label>
					<select class="input" id="sv-node" name="node_hostname">
						<option value="">{ i18n.T(ctx, "dbnode.manager") }</option>
						for _, n := range nodes {
							if !n.Leader {
								<option value={ n.Hostname }>{ n.Hostname }</option>
							}
						}
					</select>
				</div>
				<div class="field">
					<label for="sv-port">{ i18n.T(ctx, "dbi.external_port") }</label>
					<input class="input input--mono" id="sv-port" name="external_port" type="number" min="1" max="65535" placeholder={ i18n.T(ctx, "dbi.closed") }/>
				</div>
			</div>
			<div class="group" data-when="engine=minio" hidden>
				<div class="row row--even">
					<div class="field">
						<label for="sv-root">{ i18n.T(ctx, "dbi.minio_root_user") }</label>
						<input class="input input--mono" id="sv-root" name="root_user" pattern="[a-zA-Z0-9]{3,63}" placeholder="harbor" autocomplete="off" aria-describedby="sv-root-hint"/>
						<p class="field-hint" id="sv-root-hint">{ i18n.T(ctx, "dbi.minio_root_user_hint") }</p>
					</div>
					<div class="field">
						<label for="sv-console">{ i18n.T(ctx, "dbi.console_port") }</label>
						<input class="input input--mono" id="sv-console" name="console_external_port" type="number" min="1" max="65535" placeholder={ i18n.T(ctx, "dbi.closed") }/>
					</div>
				</div>
			</div>
			<div class="form-keys">
				<button type="submit" class="btn btn--primary">{ i18n.T(ctx, "dbi.create") }</button>
				<a class="pill" href={ templ.SafeURL(orgURL(org.ID) + "/db-servers") }>{ i18n.T(ctx, "common.cancel") }</a>
			</div>
		</form>
	}
}

func serverTabs(ctx context.Context, c DBServerCtx) []OrgTab {
	main := i18n.T(ctx, "dbi.tab_linked")
	switch c.Inst.Engine {
	case "postgres":
		main = i18n.T(ctx, "dbi.tab_databases")
	case "minio":
		main = i18n.T(ctx, "dbi.tab_buckets")
	}
	tabs := []OrgTab{{"main", main, c.Base}}
	if c.admin() {
		tabs = append(tabs, OrgTab{"connection", i18n.T(ctx, "db.connection"), c.Base + "?tab=connection"})
	}
	tabs = append(tabs, OrgTab{"backups", i18n.T(ctx, "backup.section"), c.Base + "?tab=backups"})
	if c.admin() {
		tabs = append(tabs, OrgTab{"settings", i18n.T(ctx, "tab.settings"), c.Base + "?tab=settings"})
	}
	tabs = append(tabs, OrgTab{"logs", i18n.T(ctx, "tab.logs"), c.Base + "?tab=logs"})
	return tabs
}

templ serverSheet(c DBServerCtx) {
	<aside class="sheet" aria-label={ c.Inst.Name }>
		<div class="sheet-head">
			<div class="sheet-title">
				@ui.Glyph(serverGlyph(c.Inst.Engine))
				<h2>{ c.Inst.Name }</h2>
				@ServerStateBadge(c.Status, c.Base+"/status")
			</div>
			<a class="pill pill--icon" href={ templ.SafeURL(orgURL(c.Org.ID) + "/db-servers") } aria-label={ i18n.T(ctx, "common.close") } data-sheet-close>
				@ui.Icon("i-close")
			</a>
		</div>
		<p class="sheet-sub">
			<code>{ c.Inst.Image }</code>
			<span class="run-meta">
				@ui.Icon("i-node")
				{ c.Card.Node }
			</span>
		</p>
		<nav class="seg" aria-label={ c.Inst.Name }>
			for _, t := range serverTabs(ctx, c) {
				<a href={ templ.SafeURL(t.Href) } { ariaCurrent(t.Key == c.Tab, "page")... }>{ t.Label }</a>
			}
		</nav>
		switch c.Tab {
			case "connection":
				@serverConnection(c)
			case "backups":
				@serverBackups(c)
			case "settings":
				@serverSettings(c)
			case "logs":
				@logViewer(c.Base + "/logs")
			default:
				@serverMain(c)
		}
	</aside>
}

templ serverMain(c DBServerCtx) {
	<section class="runs" aria-labelledby="srv-runs-h">
		<h3 id="srv-runs-h">{ i18n.T(ctx, "app.runs_on") }</h3>
		<div class="runs-list">
			<div class="run">
				<span class="run-node">{ c.Card.Node }</span>
				<span class="run-meta">
					if c.Card.MemLimit > 0 {
						{ humanBytes(c.Card.MemUsed) + " / " + humanBytes(c.Card.MemLimit) }
					} else {
						{ i18n.T(ctx, "dbi.pinned_with_volume") }
					}
				</span>
				{{ kind, text := ServerState(ctx, c.Status) }}
				@ui.State(kind, text)
			</div>
		</div>
		<p class="hint">{ i18n.T(ctx, "dbi.placement_hint") }</p>
	</section>
	<div class="list-row"><h3 class="list-head">{ i18n.Tf(ctx, "dbi.holds_n", len(c.Card.Holds)) }</h3></div>
	if len(c.Card.Holds) == 0 {
		<p class="empty">{ i18n.T(ctx, "dbi.nothing_uses") }</p>
	} else {
		<ul class="dbs">
			for _, h := range c.Card.Holds {
				<li>
					<a class="db" href={ templ.SafeURL(h.Href) }>
						<span class="db-name">{ h.Name }</span>
						<span class="run-meta">{ h.Where }</span>
						<span></span>
						<span></span>
					</a>
				</li>
			}
		</ul>
	}
	if c.admin() {
		<div class="deploy-keys deploy-keys--end">
			<form method="post" action={ templ.SafeURL(c.Base + "/deploy") }>
				<button type="submit" class="pill" title={ i18n.T(ctx, "dbi.deploy_hint") }>{ i18n.T(ctx, "db.deploy") }</button>
			</form>
			// Start unless it runs, Stop unless it is stopped: a server whose node
			// is down still has a desired replica, and Stop keeps it from
			// starting when the node returns.
			if c.Status != "running" {
				<form method="post" action={ templ.SafeURL(c.Base + "/start") }>
					<button type="submit" class="pill">{ i18n.T(ctx, "db.start") }</button>
				</form>
			}
			if c.Status != "stopped" {
				<form method="post" hx-boost="false" action={ templ.SafeURL(c.Base + "/stop") } data-confirm={ i18n.Tf(ctx, "dbi.stop_q", c.Inst.Name) } data-more={ i18n.T(ctx, "dbi.stop_more") } data-ok={ i18n.T(ctx, "db.stop") } onsubmit="return krillConfirm(this)">
					<button type="submit" class="pill pill--danger">{ i18n.T(ctx, "db.stop") }</button>
				</form>
			}
		</div>
	}
}

templ serverConnection(c DBServerCtx) {
	<section class="sec" aria-labelledby="in-h">
		<h3 id="in-h">{ i18n.T(ctx, "dbi.inside_network") }</h3>
		if len(c.Conn) == 0 {
			<p class="empty">{ i18n.T(ctx, "db.password_unreadable") }</p>
		}
		for i, f := range c.Conn {
			@ui.CopyField("conn-"+itoa(int64(i)), i18n.T(ctx, f.Label), f.Value, f.Secret, i18n.T(ctx, "common.copy"), i18n.T(ctx, "common.reveal"))
		}
		<p class="hint">{ i18n.T(ctx, connHintKey(c.Inst.Engine)) }</p>
	</section>
	<form class="sec" method="post" hx-boost="false" action={ templ.SafeURL(c.Base + "/external-port") } aria-labelledby="ex-h">
		<div class="sec-head">
			<h3 id="ex-h">{ i18n.T(ctx, "dbinst.external.title") }</h3>
			if c.Inst.ExternalPort != nil {
				@ui.State("warn", i18n.T(ctx, "dbi.port_open"))
			} else {
				@ui.State("idle", i18n.T(ctx, "dbi.closed"))
			}
		</div>
		<div class="add-row">
			<div class="field">
				<label for="xport">{ i18n.T(ctx, "dbi.host_port") }</label>
				<input class="input input--mono" id="xport" name="external_port" type="number" min="1" max="65535" value={ i32v(c.Inst.ExternalPort) } placeholder={ i18n.T(ctx, "dbi.closed") }/>
			</div>
			<button type="submit" class="pill">{ i18n.T(ctx, "common.save") }</button>
		</div>
		if c.Inst.ExternalPort != nil {
			<p class="hint"><code>{ c.Host + ":" + itoa(int64(*c.Inst.ExternalPort)) }</code></p>
		}
		if c.Inst.ConsoleExternalPort != nil {
			<p class="hint">{ i18n.T(ctx, "dbi.console_port") + ": " }<code>{ c.Host + ":" + itoa(int64(*c.Inst.ConsoleExternalPort)) }</code></p>
		}
		<p class="hint">{ i18n.T(ctx, "dbinst.external.hint") }</p>
	</form>
}

templ serverBackups(c DBServerCtx) {
	if c.Inst.Engine != "postgres" {
		<p class="empty">{ i18n.Tf(ctx, "dbi.no_backups_engine", engineLabel(c.Inst.Engine)) }</p>
		if c.Inst.Engine == "minio" {
			<p class="hint">{ i18n.T(ctx, "dbi.bucket_backups_hint") }</p>
		}
	} else if len(c.Backups) == 0 {
		<p class="empty">{ i18n.T(ctx, "dbi.no_databases") }</p>
	} else {
		<ul class="reslist">
			for _, b := range c.Backups {
				<li class="res">
					<div class="res-top">
						@ui.Glyph("i-pg")
						<h2><a href={ templ.SafeURL(b.Href) }>{ b.Name }</a></h2>
						<span class="run-meta">{ b.Detail }</span>
						@ui.State(b.BackupKind, b.BackupText)
					</div>
					<div class="deploy-keys">
						if b.BackupNone {
							<a class="pill" href={ templ.SafeURL(b.BackupHref) }>{ i18n.T(ctx, "dbi.setup_backups") }</a>
						} else {
							<a class="pill" href={ templ.SafeURL(b.BackupHref) }>{ i18n.T(ctx, "dbi.open_backups") }</a>
						}
					</div>
				</li>
			}
		</ul>
	}
}

templ serverSettings(c DBServerCtx) {
	<form class="sec" method="post" action={ templ.SafeURL(c.Base + "/version") } aria-labelledby="ver-h">
		<h3 id="ver-h">{ i18n.T(ctx, "dbi.version_title") }</h3>
		<div class="add-row">
			<div class="field">
				<label for="sver">{ i18n.T(ctx, "dbi.image") }</label>
				<input class="input input--mono" id="sver" name="image" value={ c.Inst.Image } autocomplete="off" spellcheck="false"/>
			</div>
			<button type="submit" class="pill">{ i18n.T(ctx, "dbi.change_version") }</button>
		</div>
		<p class="hint">{ i18n.T(ctx, "dbi.version_warning") }</p>
	</form>
	// A move needs somewhere to move to: another node, or away from a removed one.
	if len(c.Nodes) > 1 || (c.Inst.NodeHostname != "" && !hostnameInNodes(c.Nodes, c.Inst.NodeHostname)) {
		<form class="sec" method="post" hx-boost="false" action={ templ.SafeURL(c.Base + "/node") } data-confirm={ i18n.Tf(ctx, "confirm.migrate_dbi", c.Inst.Name) } data-ok={ i18n.T(ctx, "dbnode.migrate") } data-kind="primary" onsubmit="return krillConfirm(this)" aria-labelledby="mv-h">
			<h3 id="mv-h">{ i18n.T(ctx, "dbnode.label") }</h3>
			<div class="add-row">
				<div class="field">
					<label for="snode">{ i18n.T(ctx, "dbi.runs_on") }</label>
					<select class="input" id="snode" name="node_hostname">
						<option value="" selected?={ c.Inst.NodeHostname == "" }>{ i18n.T(ctx, "dbnode.manager") }</option>
						for _, n := range c.Nodes {
							if !n.Leader {
								<option value={ n.Hostname } selected?={ c.Inst.NodeHostname == n.Hostname }>{ n.Hostname }</option>
							}
						}
						if c.Inst.NodeHostname != "" && !hostnameInNodes(c.Nodes, c.Inst.NodeHostname) {
							<option value={ c.Inst.NodeHostname } selected>{ c.Inst.NodeHostname + " (" + i18n.T(ctx, "dbnode.removed") + ")" }</option>
						}
					</select>
				</div>
				<button type="submit" class="pill">{ i18n.T(ctx, "dbnode.migrate") }</button>
			</div>
			<label class="check"><input type="checkbox" name="delete_source"/> { i18n.T(ctx, "dbnode.delete_source") }</label>
			<p class="hint">{ i18n.T(ctx, "dbnode.hint") }</p>
		</form>
	}
	<form class="sec sec--danger" method="post" hx-boost="false" action={ templ.SafeURL(c.Base + "/delete") } data-confirm={ i18n.Tf(ctx, "confirm.delete_dbi", c.Inst.Name) } data-ok={ i18n.T(ctx, "common.delete") } onsubmit="return krillConfirm(this)" aria-labelledby="sdel-h">
		<h3 id="sdel-h">{ i18n.T(ctx, "dbi.delete") }</h3>
		<label class="check"><input type="checkbox" name="delete_databases"/> { i18n.T(ctx, "dbi.delete_databases") }</label>
		<label class="check"><input type="checkbox" name="destroy_data"/> { i18n.T(ctx, "db.delete.destroyData") }</label>
		<div><button type="submit" class="pill pill--danger">{ i18n.Tf(ctx, "common.delete_named", c.Inst.Name) }</button></div>
	</form>
}

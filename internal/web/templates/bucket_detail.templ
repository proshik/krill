package templates

import (
	"github.com/proshik/krill/internal/bucketbackup"
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// BucketView is the bucket page.
type BucketView struct {
	Shell    Shell
	Org      db.Organization
	Role     string
	Project  db.Project
	Env      db.Environment
	Bucket   db.S3Bucket
	Instance db.DbInstance
	Node     string
	Base     string // path to /buckets/{id}

	Endpoint      string // internal S3 endpoint linked apps get
	AccessKey     string
	SecretKey     string // decrypted; "" for members and when undecryptable
	PrevAccessKey string // the principal a rotation replaced, until revoked
	Users         []UsedBy
	Linked        bool

	Backup BackupBlock
}

// BucketBackupView is one backup configuration of a bucket with its snapshots.
type BucketBackupView struct {
	Row                  db.BucketBackup
	Destination          string
	Snapshots            []bucketbackup.Snapshot
	SnapshotsUnavailable bool
}

func (v BucketView) admin() bool { return isAdmin(v.Role) }

templ BucketDetail(v BucketView) {
	@Page(v.Shell) {
		<main class="wrap wrap--narrow">
			<div class="page-head page-head--obj">
				<div class="sheet-title">
					@ui.Glyph("i-bucket")
					<h1>{ v.Bucket.Name }</h1>
					@ServerStateBadge(v.Instance.Status, "/orgs/"+itoa(v.Org.ID)+"/db-servers/"+itoa(v.Instance.ID)+"/status")
					if !v.Bucket.CreatedByKrill {
						<span class="tag">{ i18n.T(ctx, "bucket.imported") }</span>
					}
				</div>
				<p class="run-meta">
					{ i18n.T(ctx, "bucket.on_server") + " " }
					<a href={ templ.SafeURL(orgURL(v.Org.ID) + "/db-servers/" + itoa(v.Instance.ID)) }>{ v.Instance.Name }</a>{ commaPrefix(v.Node) }
				</p>
			</div>
			<section class="sec" aria-labelledby="bc-h">
				<h2 id="bc-h">{ i18n.T(ctx, "db.connection") }</h2>
				<div class="row row--even">
					@ui.CopyField("bep", i18n.T(ctx, "bucket.endpoint"), v.Endpoint, false, i18n.T(ctx, "common.copy"), "")
					@ui.CopyField("bname", i18n.T(ctx, "bucket.name"), v.Bucket.Name, false, i18n.T(ctx, "common.copy"), "")
				</div>
				<div class="row row--even">
					@ui.CopyField("bak", i18n.T(ctx, "bucket.access_key"), v.AccessKey, false, i18n.T(ctx, "common.copy"), "")
					if v.admin() && v.SecretKey != "" {
						@ui.CopyField("bsk", i18n.T(ctx, "bucket.secret_key"), v.SecretKey, true, i18n.T(ctx, "common.copy"), i18n.T(ctx, "common.reveal"))
					}
				</div>
				<p class="hint">{ i18n.T(ctx, "bucket.desc") }</p>
			</section>
			<section class="sec" aria-labelledby="bu-h">
				<h2 id="bu-h">{ i18n.T(ctx, "envdb.used_by") }</h2>
				@usedByList(v.Users, i18n.T(ctx, "bucket.no_links"))
			</section>
			if v.admin() {
				<section class="sec" aria-labelledby="kr-h">
					<h2 id="kr-h">{ i18n.T(ctx, "bucket.rotation") }</h2>
					<ul class="keys">
						<li class="key-row"><code>{ v.AccessKey }</code><span class="tag tag--active">{ i18n.T(ctx, "bucket.key_current") }</span></li>
						if v.PrevAccessKey != "" {
							<li class="key-row">
								<code>{ v.PrevAccessKey }</code>
								<span class="tag">{ i18n.T(ctx, "bucket.key_previous") }</span>
								<span class="run-meta">{ i18n.T(ctx, "bucket.key_still_works") }</span>
								<form method="post" hx-boost="false" action={ templ.SafeURL(v.Base + "/revoke-previous") } data-confirm={ i18n.Tf(ctx, "bucket.confirm_revoke", v.PrevAccessKey) } data-more={ i18n.T(ctx, "bucket.revoke_more") } data-ok={ i18n.T(ctx, "bucket.revoke_short") } onsubmit="return krillConfirm(this)">
									<button type="submit" class="pill pill--small pill--danger">{ i18n.T(ctx, "bucket.revoke_short") }</button>
								</form>
							</li>
						}
					</ul>
					if v.PrevAccessKey == "" {
						<p class="hint">{ i18n.T(ctx, "bucket.rotate_desc") }</p>
						<form method="post" hx-boost="false" action={ templ.SafeURL(v.Base + "/rotate") } data-confirm={ i18n.T(ctx, "bucket.confirm_rotate") } data-ok={ i18n.T(ctx, "bucket.rotate") } data-kind="primary" onsubmit="return krillConfirm(this)">
							<button type="submit" class="pill">{ i18n.T(ctx, "bucket.rotate") }</button>
						</form>
					} else {
						<p class="hint">{ i18n.Tf(ctx, "bucket.rotation_pending", v.PrevAccessKey) }</p>
						<div><button type="button" class="pill" disabled title={ i18n.T(ctx, "bucket.revoke_first") }>{ i18n.T(ctx, "bucket.rotate") }</button></div>
					}
				</section>
				@backupBlock(v.Backup)
				<form class="sec sec--danger" method="post" hx-boost="false" action={ templ.SafeURL(v.Base + "/delete") } data-confirm={ i18n.Tf(ctx, "bucket.confirm_delete", v.Bucket.Name) } data-ok={ i18n.T(ctx, "common.delete") } onsubmit="return krillConfirm(this)" aria-labelledby="bd-h">
					<h2 id="bd-h">{ i18n.T(ctx, "bucket.delete") }</h2>
					<label class="check"><input type="checkbox" name="destroy_data" disabled?={ v.Linked }/> { i18n.T(ctx, "bucket.destroy_data") }</label>
					if v.Linked {
						<p class="hint">{ i18n.T(ctx, "bucket.delete_linked") }</p>
					}
					<div><button type="submit" class="pill pill--danger" disabled?={ v.Linked }>{ i18n.Tf(ctx, "common.delete_named", v.Bucket.Name) }</button></div>
				</form>
			}
		</main>
	}
}

// BucketSnapshots is a bucket backup's stored snapshots, each restorable into
// a new bucket.
templ BucketSnapshots(base string, b BucketBackupView, bucketName string) {
	if b.SnapshotsUnavailable {
		<p class="empty">{ i18n.T(ctx, "bbackup.snapshots_unavailable") }</p>
	} else if len(b.Snapshots) == 0 {
		<p class="empty">{ i18n.T(ctx, "bbackup.no_snapshots") }</p>
	} else {
		<ul class="snaps">
			for _, sn := range b.Snapshots {
				<li class="snap">
					<span class="snap-when">{ sn.Timestamp }</span>
					<span class="run-meta">{ i18n.Tf(ctx, "bbackup.objects_bytes", sn.Objects, humanBytes(sn.Bytes)) }</span>
					if sn.Complete {
						@ui.State("ok", i18n.T(ctx, "backup.complete"))
						<form class="snap-keys snap-restore" method="post" hx-boost="false" action={ templ.SafeURL(base + "/backups/" + itoa(b.Row.ID) + "/restore") } data-confirm={ i18n.Tf(ctx, "backup.restore_q", sn.Timestamp) } data-more={ i18n.T(ctx, "bbackup.confirm_restore") } data-ok={ i18n.T(ctx, "backup.restore") } onsubmit="return krillConfirm(this)">
							<input type="hidden" name="snapshot" value={ sn.Timestamp }/>
							<label class="visually-hidden" for={ "restore-" + itoa(b.Row.ID) + "-" + sn.Timestamp }>{ i18n.T(ctx, "bbackup.target") }</label>
							<input class="input input--mono input--compact" id={ "restore-" + itoa(b.Row.ID) + "-" + sn.Timestamp } name="target" required value={ restoreName(bucketName) } aria-describedby="bbackup-target-hint"/>
							<button type="submit" class="pill pill--small">{ i18n.T(ctx, "bbackup.restore_new") }</button>
						</form>
					} else {
						@ui.State("warn", i18n.T(ctx, "bbackup.incomplete"))
						<span></span>
					}
				</li>
			}
		</ul>
		<p id="bbackup-target-hint" class="hint">{ i18n.T(ctx, "bbackup.target_hint") }</p>
	}
}

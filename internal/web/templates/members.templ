package templates

import db "github.com/proshik/krill/internal/database/gen"

templ Members(org db.Organization, role string, members []db.ListMembersRow, tempPassword string) {
	@Layout("Члены", org, role) {
		<h2 class="text-2xl mb-4">Члены организации</h2>
		if tempPassword != "" {
			<div class="k-toast k-toast-ok mb-3">Пользователь создан. Временный пароль (показывается один раз): <b class="k-mono">{ tempPassword }</b></div>
		}
		<div class="k-card mb-4">
			<table class="k-table">
				<thead><tr><th>Email</th><th>Роль</th><th></th></tr></thead>
				<tbody>
					for _, m := range members {
						<tr>
							<td class="k-mono">{ m.Email }</td>
							<td>{ m.Role }</td>
							<td>
								if (role == "owner" || role == "admin") && m.Role != "owner" {
									<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/members/" + itoa(m.ID) + "/remove") } class="inline">
										<button type="submit" class="k-btn k-btn-danger">Удалить</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if role == "owner" || role == "admin" {
			<div class="k-card">
				<h3 class="text-lg mb-2">Добавить пользователя</h3>
				<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/members") }>
					<label class="k-label">Email</label>
					<input class="k-input" name="email" type="email" required/>
					<label class="k-label">Роль</label>
					<select class="k-select" name="role">
						<option value="member">member</option>
						<option value="admin">admin</option>
					</select>
					<div class="mt-2"><button type="submit" class="k-btn k-btn-primary">Создать</button></div>
				</form>
			</div>
		}
	}
}

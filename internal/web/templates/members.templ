package templates

import db "github.com/proshik/krill/internal/database/gen"

templ Members(org db.Organization, role string, members []db.ListMembersRow, tempPassword string) {
	@Layout("Члены", org, role) {
		<h2>Члены организации</h2>
		if tempPassword != "" {
			<div class="card" style="border-color:var(--ok);">
				Пользователь создан. Временный пароль (показывается один раз): <b>{ tempPassword }</b>
			</div>
		}
		<div class="card">
			<table>
				<thead><tr><th>Email</th><th>Роль</th><th></th></tr></thead>
				<tbody>
					for _, m := range members {
						<tr>
							<td>{ m.Email }</td>
							<td>{ m.Role }</td>
							<td>
								if (role == "owner" || role == "admin") && m.Role != "owner" {
									<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/members/" + itoa(m.ID) + "/remove") } style="display:inline;">
										<button type="submit" class="secondary">Удалить</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if role == "owner" || role == "admin" {
			<div class="card">
				<h3>Добавить пользователя</h3>
				<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/members") }>
					<label>Email</label>
					<input name="email" type="email" required/>
					<label>Роль</label>
					<select name="role">
						<option value="member">member</option>
						<option value="admin">admin</option>
					</select>
					<button type="submit" style="margin-top:8px;">Создать</button>
				</form>
			</div>
		}
	}
}

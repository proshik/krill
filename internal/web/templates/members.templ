package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
)

templ Members(org db.Organization, role string, members []db.ListMembersRow, tempPassword string) {
	@Layout(i18n.T(ctx, "members.page_title"), org, role) {
		<h2 class="text-2xl mb-4">{ i18n.T(ctx, "members.title") }</h2>
		if tempPassword != "" {
			<div class="k-toast k-toast-ok mb-3">{ i18n.T(ctx, "members.temp_password") } <b class="k-mono">{ tempPassword }</b></div>
		}
		<div class="k-card mb-4">
			<table class="k-table">
				<thead><tr><th>Email</th><th>{ i18n.T(ctx, "common.role") }</th><th></th></tr></thead>
				<tbody>
					for _, m := range members {
						<tr>
							<td class="k-mono">{ m.Email }</td>
							<td>{ m.Role }</td>
							<td>
								if (role == "owner" || role == "admin") && m.Role != "owner" {
									<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/members/" + itoa(m.ID) + "/remove") } class="inline">
										<button type="submit" class="k-btn k-btn-danger">{ i18n.T(ctx, "common.delete") }</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if role == "owner" || role == "admin" {
			<div class="k-card">
				<h3 class="text-lg mb-2">{ i18n.T(ctx, "members.add_title") }</h3>
				<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/members") }>
					<label class="k-label">Email</label>
					<input class="k-input" name="email" type="email" required/>
					<label class="k-label">{ i18n.T(ctx, "common.role") }</label>
					<select class="k-select" name="role">
						<option value="member">member</option>
						<option value="admin">admin</option>
					</select>
					<div class="mt-2"><button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "common.create") }</button></div>
				</form>
			</div>
		}
	}
}

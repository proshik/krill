package templates

import (
	"github.com/proshik/krill/internal/auth"
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/flash"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/nav"
)

templ Layout(title string, org db.Organization, role string) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<title>{ title } — Krill</title>
			<link rel="stylesheet" href="/static/xterm.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script defer src="/static/app.js"></script>
		</head>
		<body class="flex" hx-boost="true">
			<aside class="k-side">
				<div class="k-side-brand"><span aria-hidden="true">🦐</span> Krill</div>
				<div class="k-org-badge">
					<button type="button" class="k-org-switch" hx-get={ "/orgs/switcher?current=" + itoa(org.ID) } hx-target="#org-switcher" hx-swap="innerHTML" onclick="krillOpenModal('org-switcher')" title={ i18n.T(ctx, "orgs.switch_title") }>
						<span>{ org.Name }</span>
						<span class="chev">▾</span>
					</button>
					<span class="role">{ role }</span>
				</div>
				<nav>
					<a class={ "k-nav", templ.KV("k-nav-active", nav.IsActive(ctx, "projects")) } href={ templ.SafeURL("/orgs/" + itoa(org.ID)) }>{ i18n.T(ctx, "nav.projects") }</a>
					<a class={ "k-nav", templ.KV("k-nav-active", nav.IsActive(ctx, "db-servers")) } href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/db-servers") }>{ i18n.T(ctx, "nav.dbservers") }</a>
					if role == "owner" || role == "admin" {
						<a class={ "k-nav", templ.KV("k-nav-active", nav.IsActive(ctx, "members")) } href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/members") }>{ i18n.T(ctx, "nav.members") }</a>
						<a class={ "k-nav", templ.KV("k-nav-active", nav.IsActive(ctx, "topology")) } href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/topology") }>{ i18n.T(ctx, "nav.topology") }</a>
					}
					if auth.IsInstanceAdmin(ctx) {
						<a class={ "k-nav", templ.KV("k-nav-active", nav.IsActive(ctx, "monitoring")) } href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/monitoring") }>{ i18n.T(ctx, "nav.monitoring") }</a>
					}
				</nav>
				<div class="k-side-foot">
					if role == "owner" || role == "admin" {
						<a class={ "k-nav", templ.KV("k-nav-active", nav.IsSettings(ctx)) } href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/registries") }>{ i18n.T(ctx, "nav.settings") }</a>
					}
					<form method="post" action="/logout" hx-boost="false">
						<button type="submit" class="k-nav k-nav-logout k-nav-logout-btn"><span class="k-nav-logout-ico">⎋</span> { i18n.T(ctx, "nav.logout") }</button>
					</form>
				</div>
			</aside>
			<main class="flex-1 min-w-0">
				<div class="k-content">
					if f := flash.From(ctx); f != nil {
						<div class="k-toast-host">
							<div class={ "k-toast", "k-toast-" + f.Kind, "k-toast-pop" } onclick="krillDismissToast(this)" role="status">{ f.Msg }</div>
						</div>
					}
					{ children... }
				</div>
			</main>
			<dialog id="org-switcher" class="k-modal"></dialog>
			<dialog id="k-confirm" class="k-modal">
				<div class="k-modal-head">
					<div class="k-modal-title">{ i18n.T(ctx, "confirm.title") }</div>
					<div class="k-modal-desc" id="k-confirm-msg"></div>
				</div>
				<div class="k-modal-foot">
					<button type="button" class="k-btn k-btn-secondary" onclick="window.__krillConfirmAction=null;krillCloseModal('k-confirm')">{ i18n.T(ctx, "common.cancel") }</button>
					<button type="button" id="k-confirm-ok" class="k-btn k-btn-danger" onclick="krillConfirmRun()">{ i18n.T(ctx, "common.delete") }</button>
				</div>
			</dialog>
		</body>
	</html>
}

// settingsNav is the Settings sub-navigation shared by the Destinations and
// Registries pages (they live under a single sidebar "Settings" entry).
templ settingsNav(orgID int64) {
	<h2 class="text-2xl mb-3">{ i18n.T(ctx, "nav.settings") }</h2>
	<div class="k-card flex items-center mb-4 py-2 px-4">
		<a href={ templ.SafeURL("/orgs/" + itoa(orgID) + "/registries") } class={ "k-tab", templ.KV("k-tab-active", nav.IsActive(ctx, "registries")) }>{ i18n.T(ctx, "reg.link") }</a>
		<a href={ templ.SafeURL("/orgs/" + itoa(orgID) + "/git-credentials") } class={ "k-tab", templ.KV("k-tab-active", nav.IsActive(ctx, "git-credentials")) }>{ i18n.T(ctx, "gitcred.link") }</a>
		if auth.IsInstanceAdmin(ctx) {
			<a href={ templ.SafeURL("/orgs/" + itoa(orgID) + "/nodes") } class={ "k-tab", templ.KV("k-tab-active", nav.IsActive(ctx, "nodes")) }>{ i18n.T(ctx, "nodes.link") }</a>
			<a href={ templ.SafeURL("/orgs/" + itoa(orgID) + "/firewall") } class={ "k-tab", templ.KV("k-tab-active", nav.IsActive(ctx, "firewall")) }>{ i18n.T(ctx, "firewall.link") }</a>
		}
		<a href={ templ.SafeURL("/orgs/" + itoa(orgID) + "/destinations") } class={ "k-tab", templ.KV("k-tab-active", nav.IsActive(ctx, "destinations")) }>{ i18n.T(ctx, "dest.link") }</a>
		<a href={ templ.SafeURL("/orgs/" + itoa(orgID) + "/notifications") } class={ "k-tab", templ.KV("k-tab-active", nav.IsActive(ctx, "notifications")) }>{ i18n.T(ctx, "notif.link") }</a>
		<form method="post" hx-boost="false" action="/lang" class="ml-auto flex items-center gap-2">
			<label class="k-label" style="margin:0">{ i18n.T(ctx, "settings.language") }</label>
			<select class="k-select" name="lang" style="width:auto" onchange="this.form.submit()">
				for _, l := range i18n.Locales {
					<option value={ l.Code } selected?={ l.Code == i18n.Current(ctx) }>{ l.Name }</option>
				}
			</select>
		</form>
	</div>
}

templ Bare(title string) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="utf-8"/>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<title>{ title } — Krill</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script defer src="/static/app.js"></script>
		</head>
		<body class="flex" hx-boost="true">
			<main class="flex-1 flex items-center justify-center min-h-screen p-4">
				if f := flash.From(ctx); f != nil {
					<div class="k-toast-host">
						<div class={ "k-toast", "k-toast-" + f.Kind, "k-toast-pop" } onclick="krillDismissToast(this)" role="status">{ f.Msg }</div>
					</div>
				}
				{ children... }
			</main>
		</body>
	</html>
}

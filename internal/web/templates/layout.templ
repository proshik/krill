package templates

import db "github.com/proshik/krill/internal/database/gen"

templ Layout(title string, org db.Organization, role string) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — Krill</title>
			<link rel="stylesheet" href="/static/xterm.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			<aside class="sidebar">
				<h1>🦐 Krill</h1>
				<div class="org-badge">
					<a href="/orgs">{ org.Name } ▾</a>
					<span class="role">{ role }</span>
				</div>
				<nav>
					<a href={ templ.SafeURL("/orgs/" + itoa(org.ID)) }>Проекты</a>
					if role == "owner" || role == "admin" {
						<a href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/members") }>Члены</a>
					}
					<a href="/logout">Выйти</a>
				</nav>
			</aside>
			<main class="content">
				{ children... }
			</main>
		</body>
	</html>
}

templ Bare(title string) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="utf-8"/>
			<title>{ title } — Krill</title>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body style="align-items:center; justify-content:center;">
			<main style="width:320px;">
				{ children... }
			</main>
		</body>
	</html>
}

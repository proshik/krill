package templates

import db "github.com/proshik/krill/internal/database/gen"

templ Layout(title string, org db.Organization, role string) {
	<!DOCTYPE html>
	<html lang="ru" class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — Krill</title>
			<link rel="stylesheet" href="/static/xterm.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body class="flex">
			<aside class="k-side">
				<div class="k-side-brand">🦐 Krill</div>
				<div class="k-org-badge">
					<a href="/orgs">{ org.Name } ▾</a>
					<span class="role">{ role }</span>
				</div>
				<nav>
					<a class={ "k-nav", "k-nav-active" } href={ templ.SafeURL("/orgs/" + itoa(org.ID)) }>Проекты</a>
					if role == "owner" || role == "admin" {
						<a class="k-nav" href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/members") }>Члены</a>
					}
					<a class="k-nav" href="/logout">Выйти</a>
				</nav>
			</aside>
			<main class="flex-1 min-w-0">
				<div class="k-content">
					{ children... }
				</div>
				<script src="/static/app.js"></script>
			</main>
		</body>
	</html>
}

templ Bare(title string) {
	<!DOCTYPE html>
	<html lang="ru" class="dark">
		<head>
			<meta charset="utf-8"/>
			<title>{ title } — Krill</title>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body class="flex items-center justify-center min-h-screen">
			<main class="w-[340px]">
				{ children... }
			</main>
		</body>
	</html>
}

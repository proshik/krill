package templates

import db "github.com/proshik/krill/internal/database/gen"

templ Destinations(org db.Organization, role string, dests []db.Destination) {
	@Layout("Destinations", org, role) {
		<div class="k-card">
			<table class="k-table">
				<thead><tr><th>Name</th><th>Endpoint</th><th>Bucket</th><th>Region</th><th></th></tr></thead>
				<tbody>
					for _, d := range dests {
						<tr>
							<td>{ d.Name }</td><td class="k-mono">{ d.Endpoint }</td><td class="k-mono">{ d.Bucket }</td><td>{ d.Region }</td>
							<td>
								if role == "owner" || role == "admin" {
									<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/destinations/" + itoa(d.ID) + "/delete") } onsubmit="return confirm('Delete destination?')">
										<button class="k-btn k-btn-danger">Delete</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			if role == "owner" || role == "admin" {
				<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/destinations") } class="mt-4 flex flex-col gap-2">
					<input class="k-input" name="name" placeholder="name"/>
					<input class="k-input" name="endpoint" placeholder="endpoint (blank for AWS; URL for MinIO)"/>
					<input class="k-input" name="bucket" placeholder="bucket"/>
					<input class="k-input" name="region" placeholder="region (us-east-1)"/>
					<input class="k-input" name="access_key" placeholder="access key"/>
					<input class="k-input" name="secret_key" placeholder="secret key" type="password"/>
					<button class="k-btn k-btn-primary">Add destination</button>
				</form>
			}
		</div>
	}
}

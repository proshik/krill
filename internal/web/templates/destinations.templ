package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
)

templ Destinations(org db.Organization, role string, dests []db.Destination) {
	@Layout(i18n.T(ctx, "dest.title"), org, role) {
		<div class="k-card">
			<table class="k-table">
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "dest.name") }</th>
						<th>{ i18n.T(ctx, "dest.endpoint") }</th>
						<th>{ i18n.T(ctx, "dest.bucket") }</th>
						<th>{ i18n.T(ctx, "dest.region") }</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, d := range dests {
						<tr>
							<td>{ d.Name }</td><td class="k-mono">{ d.Endpoint }</td><td class="k-mono">{ d.Bucket }</td><td>{ d.Region }</td>
							<td>
								if role == "owner" || role == "admin" {
									<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/destinations/" + itoa(d.ID) + "/delete") } data-name={ d.Name } onsubmit="return confirm('Delete destination ' + this.dataset.name + '?')">
										<button class="k-btn k-btn-danger">{ i18n.T(ctx, "dest.delete") }</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			if role == "owner" || role == "admin" {
				<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/destinations") } class="mt-4 flex flex-col gap-2">
					<div>
						<label class="k-label">{ i18n.T(ctx, "dest.name") }</label>
						<input class="k-input" name="name"/>
					</div>
					<div>
						<label class="k-label">{ i18n.T(ctx, "dest.endpoint") }</label>
						<input class="k-input" name="endpoint" placeholder="(blank for AWS; URL for MinIO)"/>
					</div>
					<div>
						<label class="k-label">{ i18n.T(ctx, "dest.bucket") }</label>
						<input class="k-input" name="bucket"/>
					</div>
					<div>
						<label class="k-label">{ i18n.T(ctx, "dest.region") }</label>
						<input class="k-input" name="region" placeholder="us-east-1"/>
					</div>
					<div>
						<label class="k-label">{ i18n.T(ctx, "dest.access_key") }</label>
						<input class="k-input" name="access_key"/>
					</div>
					<div>
						<label class="k-label">{ i18n.T(ctx, "dest.secret_key") }</label>
						<input class="k-input" name="secret_key" type="password"/>
					</div>
					<div><button class="k-btn k-btn-primary">{ i18n.T(ctx, "dest.add") }</button></div>
				</form>
			}
		</div>
	}
}

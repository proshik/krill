package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// Destinations lists the S3 storages backups go to.
templ Destinations(org db.Organization, role string, dests []db.Destination) {
	@SettingsPage(org, role, "storage", i18n.T(ctx, "dest.title")) {
		<section class="sec" aria-labelledby="st-h">
			if len(dests) == 0 {
				<p class="empty" id="st-h">{ i18n.T(ctx, "backup.no_storage_title") }</p>
				<p class="hint">{ i18n.T(ctx, "backup.no_storage_hint") }</p>
			} else {
				<div class="sec-head"><h3 id="st-h">{ i18n.Tn(ctx, "dest.n", len(dests)) }</h3></div>
				<ul class="links">
					for _, d := range dests {
						<li class="row-item">
							<span class="link-var">{ d.Name }</span>
							<span class="link-src"><code>{ destWhere(d) }</code></span>
							<span class="run-meta">{ d.Region }</span>
							if isAdmin(role) {
								<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/destinations/" + itoa(d.ID) + "/delete") } data-confirm={ i18n.Tf(ctx, "confirm.delete_destination", d.Name) } data-more={ i18n.T(ctx, "dest.delete_more") } data-ok={ i18n.T(ctx, "common.delete") } onsubmit="return krillConfirm(this)">
									<button type="submit" class="pill pill--icon pill--danger" aria-label={ i18n.Tf(ctx, "common.delete_named", d.Name) } title={ i18n.T(ctx, "common.delete") }>
										@ui.Icon("i-trash")
									</button>
								</form>
							} else {
								<span></span>
							}
						</li>
					}
				</ul>
			}
			<p class="hint">{ i18n.T(ctx, "dest.desc") }</p>
		</section>
		if isAdmin(role) {
			<section class="sec" aria-labelledby="ad-h">
				<h3 id="ad-h">{ i18n.T(ctx, "dest.add_title") }</h3>
				@inlineDestinationForm(org.ID, "")
			</section>
		}
	}
}

func destWhere(d db.Destination) string {
	if d.Endpoint == "" {
		return "s3://" + d.Bucket
	}
	return trimScheme(d.Endpoint) + "/" + d.Bucket
}

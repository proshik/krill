package templates

templ AppForm(errMsg, baseDomain string) {
	@Layout("Новое приложение") {
		<h2>Новое приложение</h2>
		<div class="card">
			if errMsg != "" {
				<p class="form-error">{ errMsg }</p>
			}
			<form method="post" action="/apps">
				<label>Имя (slug: a-z, 0-9, -)</label>
				<input name="name" required pattern="[a-z0-9-]+" placeholder="web"/>
				<label>Образ</label>
				<input name="image" required placeholder="nginx"/>
				<label>Тег</label>
				<input name="tag" value="latest"/>
				<label>Домен (пусто = &lt;имя&gt;.{ baseDomain })</label>
				<input name="domain" placeholder={ "web." + baseDomain }/>
				<label>Порт контейнера</label>
				<input name="port" type="number" value="80" required/>
				<label>ENV (KEY=VALUE, по строке)</label>
				<textarea name="env" rows="4" style="width:100%;"></textarea>
				<div style="margin-top:14px;">
					<button type="submit">Создать</button>
					<a href="/apps"><button type="button" class="secondary">Отмена</button></a>
				</div>
			</form>
		</div>
	}
}

package templates

import "github.com/proshik/krill/internal/web/i18n"

// Login renders the sign-in form. insecureCookies warns that the session cookie
// will be marked Secure while this page was served over plain HTTP, so the
// browser would drop it and the sign-in would silently loop.
templ Login(errMsg string, insecureCookies bool) {
	@AuthPage(i18n.T(ctx, "login.page_title")) {
		<h1>{ i18n.T(ctx, "login.title") }</h1>
		if insecureCookies {
			<div class="callout callout--err"><p>{ i18n.T(ctx, "login.cookie_secure_http") }</p></div>
		}
		if errMsg != "" {
			<div class="callout callout--err" role="alert"><p>{ errMsg }</p></div>
		}
		<form class="stack" method="post" action="/login" hx-boost="false">
			<div class="field">
				<label for="lemail">{ i18n.T(ctx, "login.email") }</label>
				<input class="input" id="lemail" name="email" type="email" autocomplete="username" required autofocus/>
			</div>
			<div class="field">
				<label for="lpass">{ i18n.T(ctx, "login.password") }</label>
				<input class="input" id="lpass" name="password" type="password" autocomplete="current-password" required/>
			</div>
			<button type="submit" class="btn btn--primary btn--wide">{ i18n.T(ctx, "login.submit") }</button>
		</form>
	}
}

package templates

import "github.com/proshik/krill/internal/web/i18n"

templ Login(errMsg string) {
	@Bare(i18n.T(ctx, "login.page_title")) {
		<div class="k-card w-[360px] max-w-full">
			<div class="k-side-brand mb-4" style="font-size:20px">🦐 Krill</div>
			if errMsg != "" {
				<div class="k-toast k-toast-err mb-3">{ errMsg }</div>
			}
			<form method="post" action="/login" hx-boost="false">
				<label class="k-label">{ i18n.T(ctx, "login.email") }</label>
				<input class="k-input" name="email" type="email" required autofocus/>
				<label class="k-label">{ i18n.T(ctx, "login.password") }</label>
				<input class="k-input" name="password" type="password" required/>
				<div class="mt-4">
					<button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "login.submit") }</button>
				</div>
			</form>
		</div>
	}
}

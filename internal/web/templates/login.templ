package templates

templ Login(errMsg string) {
	@Bare("Вход") {
		<div class="k-card">
			<h2 class="text-2xl mb-4">Вход в Krill</h2>
			if errMsg != "" {
				<div class="k-toast k-toast-err mb-3">{ errMsg }</div>
			}
			<form method="post" action="/login">
				<label class="k-label">Email</label>
				<input class="k-input" name="email" type="email" required autofocus/>
				<label class="k-label">Пароль</label>
				<input class="k-input" name="password" type="password" required/>
				<div class="mt-4">
					<button type="submit" class="k-btn k-btn-primary">Войти</button>
				</div>
			</form>
		</div>
	}
}

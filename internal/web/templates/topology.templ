package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// TopoView is the topology page: an ingress lane and one lane per node.
type TopoView struct {
	Lanes    []TopoLane
	Projects []string
	Project  string // the project filter, "" for all
}

// TopoLane is a lane of the topology.
type TopoLane struct {
	Name      string
	Href      string // the node on the nodes page ("" for ingress)
	Ingress   bool
	StateKind string
	StateText string
	Apps      []TopoCard
	Servers   []TopoCard
}

// TopoCard is a card of the topology.
type TopoCard struct {
	ElemID    string
	Name      string
	Sub       string
	Line      string // the app's public address
	Href      string
	Glyph     string
	StateKind string
	StateText string
	To        []string
	Detected  []string
	Projects  string // space-separated project names, for the filter
	Holds     []TopoHold
	Gateway   bool
	System    bool
}

// TopoHold is a database inside a server card.
type TopoHold struct {
	Name, Env string
}

templ Topology(org db.Organization, role string, v TopoView) {
	@Page(Shell{Title: i18n.T(ctx, "topo.title"), Org: org, Role: role, Tab: "topology"}) {
		<main class="wrap wrap--wide">
			<div class="page-head">
				<h1>{ i18n.T(ctx, "topo.title") }</h1>
				if len(v.Projects) > 1 {
					<nav class="seg seg--tight" aria-label={ i18n.T(ctx, "topo.project") }>
						<a href={ templ.SafeURL(orgURL(org.ID) + "/topology") } aria-current?={ v.Project == "" }>{ i18n.T(ctx, "topo.all_projects") }</a>
						for _, p := range v.Projects {
							<a href={ templ.SafeURL(orgURL(org.ID) + "/topology?project=" + urlQuery(p)) } aria-current?={ v.Project == p }>{ p }</a>
						}
					</nav>
				}
			</div>
			<ul class="legend">
				<li><svg class="legend-line" viewBox="0 0 28 8" aria-hidden="true"><path class="w-ingress" d="M1 4H27"></path></svg>{ i18n.T(ctx, "topo.legend.ingress") }</li>
				<li><svg class="legend-line" viewBox="0 0 28 8" aria-hidden="true"><path class="w-link" d="M1 4H27"></path></svg>{ i18n.T(ctx, "topo.legend.link") }</li>
				<li><svg class="legend-line" viewBox="0 0 28 8" aria-hidden="true"><path class="w-cross" d="M1 4H27"></path></svg>{ i18n.T(ctx, "topo.legend.crossnode") }</li>
				<li><svg class="legend-line" viewBox="0 0 28 8" aria-hidden="true"><path class="w-detected" d="M1 4H27"></path></svg>{ i18n.T(ctx, "topo.legend.detected") }</li>
			</ul>
			<div class="topomap" style={ templ.SafeCSS(laneCols(len(v.Lanes) - 1)) }>
				<svg class="wires" aria-hidden="true"></svg>
				for _, l := range v.Lanes {
					<section class={ "lane", templ.KV("lane--ingress", l.Ingress) } aria-label={ l.Name }>
						<header class="lane-head lane-head--slim">
							<div class="lane-title">
								<h2>
									if l.Href != "" {
										<a href={ templ.SafeURL(l.Href) }>{ l.Name }</a>
									} else {
										{ l.Name }
									}
								</h2>
								if l.StateText != "" {
									@ui.State(l.StateKind, l.StateText)
								}
							</div>
						</header>
						if l.Ingress {
							for _, c := range l.Apps {
								@topoCard(c)
							}
						} else {
							if len(l.Apps) > 0 {
								<div class="lane-group">
									<h3>{ i18n.T(ctx, "nodes.group_apps") }</h3>
									for _, c := range l.Apps {
										@topoCard(c)
									}
								</div>
							}
							if len(l.Servers) > 0 {
								<div class="lane-group">
									<h3>{ i18n.T(ctx, "dbi.title") }</h3>
									for _, c := range l.Servers {
										@topoCard(c)
									}
								</div>
							}
							if len(l.Apps)+len(l.Servers) == 0 {
								<p class="empty lane-empty">{ i18n.T(ctx, "topo.lane_empty") }</p>
							}
						}
					</section>
				}
			</div>
		</main>
	}
}

templ topoCard(c TopoCard) {
	if c.Href != "" {
		<a class="svc" id={ c.ElemID } href={ templ.SafeURL(c.Href) } data-to={ joinSpace(c.To) } data-detected={ joinSpace(c.Detected) } data-project={ c.Projects } data-gateway?={ c.Gateway } data-nodes="">
			@topoCardBody(c)
		</a>
	} else {
		<div class={ "svc", templ.KV("svc--sys", c.System) } id={ c.ElemID } data-to={ joinSpace(c.To) } data-gateway?={ c.Gateway } data-nodes="">
			@topoCardBody(c)
		</div>
	}
}

templ topoCardBody(c TopoCard) {
	<span class="svc-head">
		@ui.Glyph(c.Glyph)
		<span class="svc-name">{ c.Name }</span>
		if c.StateText != "" {
			@ui.State(c.StateKind, c.StateText)
		}
	</span>
	<span class="svc-sub">{ c.Sub }</span>
	if c.Line != "" {
		<span class="uses">{ c.Line }</span>
	}
	if len(c.Holds) > 0 {
		<span class="holds">
			for _, h := range c.Holds {
				<span class="hold">{ h.Name }<em>{ h.Env }</em></span>
			}
		</span>
	}
}

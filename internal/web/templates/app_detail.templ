package templates

import db "github.com/proshik/krill/internal/database/gen"

type AppCtx struct {
	Org     db.Organization
	Role    string
	Project db.Project
	Env     db.Environment
	App     db.Application
	Deps    []db.Deployment
}

func (c AppCtx) base() string {
	return "/orgs/" + itoa(c.Org.ID) + "/projects/" + itoa(c.Project.ID) +
		"/environments/" + itoa(c.Env.ID) + "/apps/" + itoa(c.App.ID)
}

templ AppDetail(c AppCtx, tab string) {
	@Layout(c.App.Name, c.Org, c.Role) {
		<p class="k-crumbs mb-3">
			<a href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID)) }>{ c.Org.Name }</a> /
			<a href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID) + "/projects/" + itoa(c.Project.ID)) }>{ c.Project.Name }</a> /
			{ c.Env.Name } / { c.App.Name }
		</p>
		<div class="k-card flex items-center mb-4 py-2 px-4">
			<a href={ templ.SafeURL(c.base()) } class={ "k-tab", templ.KV("k-tab-active", tab == "general") }>General</a>
			<a href={ templ.SafeURL(c.base() + "?tab=env") } class={ "k-tab", templ.KV("k-tab-active", tab == "env") }>Environment</a>
			<a href={ templ.SafeURL(c.base() + "?tab=deployments") } class={ "k-tab", templ.KV("k-tab-active", tab == "deployments") }>Deployments</a>
			<a href={ templ.SafeURL(c.base() + "?tab=logs") } class={ "k-tab", templ.KV("k-tab-active", tab == "logs") }>Logs</a>
		</div>
		switch tab {
			case "env":
				@envTab(c)
			case "deployments":
				@DeploymentsList(c, c.Deps)
			case "logs":
				@logsTab(c)
			default:
				@generalTab(c)
		}
	}
}

templ generalTab(c AppCtx) {
	<div class="k-card">
		<div hx-get={ c.base() + "/status" } hx-trigger="every 2s" hx-target="#status-badge" hx-swap="outerHTML" class="mb-4">
			Статус: @StatusBadge(c.App.Status)
		</div>
		if c.App.SourceType == "dockerfile" {
			<p class="k-mono text-xs mb-2">Источник: Dockerfile</p>
			<form method="post" action={ templ.SafeURL(c.base() + "/deploy") }>
				<label class="k-label">Git URL</label>
				<input class="k-input" name="git_url" value={ c.App.GitUrl }/>
				<label class="k-label">Ветка</label>
				<input class="k-input" name="git_branch" value={ c.App.GitBranch }/>
				<label class="k-label">Путь к Dockerfile</label>
				<input class="k-input" name="dockerfile_path" value={ c.App.DockerfilePath }/>
				<div class="mt-3"><button type="submit" class="k-btn k-btn-primary">Deploy</button></div>
			</form>
		} else {
			<form method="post" action={ templ.SafeURL(c.base() + "/deploy") }>
				<label class="k-label">Образ</label>
				<input class="k-input" name="image" value={ c.App.Image }/>
				<label class="k-label">Тег</label>
				<input class="k-input" name="tag" value={ c.App.Tag }/>
				<div class="mt-3"><button type="submit" class="k-btn k-btn-primary">Deploy</button></div>
			</form>
		}
		<p class="k-mono text-xs mt-3">Открыть: <a class="text-[color:var(--color-accent)]" href={ templ.SafeURL("http://" + c.App.Domain) } target="_blank">http://{ c.App.Domain }</a></p>
	</div>
}

templ envTab(c AppCtx) {
	<div class="k-panel">
		<div class="k-panel-head">
			<div>
				<div class="k-panel-title">Environment Settings</div>
				<div class="k-panel-desc">Переменные окружения приложения. Применятся после Deploy.</div>
			</div>
		</div>
		<div class="k-panel-body">
			<form method="post" action={ templ.SafeURL(c.base() + "/env") }>
				<textarea class="k-code" name="env" spellcheck="false" placeholder="NODE_ENV=production&#10;PORT=3000">{ envText(c.App.Env) }</textarea>
				<div class="mt-4 flex justify-end">
					<button type="submit" class="k-btn k-btn-primary">Сохранить</button>
				</div>
			</form>
		</div>
	</div>
}

templ logsTab(c AppCtx) {
	<div class="k-card">
		<div id="terminal" data-ws={ c.base() + "/logs" }></div>
		<script src="/static/xterm.js"></script>
		<script src="/static/addon-fit.js"></script>
		<script src="/static/app.js"></script>
		<script>
			mountLogTerminal(document.getElementById('terminal').dataset.ws);
		</script>
	</div>
}

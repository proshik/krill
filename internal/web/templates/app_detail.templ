package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/docker"
	"github.com/proshik/krill/internal/web/i18n"
)

type AppCtx struct {
	Org        db.Organization
	Role       string
	Project    db.Project
	Env        db.Environment
	App        db.Application
	Deps       []db.Deployment
	Domains    []db.Domain
	Volumes    []db.AppVolume
	Ports      []db.AppPort
	Registries []db.Registry
	Exposed    bool

	GitCredentials    []db.GitCredential
	BuildSecretsPlain string // decrypted build_secrets, set for admins only (never ciphertext)
	Tasks             []docker.TaskPlacement // running/desired tasks of this app's service + their nodes
	Nodes             []docker.SwarmNode     // cluster nodes (for the placement picker; admin only)
	NodeLabels        map[string]string      // swarm_node_id → display label (topology + placement); empty → hostname

	VolumeBackups map[int64][]db.VolumeBackup // app_volume_id → its backups
	Destinations  []db.Destination

	DBLinks        []DBLinkView
	Ldbs           []db.ListLogicalDatabasesByEnvironmentRow // logical DBs of this environment (pg link options)
	RedisInstances []db.DbInstance                           // redis instances of this org (redis link options)

	AutoDeploy    bool
	WebhookSecret string // decrypted; set for admins only
	WebhookURL    string // full external webhook/deploy-hook URL
}

// DBLinkView is a linked DB row for the Environment tab. Collides is true when
// VarName is also present in env_text (the link overrides it on deploy).
type DBLinkView struct {
	ID       int64
	Engine   string
	DBName   string
	VarName  string
	Scheme   string
	Field    string
	Collides bool
}

func (c AppCtx) base() string {
	return "/orgs/" + itoa(c.Org.ID) + "/projects/" + itoa(c.Project.ID) +
		"/environments/" + itoa(c.Env.ID) + "/apps/" + itoa(c.App.ID)
}

templ AppDetail(c AppCtx, tab string) {
	@Layout(c.App.Name, c.Org, c.Role) {
		<p class="k-crumbs mb-3">
			<a href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID)) }>{ c.Org.Name }</a> /
			<a href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID) + "/projects/" + itoa(c.Project.ID)) }>{ c.Project.Name }</a> /
			<a href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID) + "/projects/" + itoa(c.Project.ID) + "/environments/" + itoa(c.Env.ID)) }>{ c.Env.Name }</a> / { c.App.Name }
		</p>
		<div class="k-frame">
			<div class="k-panel flex items-center flex-wrap mb-2 py-2 px-4">
			<a href={ templ.SafeURL(c.base()) } class={ "k-tab", templ.KV("k-tab-active", tab == "general") }>{ i18n.T(ctx, "tab.general") }</a>
			if c.Role == "owner" || c.Role == "admin" {
				<a href={ templ.SafeURL(c.base() + "?tab=env") } class={ "k-tab", templ.KV("k-tab-active", tab == "env") }>{ i18n.T(ctx, "tab.environment") }</a>
			}
			<a href={ templ.SafeURL(c.base() + "?tab=deployments") } class={ "k-tab", templ.KV("k-tab-active", tab == "deployments") }>{ i18n.T(ctx, "tab.deployments") }</a>
			<a href={ templ.SafeURL(c.base() + "?tab=logs") } class={ "k-tab", templ.KV("k-tab-active", tab == "logs") }>{ i18n.T(ctx, "tab.logs") }</a>
			<a href={ templ.SafeURL(c.base() + "?tab=domains") } class={ "k-tab", templ.KV("k-tab-active", tab == "domains") }>{ i18n.T(ctx, "domains.tab") }</a>
			<a href={ templ.SafeURL(c.base() + "?tab=advanced") } class={ "k-tab", templ.KV("k-tab-active", tab == "advanced") }>{ i18n.T(ctx, "tab.advanced") }</a>
			if c.Role == "owner" || c.Role == "admin" {
				<a href={ templ.SafeURL(c.base() + "?tab=volumes") } class={ "k-tab", templ.KV("k-tab-active", tab == "volumes") }>{ i18n.T(ctx, "volumes.tab") }</a>
			}
			if c.Role == "owner" || c.Role == "admin" {
				<a href={ templ.SafeURL(c.base() + "?tab=terminal") } class={ "k-tab", templ.KV("k-tab-active", tab == "terminal") }>{ i18n.T(ctx, "tab.terminal") }</a>
			}
		</div>
		if !c.Exposed {
			<div class="k-toast k-toast-err mb-4">
				{ i18n.T(ctx, "domains.not_exposed_warning") }
				<a class="underline" href={ templ.SafeURL(c.base() + "?tab=domains") }>{ i18n.T(ctx, "domains.tab") }</a>.
			</div>
		}
		switch tab {
			case "env":
				@envTab(c)
			case "deployments":
				@DeploymentsList(c, c.Deps)
			case "logs":
				@logsTab(c)
			case "domains":
				@domainsTab(c)
			case "advanced":
				@advancedTab(c)
			case "volumes":
				@volumesTab(c)
			case "terminal":
				@terminalTab(c)
			default:
				@generalTab(c)
		}
		</div>
	}
}

templ generalTab(c AppCtx) {
	<div class="k-card">
		<div hx-get={ c.base() + "/status" } hx-trigger="every 2s" hx-target="#status-badge" hx-swap="outerHTML" class="mb-4 flex items-center gap-2">
			<span class="k-mono text-xs">{ i18n.T(ctx, "app.status") }:</span>
			@StatusBadge(c.App.Status)
		</div>
		if len(c.Tasks) > 0 {
			<div class="mb-4">
				<span class="k-mono text-xs">{ i18n.T(ctx, "topology.title") }:</span>
				<div class="flex flex-col gap-1 mt-1">
					for _, t := range c.Tasks {
						<div class="k-mono text-xs">
							if t.NodeName != "" {
								<span class="k-badge">{ nodeDisplay(c.NodeLabels, t.NodeID, t.NodeName) }</span>
							} else {
								<span class="k-badge k-badge-idle">—</span>
							}
							{ t.State }
							if t.Desired != "" && t.Desired != t.State {
								<span class="k-muted">→ { t.Desired }</span>
							}
						</div>
					}
				</div>
			</div>
		}
		<div class="k-section">{ i18n.T(ctx, "app.section_source") }</div>
		if c.App.SourceType == "dockerfile" {
			<p class="k-mono text-xs mb-2">{ i18n.T(ctx, "app.source_is_dockerfile") }</p>
			<form id="deploy-form" method="post" action={ templ.SafeURL(c.base() + "/deploy") }>
				<label class="k-label">{ i18n.T(ctx, "app.git_url") }</label>
				<input class="k-input" name="git_url" value={ c.App.GitUrl }/>
				<label class="k-label">{ i18n.T(ctx, "app.git_branch") }</label>
				<input class="k-input" name="git_branch" value={ c.App.GitBranch }/>
				<label class="k-label">{ i18n.T(ctx, "app.dockerfile_path") }</label>
				<input class="k-input" name="dockerfile_path" value={ c.App.DockerfilePath }/>
			</form>
		} else {
			<form id="deploy-form" method="post" action={ templ.SafeURL(c.base() + "/deploy") }>
				<label class="k-label">{ i18n.T(ctx, "app.image") }</label>
				<input class="k-input" name="image" value={ c.App.Image } placeholder="ghcr.io/owner/name (full ref)"/>
				<label class="k-label">{ i18n.T(ctx, "app.tag") }</label>
				<div id="tag-field">
					<input class="k-input" name="tag" value={ c.App.Tag }/>
				</div>
				if c.App.RegistryID != nil {
					<button type="button" class="k-btn k-btn-secondary mt-2" hx-get={ c.base() + "/tags" } hx-target="#tag-field" hx-swap="innerHTML" hx-disabled-elt="this"><span class="k-spin"></span>{ i18n.T(ctx, "app.load_tags") }</button>
				}
			</form>
		}
		if c.Role == "owner" || c.Role == "admin" {
			<form method="post" action={ templ.SafeURL(c.base() + "/registry") } class="mt-3 flex items-end gap-2">
				<div class="flex-1">
					<label class="k-label">{ i18n.T(ctx, "app.registry") }</label>
					<select class="k-select" name="registry_id">
						<option value="">{ i18n.T(ctx, "app.registry_public") }</option>
						for _, reg := range c.Registries {
							if c.App.RegistryID != nil && *c.App.RegistryID == reg.ID {
								<option value={ itoa(reg.ID) } selected>{ reg.Name }</option>
							} else {
								<option value={ itoa(reg.ID) }>{ reg.Name }</option>
							}
						}
					</select>
				</div>
				<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "app.registry_save") }</button>
			</form>
		}
		if c.App.SourceType == "dockerfile" && (c.Role == "owner" || c.Role == "admin") {
			<form method="post" action={ templ.SafeURL(c.base() + "/git-credential") } class="mt-3 flex items-end gap-2">
				<div class="flex-1">
					<label class="k-label">{ i18n.T(ctx, "app.git_credential") }</label>
					<select class="k-select" name="git_credential_id">
						<option value="">{ i18n.T(ctx, "app.git_credential_none") }</option>
						for _, gc := range c.GitCredentials {
							if c.App.GitCredentialID != nil && *c.App.GitCredentialID == gc.ID {
								<option value={ itoa(gc.ID) } selected>{ gc.Name }</option>
							} else {
								<option value={ itoa(gc.ID) }>{ gc.Name }</option>
							}
						}
					</select>
				</div>
				<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "app.git_credential_save") }</button>
			</form>
		}
		<div class="k-section">{ i18n.T(ctx, "app.section_actions") }</div>
		<!-- standalone forms so all actions share one button row via the form= attribute -->
		<form id="rebuild-form" method="post" action={ templ.SafeURL(c.base() + "/rebuild") }></form>
		<form id="reload-form" method="post" action={ templ.SafeURL(c.base() + "/reload") }></form>
		<form id="stop-form" method="post" hx-boost="false" action={ templ.SafeURL(c.base() + "/stop") } data-confirm={ i18n.Tf(ctx, "confirm.stop_app", c.App.Name) } data-label={ i18n.T(ctx, "common.stop") } data-kind="primary" onsubmit="return krillConfirm(this, this.dataset.confirm, this.dataset.label, this.dataset.kind)"></form>
		<div class="flex items-center gap-2 flex-wrap">
			<button type="submit" form="deploy-form" class="k-btn k-btn-primary pr-7">
				{ i18n.T(ctx, "app.deploy") }
				<span class="k-info" data-tip={ i18n.T(ctx, "app.deploy_hint") } aria-label={ i18n.T(ctx, "app.deploy_hint") } onclick="event.preventDefault();event.stopPropagation();">i</span>
			</button>
			<button type="submit" form="reload-form" class="k-btn k-btn-secondary pr-7">
				{ i18n.T(ctx, "app.reload") }
				<span class="k-info" data-tip={ i18n.T(ctx, "app.reload_hint") } aria-label={ i18n.T(ctx, "app.reload_hint") } onclick="event.preventDefault();event.stopPropagation();">i</span>
			</button>
			<button type="submit" form="rebuild-form" class="k-btn k-btn-secondary pr-7">
				{ i18n.T(ctx, "app.rebuild") }
				<span class="k-info" data-tip={ i18n.T(ctx, "app.rebuild_hint") } aria-label={ i18n.T(ctx, "app.rebuild_hint") } onclick="event.preventDefault();event.stopPropagation();">i</span>
			</button>
			<button type="submit" form="stop-form" class="k-btn k-btn-danger pr-7">
				{ i18n.T(ctx, "app.stop") }
				<span class="k-info" data-tip={ i18n.T(ctx, "app.stop_hint") } aria-label={ i18n.T(ctx, "app.stop_hint") } onclick="event.preventDefault();event.stopPropagation();">i</span>
			</button>
		</div>
		if c.Exposed {
			<div class="k-section">{ i18n.T(ctx, "app.section_access") }</div>
			<p class="k-mono text-xs flex items-center gap-2">
				{ i18n.T(ctx, "app.open") }
				<a class="text-[color:var(--color-accent)]" href={ templ.SafeURL("http://" + c.App.Domain) } target="_blank">http://{ c.App.Domain }</a>
				<button type="button" class="k-copy" data-copy={ c.App.Domain } onclick="krillCopyToClip(this.dataset.copy, 'Domain')">{ i18n.T(ctx, "common.copy") }</button>
			</p>
		}
		if c.Role == "owner" || c.Role == "admin" {
			<div class="k-section">{ i18n.T(ctx, "autodeploy.title") }</div>
			<p class="k-mono text-xs mb-2">{ i18n.T(ctx, "autodeploy.desc") }</p>
			if c.AutoDeploy {
				<div class="mb-2">
					<label class="k-label">{ i18n.T(ctx, "autodeploy.url") }</label>
					<div class="flex items-center gap-2">
						<input class="k-input k-mono" readonly value={ c.WebhookURL }/>
						<button type="button" class="k-copy" data-copy={ c.WebhookURL } onclick="krillCopyToClip(this.dataset.copy, 'Webhook URL')">{ i18n.T(ctx, "common.copy") }</button>
					</div>
					<label class="k-label">{ i18n.T(ctx, "autodeploy.secret") }</label>
					<div class="flex items-center gap-2">
						<input class="k-input k-mono" type="password" readonly value={ c.WebhookSecret }/>
						<button type="button" class="k-copy" onclick="krillReveal(this)" aria-label={ i18n.T(ctx, "common.reveal") }>👁</button>
						<button type="button" class="k-copy" data-copy={ c.WebhookSecret } onclick="krillCopyToClip(this.dataset.copy, 'Webhook secret')">{ i18n.T(ctx, "common.copy") }</button>
					</div>
					if c.App.SourceType == "image" {
						<p class="k-mono text-xs mt-1">{ i18n.T(ctx, "autodeploy.hint_image") }</p>
					} else {
						<p class="k-mono text-xs mt-1">{ i18n.T(ctx, "autodeploy.hint_dockerfile") }</p>
					}
				</div>
				<div class="flex items-center gap-2 flex-wrap">
					<form method="post" action={ templ.SafeURL(c.base() + "/autodeploy/disable") }>
						<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "autodeploy.disable") }</button>
					</form>
					<form method="post" hx-boost="false" action={ templ.SafeURL(c.base() + "/autodeploy/regenerate") } data-confirm={ i18n.T(ctx, "autodeploy.regenerate_warn") } onsubmit="return krillConfirm(this, this.dataset.confirm)">
						<button type="submit" class="k-btn k-btn-danger">{ i18n.T(ctx, "autodeploy.regenerate") }</button>
					</form>
				</div>
			} else {
				<form method="post" action={ templ.SafeURL(c.base() + "/autodeploy/enable") }>
					<button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "autodeploy.enable") }</button>
				</form>
			}
		}
		if c.Role == "owner" || c.Role == "admin" {
			<div class="k-section">{ i18n.T(ctx, "app.section_danger") }</div>
			<form method="post" hx-boost="false" action={ templ.SafeURL(c.base() + "/delete") } data-confirm={ i18n.Tf(ctx, "confirm.delete_app", c.App.Name) } onsubmit="return krillConfirm(this, this.dataset.confirm)">
				<label class="k-label" style="display:block;margin-bottom:.5rem"><input class="k-check" type="checkbox" name="destroy_data"/> { i18n.T(ctx, "app.delete.destroy_data") }</label>
				<button type="submit" class="k-btn k-btn-danger">{ i18n.T(ctx, "app.delete") }</button>
			</form>
		}
	</div>
}

templ envTab(c AppCtx) {
	<div class="k-card">
		<div class="flex justify-between items-center gap-4 flex-wrap mb-4">
			<div>
				<div class="k-panel-title">{ i18n.T(ctx, "env.settings_title") }</div>
				<div class="k-panel-desc">{ i18n.T(ctx, "env.settings_desc") }</div>
			</div>
			<div class="flex items-center gap-2">
				<button type="button" class="k-copy" data-show={ i18n.T(ctx, "env.show_values") } data-hide={ i18n.T(ctx, "env.hide_values") } onclick="krillEnvRevealToggle(this)">👁 { i18n.T(ctx, "env.show_values") }</button>
				<div class="k-seg" id="env-seg">
					<button type="button" class="k-seg-btn" data-env-mode="kv" onclick="krillEnvMode('kv')">{ i18n.T(ctx, "env.mode_kv") }</button>
					<button type="button" class="k-seg-btn" data-env-mode="raw" onclick="krillEnvMode('raw')">{ i18n.T(ctx, "env.mode_raw") }</button>
				</div>
			</div>
		</div>
		<div class="k-section">{ i18n.T(ctx, "dblink.section") }</div>
		<p class="k-panel-desc mb-2">{ i18n.T(ctx, "dblink.note") }</p>
		if len(c.DBLinks) > 0 {
			<table class="k-table mb-3">
				<thead><tr>
					<th>{ i18n.T(ctx, "dblink.var_name") }</th>
					<th>{ i18n.T(ctx, "dblink.database") }</th>
					<th>{ i18n.T(ctx, "dblink.scheme") }</th>
					<th></th>
				</tr></thead>
				<tbody>
					for _, l := range c.DBLinks {
						<tr>
							<td class="k-mono">
								{ l.VarName }
								<span class="k-muted text-xs">· { l.Field }</span>
								if l.Collides {
									<span class="k-toast k-toast-err" style="display:inline-block;margin-left:.5rem;padding:.1rem .4rem">{ i18n.Tf(ctx, "dblink.collision", l.VarName) }</span>
								}
							</td>
							<td class="k-mono">{ l.Engine } · { l.DBName }</td>
							<td class="k-mono text-xs">{ l.Scheme }</td>
							<td>
								<form method="post" hx-boost="false" action={ templ.SafeURL(c.base() + "/db-links/" + itoa(l.ID) + "/delete") } class="inline" data-confirm={ i18n.Tf(ctx, "confirm.delete_dblink", l.VarName) } onsubmit="return krillConfirm(this, this.dataset.confirm)">
									<button type="submit" class="k-btn k-btn-danger">{ i18n.T(ctx, "dblink.delete") }</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		if len(c.Ldbs) == 0 && len(c.RedisInstances) == 0 {
			<p class="k-muted mb-3">{ i18n.T(ctx, "dblink.no_databases") }</p>
		} else {
			<form method="post" action={ templ.SafeURL(c.base() + "/db-links") } class="flex items-end gap-2 flex-wrap mb-4">
				<div>
					<label class="k-label">{ i18n.T(ctx, "dblink.database") }</label>
					<select id="dblink-db" class="k-select" name="db_ref">
						for _, ldb := range c.Ldbs {
							<option value={ "pg:" + itoa(ldb.ID) }>🐘 { ldb.Name + " (" + ldb.DbName + " @ " + ldb.InstanceName + ")" }</option>
						}
						for _, inst := range c.RedisInstances {
							<option value={ "redis:" + itoa(inst.ID) }>🟥 { inst.Name }</option>
						}
					</select>
				</div>
				<div>
					<label class="k-label">{ i18n.T(ctx, "dblink.var_name") }</label>
					<input class="k-input k-mono" name="var_name" placeholder="DATABASE_URL" required/>
				</div>
				<div id="dblink-scheme-wrap">
					<label class="k-label">{ i18n.T(ctx, "dblink.scheme") }</label>
					<select id="dblink-scheme" class="k-select" name="scheme">
						<option value="postgresql" data-engine="pg">postgresql://</option>
						<option value="postgres" data-engine="pg">postgres://</option>
						<option value="redis" data-engine="redis">redis://</option>
					</select>
				</div>
				<div>
					<label class="k-label">{ i18n.T(ctx, "dblink.field") }</label>
					<select id="dblink-field" class="k-select" name="field">
						<option value="url">url</option>
						<option value="password">password</option>
						<option value="host">host</option>
						<option value="port">port</option>
						<option value="user">user</option>
						<option value="dbname">dbname</option>
					</select>
				</div>
				<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "dblink.add") }</button>
				<p class="k-muted text-xs mt-1" style="flex-basis:100%">{ i18n.T(ctx, "dblink.var_hint") }</p>
				<p class="k-muted text-xs mt-1" style="flex-basis:100%">{ i18n.T(ctx, "dblink.field_hint") }</p>
				<p id="dblink-scheme-hint" class="k-muted text-xs mt-1" style="flex-basis:100%;display:none">{ i18n.T(ctx, "dblink.scheme_hint") }</p>
			</form>
		}
		<form id="env-form" method="post" action={ templ.SafeURL(c.base() + "/env") } onsubmit="if(this.dataset.mode==='kv') krillEnvSyncToTextarea()">
				<div id="env-kv" style="display:none">
					<div id="env-rows"></div>
					<button type="button" class="k-btn k-btn-secondary mt-1" onclick="krillEnvAddRow('','')">+ { i18n.T(ctx, "env.add_var") }</button>
				</div>
				<div id="env-raw">
					<textarea id="env-textarea" class="k-code" name="env" spellcheck="false" placeholder="NODE_ENV=production&#10;PORT=3000">{ c.App.EnvText }</textarea>
				</div>
				<div class="mt-4 flex justify-end">
					<button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "common.save") }</button>
				</div>
			</form>
	</div>
}

templ logsTab(c AppCtx) {
	<div class="k-card">
		@logViewer(c.base() + "/logs")
	</div>
}

// logViewer renders the structured log viewer (toolbar + body) bound to wsPath.
templ logViewer(wsPath string) {
	<div class="k-logs" data-ws={ wsPath }>
		<div class="k-logs-bar">
			<input class="k-input k-logs-search" placeholder={ i18n.T(ctx, "log.search") }/>
			<div class="k-logs-levels">
				<button type="button" class="k-logs-lvlchip" data-level="debug">DEBUG</button>
				<button type="button" class="k-logs-lvlchip" data-level="info">INFO</button>
				<button type="button" class="k-logs-lvlchip" data-level="warn">WARN</button>
				<button type="button" class="k-logs-lvlchip" data-level="error">ERROR</button>
			</div>
		</div>
		<div class="k-logs-body"></div>
	</div>
}

templ terminalTab(c AppCtx) {
	<div class="k-card">
		<div class="flex items-center gap-2 mb-2">
			<label class="k-label" style="margin:0">{ i18n.T(ctx, "term.command") }</label>
			<input id="term-cmd" class="k-input k-mono" style="max-width:280px" value="/bin/sh"/>
			<button type="button" class="k-btn k-btn-secondary" onclick="krillExecConnect()">{ i18n.T(ctx, "term.connect") }</button>
			<span id="term-status" class="k-muted"></span>
		</div>
		<div class="k-term" data-term-ws={ c.base() + "/terminal/ws" }></div>
		<script src="/static/xterm.js"></script>
		<script src="/static/addon-fit.js"></script>
	</div>
}

templ domainsTab(c AppCtx) {
	<div class="k-card">
		for _, d := range c.Domains {
			<div class="mb-4 pb-4" style="border-bottom:1px solid var(--color-border)">
				<div class="flex items-center gap-2 flex-wrap mb-2">
					<span class="k-mono">{ d.Host }</span>
					if d.IsPrimary {
						<span class="k-badge">{ i18n.T(ctx, "domains.primary") }</span>
					}
					if d.Exposed {
						<span class="k-badge k-badge-running"><span class="k-dot"></span>{ i18n.T(ctx, "domains.exposed") }</span>
					} else {
						<span class="k-badge k-badge-idle"><span class="k-dot"></span>{ i18n.T(ctx, "domains.internal") }</span>
					}
					if d.Tls {
						<span class="k-badge k-badge-running">{ i18n.T(ctx, "domains.tls_on") }</span>
					} else {
						<span class="k-badge">{ i18n.T(ctx, "domains.tls_off") }</span>
					}
				</div>
				<form method="post" action={ templ.SafeURL(c.base() + "/domains/" + itoa(d.ID) + "/exposure") } class="grid gap-2" style="max-width:820px">
					<label class="k-label flex items-center gap-2"><input class="k-check" type="checkbox" name="exposed" checked?={ d.Exposed }/> { i18n.T(ctx, "domains.expose") }</label>
					<div>
						<label class="k-label">{ i18n.T(ctx, "domains.paths") }</label>
						<textarea class="k-code" name="paths" spellcheck="false" placeholder="/webhook">{ d.Paths }</textarea>
						<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "domains.paths_hint") }</p>
					</div>
					<div class="flex items-center gap-2 flex-wrap">
						<button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "domains.save") }</button>
					</div>
				</form>
				<div class="flex items-center gap-2 flex-wrap mt-2">
					<form method="post" action={ templ.SafeURL(c.base() + "/domains/" + itoa(d.ID) + "/tls") } class="inline">
						<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "domains.toggle_tls") }</button>
					</form>
					if !d.IsPrimary {
						<form method="post" hx-boost="false" action={ templ.SafeURL(c.base() + "/domains/" + itoa(d.ID) + "/delete") } class="inline" data-confirm={ i18n.Tf(ctx, "confirm.delete_domain", d.Host) } onsubmit="return krillConfirm(this, this.dataset.confirm)">
							<button type="submit" class="k-btn k-btn-danger">{ i18n.T(ctx, "domains.delete") }</button>
						</form>
					}
				</div>
				if d.Exposed {
					<div class="mt-3 pt-3" style="border-top:1px dashed var(--color-border);max-width:820px">
						<div class="k-label mb-1">{ i18n.T(ctx, "domains.protection") }</div>
						<p class="k-mono text-xs mb-2" style="color:var(--color-faint)">{ i18n.T(ctx, "domains.protection_note") }</p>
						<div class="k-label mb-1">{ i18n.T(ctx, "domains.basicauth") }</div>
						if users := basicAuthUsernames(d.BasicAuthUsers); len(users) == 0 {
							<p class="k-muted text-xs mb-2">{ i18n.T(ctx, "domains.ba_none") }</p>
						} else {
							<div class="flex flex-wrap gap-2 mb-2">
								for _, u := range users {
									<form method="post" hx-boost="false" action={ templ.SafeURL(c.base() + "/domains/" + itoa(d.ID) + "/basic-auth/delete") } class="inline" data-confirm={ i18n.Tf(ctx, "confirm.delete_basicauth", u) } onsubmit="return krillConfirm(this, this.dataset.confirm)">
										<input type="hidden" name="username" value={ u }/>
										<span class="k-badge k-mono">{ u } <button type="submit" class="underline">{ i18n.T(ctx, "domains.ba_remove") }</button></span>
									</form>
								}
							</div>
						}
						<form method="post" action={ templ.SafeURL(c.base() + "/domains/" + itoa(d.ID) + "/basic-auth") } class="flex items-end gap-2 flex-wrap mb-3">
							<div>
								<label class="k-label">{ i18n.T(ctx, "domains.ba_user") }</label>
								<input class="k-input k-mono" name="username" autocomplete="off" required/>
							</div>
							<div>
								<label class="k-label">{ i18n.T(ctx, "domains.ba_pass") }</label>
								<input class="k-input" type="password" name="password" autocomplete="new-password" required/>
							</div>
							<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "domains.ba_add") }</button>
						</form>
						<form method="post" action={ templ.SafeURL(c.base() + "/domains/" + itoa(d.ID) + "/allowed-ips") } class="grid gap-2">
							<label class="k-label">{ i18n.T(ctx, "domains.allowed_ips") }</label>
							<textarea class="k-code" name="ips" spellcheck="false" placeholder="203.0.113.4&#10;10.0.0.0/8">{ d.AllowedIps }</textarea>
							<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "domains.allowed_ips_hint") }</p>
							<div><button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "domains.save") }</button></div>
						</form>
					</div>
				}
			</div>
		}
		<form method="post" action={ templ.SafeURL(c.base() + "/domains") } class="grid gap-2" style="max-width:820px">
			<div>
				<label class="k-label">{ i18n.T(ctx, "domains.host") }</label>
				<input class="k-input" name="host" placeholder="app.example.com"/>
			</div>
			<label class="k-label flex items-center gap-2"><input class="k-check" type="checkbox" name="exposed" checked/> { i18n.T(ctx, "domains.expose") }</label>
			<label class="k-label flex items-center gap-2"><input class="k-check" type="checkbox" name="tls"/> { i18n.T(ctx, "domains.enable_https") }</label>
			<div>
				<label class="k-label">{ i18n.T(ctx, "domains.paths") }</label>
				<textarea class="k-code" name="paths" spellcheck="false" placeholder="/webhook"></textarea>
				<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "domains.paths_hint") }</p>
			</div>
			<div><button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "domains.add") }</button></div>
		</form>
		<p class="k-mono text-xs mt-3">{ i18n.T(ctx, "domains.dns_help") }</p>
	</div>
}

templ TagOptions(tags []string, current string) {
	<select class="k-select" name="tag">
		for _, t := range tags {
			<option value={ t } selected?={ t == current }>{ t }</option>
		}
	</select>
}

templ TagError(current, msg string) {
	<input class="k-input" name="tag" value={ current }/>
	<p class="k-mono text-xs mt-1" style="color:var(--color-err)">{ msg }</p>
}

templ advancedTab(c AppCtx) {
	<div class="k-card">
		<div class="mb-4">
			<div class="k-panel-title">{ i18n.T(ctx, "adv.title") }</div>
			<div class="k-panel-desc">{ i18n.T(ctx, "adv.desc") }</div>
		</div>
		<form method="post" action={ templ.SafeURL(c.base() + "/advanced") } class="grid gap-3" style="max-width:820px">
				<div>
					<label class="k-label">{ i18n.T(ctx, "app.command") }</label>
					<input class="k-input k-mono" name="command" placeholder="e.g. start-dev (blank = image default)" value={ strv(c.App.Command) }/>
					<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "app.command_hint") }</p>
				</div>
				<div>
					<label class="k-label">{ i18n.T(ctx, "app.replicas") }</label>
					<input class="k-input" name="replicas" type="number" min="1" value={ itoa(int64(c.App.Replicas)) }/>
				</div>
				<div class="grid grid-cols-2 gap-3">
					<div>
						<label class="k-label">{ i18n.T(ctx, "app.memory_limit") }</label>
						<input class="k-input" name="memory_limit" placeholder="e.g. 256m (blank = no limit)" value={ strv(c.App.MemoryLimit) }/>
					</div>
					<div>
						<label class="k-label">{ i18n.T(ctx, "app.cpu_limit") }</label>
						<input class="k-input" name="cpu_limit" placeholder="e.g. 0.5 (blank = no limit)" value={ strv(c.App.CpuLimit) }/>
					</div>
				</div>
				<div class="grid grid-cols-2 gap-3">
					<div>
						<label class="k-label">{ i18n.T(ctx, "app.restart_condition") }</label>
						<select class="k-select" name="restart_condition">
							<option value="any" selected?={ c.App.RestartCondition == "any" }>any</option>
							<option value="on-failure" selected?={ c.App.RestartCondition == "on-failure" }>on-failure</option>
							<option value="none" selected?={ c.App.RestartCondition == "none" }>none</option>
						</select>
					</div>
					<div>
						<label class="k-label">{ i18n.T(ctx, "app.restart_max_attempts") }</label>
						<input class="k-input" name="restart_max_attempts" type="number" min="0" value={ itoa(int64(c.App.RestartMaxAttempts)) }/>
					</div>
				</div>
				<div class="k-label" style="margin-top:.5rem;color:var(--color-fg)">{ i18n.T(ctx, "adv.healthcheck") }</div>
				<div>
					<label class="k-label">{ i18n.T(ctx, "app.healthcheck_cmd") }</label>
					<input class="k-input k-mono" name="healthcheck_cmd" placeholder="curl -f http://localhost/ || exit 1" value={ strv(c.App.HealthcheckCmd) }/>
				</div>
				<div class="grid grid-cols-4 gap-3">
					<div><label class="k-label">{ i18n.T(ctx, "app.healthcheck_interval") }</label><input class="k-input" name="healthcheck_interval" placeholder="30s" value={ strv(c.App.HealthcheckInterval) }/></div>
					<div><label class="k-label">{ i18n.T(ctx, "app.healthcheck_timeout") }</label><input class="k-input" name="healthcheck_timeout" placeholder="5s" value={ strv(c.App.HealthcheckTimeout) }/></div>
					<div><label class="k-label">{ i18n.T(ctx, "app.healthcheck_retries") }</label><input class="k-input" name="healthcheck_retries" type="number" min="0" placeholder="3" value={ i32v(c.App.HealthcheckRetries) }/></div>
					<div><label class="k-label">{ i18n.T(ctx, "app.healthcheck_start_period") }</label><input class="k-input" name="healthcheck_start_period" placeholder="10s" value={ strv(c.App.HealthcheckStartPeriod) }/></div>
				</div>
				<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "adv.apply_hint") }</p>
				<div class="flex justify-end"><button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "common.save") }</button></div>
			</form>
	</div>
	if c.App.SourceType == "dockerfile" && (c.Role == "owner" || c.Role == "admin") {
		<div class="k-card">
			<div class="mb-4"><div class="k-panel-title">{ i18n.T(ctx, "build.title") }</div></div>
			<form method="post" action={ templ.SafeURL(c.base() + "/build") } class="grid gap-3" style="max-width:820px">
				<div>
					<label class="k-label">{ i18n.T(ctx, "build.args") }</label>
					<textarea class="k-code" name="build_args" spellcheck="false" style="min-height:6rem" placeholder="VERSION=1.2">{ c.App.BuildArgs }</textarea>
					<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "build.args_hint") }</p>
				</div>
				<div>
					<label class="k-label">{ i18n.T(ctx, "build.secrets") }</label>
					<div class="flex items-start gap-2">
						<textarea id="build-secrets-ta" class="k-code flex-1" name="build_secrets" spellcheck="false" style="-webkit-text-security:disc;min-height:6rem">{ c.BuildSecretsPlain }</textarea>
						<button type="button" class="k-btn k-btn-secondary" aria-label={ i18n.T(ctx, "common.reveal") } onclick="(function(t){t.style.webkitTextSecurity=(t.style.webkitTextSecurity==='none'?'disc':'none')})(document.getElementById('build-secrets-ta'))">👁</button>
					</div>
					<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "build.secrets_hint") }</p>
				</div>
				<div class="flex justify-end"><button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "build.save") }</button></div>
			</form>
		</div>
	}
	if c.Role == "owner" || c.Role == "admin" {
		<div class="k-card">
			<div class="mb-4"><div class="k-panel-title">{ i18n.T(ctx, "placement.title") }</div><div class="k-panel-desc">{ i18n.T(ctx, "placement.desc") }</div></div>
			<form method="post" action={ templ.SafeURL(c.base() + "/placement") } class="grid gap-3" style="max-width:820px">
				<div>
					<label class="k-label">{ i18n.T(ctx, "placement.mode") }</label>
					<select class="k-select" name="placement_mode">
						<option value="any" selected?={ c.App.PlacementMode == "" || c.App.PlacementMode == "any" }>{ i18n.T(ctx, "placement.mode_any") }</option>
						<option value="pin" selected?={ c.App.PlacementMode == "pin" }>{ i18n.T(ctx, "placement.mode_pin") }</option>
						<option value="global" selected?={ c.App.PlacementMode == "global" }>{ i18n.T(ctx, "placement.mode_global") }</option>
					</select>
				</div>
				if len(c.Nodes) > 0 {
					<div>
						<label class="k-label">{ i18n.T(ctx, "placement.nodes") }</label>
						for _, n := range c.Nodes {
							<label class="k-label flex items-center gap-2" style="font-weight:normal">
								<input class="k-check" type="checkbox" name="placement_nodes" value={ n.ID } checked?={ placementHas(c.App.PlacementNodes, n.ID) }/>
								<span class="k-mono">{ nodeDisplay(c.NodeLabels, n.ID, n.Hostname) }</span> <span class="k-muted text-xs">{ n.Role }</span>
							</label>
						}
						for _, id := range orphanedPlacementNodes(c.App.PlacementNodes, c.Nodes) {
							<label class="k-label flex items-center gap-2" style="font-weight:normal">
								<input class="k-check" type="checkbox" checked disabled/>
								<span class="k-mono">{ id }</span> <span class="k-muted text-xs">{ i18n.T(ctx, "placement.node_removed") }</span>
							</label>
						}
					</div>
				} else {
					<p class="k-muted text-xs">{ i18n.T(ctx, "placement.no_nodes") }</p>
				}
				<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "placement.hint") }</p>
				<div><button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "placement.save") }</button></div>
			</form>
		</div>
	}
	@appPortsSection(c)
}

// appPortsSection renders the raw host-port publications (TCP/UDP, host mode),
// which bypass Traefik. Applied on the next deploy.
templ appPortsSection(c AppCtx) {
	<div class="k-card mt-4">
		<div class="k-panel-title">{ i18n.T(ctx, "ports.title") }</div>
		<div class="k-panel-desc">{ i18n.T(ctx, "ports.desc") }</div>
		<div class="k-toast mb-4 mt-2">{ i18n.T(ctx, "ports.applied_on_deploy") }</div>
		if len(c.Ports) == 0 {
			<p class="k-muted">{ i18n.T(ctx, "ports.empty") }</p>
		} else {
			<table class="k-table">
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "ports.host") }</th>
						<th>{ i18n.T(ctx, "ports.container") }</th>
						<th>{ i18n.T(ctx, "ports.protocol") }</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, p := range c.Ports {
						<tr>
							<td class="k-mono">{ itoa(int64(p.HostPort)) }</td>
							<td class="k-mono">{ itoa(int64(p.ContainerPort)) }</td>
							<td class="k-mono">{ p.Protocol }</td>
							<td>
								<form method="post" hx-boost="false" action={ templ.SafeURL(c.base() + "/ports/" + itoa(p.ID) + "/delete") } class="inline" data-confirm={ i18n.Tf(ctx, "confirm.delete_port", itoa(int64(p.HostPort))) } onsubmit="return krillConfirm(this, this.dataset.confirm)">
									<button type="submit" class="k-btn k-btn-danger">{ i18n.T(ctx, "ports.delete") }</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<form method="post" action={ templ.SafeURL(c.base() + "/ports") } class="mt-4 flex items-end gap-2 flex-wrap">
			<div>
				<label class="k-label">{ i18n.T(ctx, "ports.host") }</label>
				<input class="k-input k-mono" name="host_port" type="number" min="1" max="65535" placeholder="2222" required/>
			</div>
			<div>
				<label class="k-label">{ i18n.T(ctx, "ports.container") }</label>
				<input class="k-input k-mono" name="container_port" type="number" min="1" max="65535" placeholder="22" required/>
			</div>
			<div>
				<label class="k-label">{ i18n.T(ctx, "ports.protocol") }</label>
				<select class="k-input k-mono" name="protocol">
					<option value="tcp">tcp</option>
					<option value="udp">udp</option>
				</select>
			</div>
			<button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "ports.add") }</button>
		</form>
	</div>
}

templ volumesTab(c AppCtx) {
	<div class="k-card">
		<div class="k-panel-title">{ i18n.T(ctx, "volumes.settings_title") }</div>
		<div class="k-panel-desc">{ i18n.T(ctx, "volumes.settings_desc") }</div>
		<div class="k-toast mb-4 mt-2">{ i18n.T(ctx, "volumes.applied_on_deploy") }</div>
		if len(c.Volumes) == 0 {
			<p class="k-muted">{ i18n.T(ctx, "volumes.empty") }</p>
		} else {
			<table class="k-table">
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "volumes.name") }</th>
						<th>{ i18n.T(ctx, "volumes.mount_path") }</th>
						<th>{ i18n.T(ctx, "volumes.owner") }</th>
						<th>{ i18n.T(ctx, "volumes.docker_name") }</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, v := range c.Volumes {
						<tr>
							<td class="k-mono">{ v.Name }</td>
							<td class="k-mono">{ v.MountPath }</td>
							<td>
								<form method="post" hx-boost="false" action={ templ.SafeURL(c.base() + "/volumes/" + itoa(v.ID) + "/owner") } class="inline flex items-center gap-1">
									<input class="k-input k-mono w-24" name="owner" value={ ownerValue(v) } placeholder={ i18n.T(ctx, "volumes.owner_placeholder") }/>
									<button type="submit" class="k-btn">{ i18n.T(ctx, "volumes.owner_save") }</button>
								</form>
							</td>
							<td class="k-mono text-xs">{ docker.VolumeName(c.App.ID, v.Name) }</td>
							<td>
								<form method="post" hx-boost="false" action={ templ.SafeURL(c.base() + "/volumes/" + itoa(v.ID) + "/delete") } class="inline" data-confirm={ i18n.Tf(ctx, "confirm.delete_volume", v.Name) } onsubmit="return krillConfirm(this, this.dataset.confirm)">
									<button type="submit" class="k-btn k-btn-danger">{ i18n.T(ctx, "volumes.delete") }</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<form method="post" action={ templ.SafeURL(c.base() + "/volumes") } class="mt-4 flex items-end gap-2 flex-wrap">
			<div>
				<label class="k-label">{ i18n.T(ctx, "volumes.name") }</label>
				<input class="k-input k-mono" name="name" placeholder="data" required/>
			</div>
			<div>
				<label class="k-label">{ i18n.T(ctx, "volumes.mount_path") }</label>
				<input class="k-input k-mono" name="mount_path" placeholder="/data" required/>
			</div>
			<div>
				<label class="k-label">{ i18n.T(ctx, "volumes.owner") }</label>
				<input class="k-input k-mono" name="owner" placeholder={ i18n.T(ctx, "volumes.owner_placeholder") }/>
				<p class="k-muted text-xs mt-1">{ i18n.T(ctx, "volumes.owner_hint") }</p>
			</div>
			<button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "volumes.add") }</button>
		</form>
		for _, v := range c.Volumes {
			@volumeBackupsSection(c, v)
		}
	</div>
}

// volumeBackupsSection renders the per-volume S3 backup configuration block
// (mirrors backupsSection in database_detail.templ).
templ volumeBackupsSection(c AppCtx, v db.AppVolume) {
	<div class="mt-6 pt-4" style="border-top:1px solid var(--color-border)">
		<div class="k-label">{ i18n.T(ctx, "backup.section") } — { v.Name }</div>
		<p class="k-panel-desc k-muted">{ i18n.T(ctx, "volumes.backup.hot_caveat") }</p>
		if len(c.VolumeBackups[v.ID]) == 0 {
			<p class="k-muted">{ i18n.T(ctx, "backup.none") }</p>
		} else {
			<table class="k-table">
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "backup.destination") }</th>
						<th>{ i18n.T(ctx, "backup.schedule") }</th>
						<th>{ i18n.T(ctx, "backup.retention") }</th>
						<th>{ i18n.T(ctx, "backup.enabled") }</th>
						<th>{ i18n.T(ctx, "backup.last_run") }</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, b := range c.VolumeBackups[v.ID] {
						<tr>
							<td>{ destName(c.Destinations, b.DestinationID) }</td>
							<td>{ scheduleLabel(ctx, b.Schedule) }</td>
							<td>{ itoa(int64(b.Retention)) }</td>
							<td>
								if b.Enabled {
									<span class="k-badge k-badge-running"><span class="k-dot"></span>{ i18n.T(ctx, "backup.enabled") }</span>
								} else {
									<span class="k-badge k-badge-idle"><span class="k-dot"></span>—</span>
								}
							</td>
							<td>
								<div>{ tsStr(b.LastRunAt) } { b.LastStatus }</div>
								if b.LastError != "" {
									<div class="text-xs" style="color:var(--color-err)">{ b.LastError }</div>
								}
							</td>
							<td>
								<div class="flex items-center gap-2 flex-wrap">
									<form method="post" action={ templ.SafeURL(c.base() + "/volumes/backups/" + itoa(b.ID) + "/run") } data-busy={ i18n.T(ctx, "backup.running") } onsubmit="krillBusy(this.querySelector('button'), this.dataset.busy)" class="inline">
										<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "backup.run_now") }</button>
									</form>
									<form method="post" action={ templ.SafeURL(c.base() + "/volumes/backups/" + itoa(b.ID) + "/toggle") } class="inline">
										if b.Enabled {
											<button class="k-btn k-btn-secondary">{ i18n.T(ctx, "backup.pause") }</button>
										} else {
											<button class="k-btn k-btn-secondary">{ i18n.T(ctx, "backup.resume") }</button>
										}
									</form>
									<form method="post" hx-boost="false" action={ templ.SafeURL(c.base() + "/volumes/backups/" + itoa(b.ID) + "/delete") } data-confirm={ i18n.Tf(ctx, "confirm.delete_backup", destName(c.Destinations, b.DestinationID)) } onsubmit="return krillConfirm(this, this.dataset.confirm)" class="inline">
										<button class="k-btn k-btn-danger">{ i18n.T(ctx, "backup.delete") }</button>
									</form>
								</div>
							</td>
						</tr>
						<tr>
							<td colspan="6">
								<div class="k-label">{ i18n.T(ctx, "backup.objects") }</div>
								<div hx-get={ c.base() + "/volumes/backups/" + itoa(b.ID) + "/objects" } hx-trigger="load" hx-swap="innerHTML"></div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		if len(c.Destinations) == 0 {
			<p class="k-muted">{ i18n.T(ctx, "backup.no_destinations") }</p>
			@inlineDestinationForm(c.Org.ID, c.base() + "?tab=volumes")
		} else {
			<form method="post" action={ templ.SafeURL(c.base() + "/volumes/" + itoa(v.ID) + "/backups") } class="mt-4 flex flex-col gap-2">
				<div>
					<label class="k-label">{ i18n.T(ctx, "backup.destination") }</label>
					<select class="k-select" name="destination_id">
						for _, d := range c.Destinations {
							<option value={ itoa(d.ID) }>{ d.Name }</option>
						}
					</select>
				</div>
				@scheduleSelect()
				<div>
					<label class="k-label">{ i18n.T(ctx, "backup.retention") }</label>
					<input class="k-input" name="retention" type="number" value="7" min="1"/>
				</div>
				@backupAdvanced()
				<div><button class="k-btn k-btn-primary">{ i18n.T(ctx, "backup.add") }</button></div>
			</form>
		}
	</div>
}

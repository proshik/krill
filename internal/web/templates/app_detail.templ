package templates

import (
	"context"
	"strings"

	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/docker"
	"github.com/proshik/krill/internal/secret"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// RuntimeView is what the Advanced tab shows about how the app actually runs:
// the limits a deploy applies (its own or the instance default) and its
// recent Swarm tasks.
type RuntimeView struct {
	MemLimit, MemSource string // source: explicit | default | none
	CPULimit, CPUSource string
	MemDefault, CPUDefault string // the instance defaults ("" when none)
	Tasks               []docker.TaskRecord
	TasksUnavailable    bool
}

type AppCtx struct {
	Runtime    RuntimeView
	Org        db.Organization
	Role       string
	Project    db.Project
	Env        db.Environment
	App        db.Application
	Deps       []db.ListDeploymentSummariesByApplicationRow
	Domains    []db.Domain
	HostShares map[int64][]db.ListHostSharesByApplicationRow
	Volumes    []db.AppVolume
	Ports      []db.AppPort
	Registries []db.Registry
	Exposed    bool

	GitCredentials    []db.GitCredential
	BuildSecretsPlain string // decrypted build_secrets, set for admins only (never ciphertext)
	// BuildSecretsUnreadable marks stored build secrets that cannot be decrypted
	// (KRILL_SECRET_KEY missing or rotated). The editor is disabled in that case:
	// rendering it empty would invite an admin to save the blank field and
	// destroy values that are still recoverable by restoring the key.
	BuildSecretsUnreadable bool
	Tasks             []docker.TaskPlacement // running/desired tasks of this app's service + their nodes
	Nodes             []docker.SwarmNode     // cluster nodes (for the placement picker; admin only)
	NodeLabels        map[string]string      // swarm_node_id → display label (topology + placement); empty → hostname

	VolumeBackups map[int64][]db.VolumeBackup // app_volume_id → its backups
	Destinations  []db.Destination

	DBLinks       []DBLinkView
	Ldbs          []db.ListLogicalDatabasesByEnvironmentRow // logical DBs of this environment (pg link options)
	LinkInstances []db.DbInstance                           // non-postgres instances of this org — redis/dragonfly/minio link options

	BucketLinks []BucketLinkView
	EnvBuckets  []db.ListS3BucketsByEnvironmentRow // buckets of this environment (bucket link options)

	AutoDeploy    bool
	WebhookSecret string // decrypted; set for admins only
	WebhookURL    string // full external webhook/deploy-hook URL

	MetricsEnabled         bool
	MetricsTokenEnv        string
	MetricsToken           string // decrypted; set for admins only
	MetricsTokenUnreadable bool
	MetricsEndpoints       []db.AppMetricsEndpoint

	// The page around the sheet: the environment bar and its canvas.
	Shell  Shell
	Canvas CanvasView
	// Deployment is the deployment whose log the deployments tab shows, nil
	// for the tab's overview.
	Deployment *db.Deployment
	// NodeNames maps a Swarm node id to the name the canvas shows for it.
	NodeNames map[string]string
	// Running is the app's running replicas, read for the terminal tab; -1
	// when unknown (another tab, or Swarm did not answer).
	Running int
	// VolumeBlocks are the volumes' backup sections (settings tab).
	VolumeBlocks map[int64]BackupBlock
}

// DBLinkView is a linked DB row for the Environment tab. Collides is true when
// VarName is also present in env_text (the link overrides it on deploy).
// BucketLinkView is one bucket link on the app's Environment tab.
type BucketLinkView struct {
	ID       int64
	Bucket   string
	VarName  string
	Field    string
	Collides bool
}

type DBLinkView struct {
	ID       int64
	Engine   string
	DBName   string
	VarName  string
	Scheme   string
	Field    string
	Collides bool
}

func (c AppCtx) base() string {
	return "/orgs/" + itoa(c.Org.ID) + "/projects/" + itoa(c.Project.ID) +
		"/environments/" + itoa(c.Env.ID) + "/apps/" + itoa(c.App.ID)
}

func (c AppCtx) admin() bool { return isAdmin(c.Role) }

func (c AppCtx) envURL() string { return envURL(c.Org.ID, c.Project.ID, c.Env.ID) }

// appTabs are the sheet's tabs the viewer may open: variables and the
// terminal hold secrets or run commands, so they are for admins.
func (c AppCtx) appTabs(ctx context.Context) []OrgTab {
	tabs := []OrgTab{{"deployments", i18n.T(ctx, "tab.deployments"), c.base()}, {"logs", i18n.T(ctx, "tab.logs"), c.base() + "?tab=logs"}}
	if c.admin() {
		tabs = append(tabs, OrgTab{"variables", i18n.T(ctx, "tab.variables"), c.base() + "?tab=variables"})
	}
	tabs = append(tabs,
		OrgTab{"domains", i18n.T(ctx, "domains.tab"), c.base() + "?tab=domains"},
		OrgTab{"metrics", i18n.T(ctx, "tab.metrics"), c.base() + "?tab=metrics"},
		OrgTab{"settings", i18n.T(ctx, "tab.settings"), c.base() + "?tab=settings"},
	)
	if c.admin() {
		tabs = append(tabs, OrgTab{"terminal", i18n.T(ctx, "tab.terminal"), c.base() + "?tab=terminal"})
	}
	return tabs
}

// AppDetail is the app's sheet over its environment's canvas.
templ AppDetail(c AppCtx, tab string) {
	@Page(c.Shell) {
		@canvasView(c.Canvas)
		<aside class="sheet" aria-label={ c.App.Name }>
			<div class="sheet-head">
				<div class="sheet-title">
					@ui.Glyph("i-app")
					<h2>{ c.App.Name }</h2>
					@AppStateBadge(c.App.Status, c.base()+"/status", c.Running)
				</div>
				<a class="pill pill--icon" href={ templ.SafeURL(c.envURL()) } aria-label={ i18n.T(ctx, "common.close") } data-sheet-close>
					@ui.Icon("i-close")
				</a>
			</div>
			<p class="sheet-sub">
				if u := primaryPublicURL(c.Domains, c.Exposed); u != "" {
					<a href={ templ.SafeURL(u) } target="_blank" rel="noopener">
						@ui.Icon("i-link")
						{ trimScheme(u) }
					</a>
				} else if len(c.Domains) > 0 {
					<span class="run-meta">{ i18n.T(ctx, "app.internal_not_exposed") }</span>
				} else {
					<span class="run-meta">{ i18n.T(ctx, "app.internal_no_domain") }</span>
				}
				if c.App.SourceType == "dockerfile" {
					<code>{ trimScheme(c.App.GitUrl) + ", " + c.App.GitBranch }</code>
				} else {
					<code>{ c.App.Image + ":" + c.App.Tag }</code>
				}
			</p>
			<nav class="seg" aria-label={ c.App.Name }>
				for _, t := range c.appTabs(ctx) {
					<a href={ templ.SafeURL(t.Href) } { ariaCurrent(t.Key == tab, "page")... }>{ t.Label }</a>
				}
			</nav>
			switch tab {
				case "logs":
					@logsTab(c)
				case "variables":
					@variablesTab(c)
				case "domains":
					@domainsTab(c)
				case "metrics":
					@metricsTab(c)
				case "settings":
					@settingsTab(c)
				case "terminal":
					@terminalTab(c)
				default:
					if c.Deployment != nil {
						@deploymentLog(c, *c.Deployment)
					} else {
						@deploymentsTab(c)
					}
			}
		</aside>
	}
}

// AppStateBadge is the app's live state in the sheet head; it refreshes itself.
// running (-1 when unknown) lets the terminal tab follow its replicas: see
// krillTermState in app.js.
templ AppStateBadge(status, pollURL string, running int) {
	{{ kind, text := AppState(ctx, status) }}
	<span class={ "state", "state--" + kind } id="app-state" hx-get={ pollURL } hx-trigger="every 3s" hx-swap="outerHTML" data-running={ itoa(int64(running)) }>
		@ui.Sig(kind)
		{ text }
	</span>
}

templ deploymentsTab(c AppCtx) {
	<section class="runs" aria-labelledby="runs-h">
		<h3 id="runs-h">{ i18n.T(ctx, "app.runs_on") }</h3>
		if len(c.Tasks) == 0 {
			<p class="empty">{ i18n.T(ctx, "app.no_replicas") }</p>
		} else {
			<div class="runs-list">
				for _, t := range c.Tasks {
					<div class="run">
						<span class="run-node">
							if n := c.NodeNames[t.NodeID]; n != "" {
								{ n }
							} else if t.NodeName != "" {
								{ nodeDisplay(c.NodeLabels, t.NodeID, t.NodeName) }
							} else {
								{ i18n.T(ctx, "app.not_placed") }
							}
						</span>
						if t.Desired != "" && taskLabel(ctx, t.Desired) != taskLabel(ctx, t.State) {
							<span class="run-meta">{ "→ " + taskLabel(ctx, t.Desired) }</span>
						} else {
							<span class="run-meta"></span>
						}
						@ui.State(taskKind(t.State), taskLabel(ctx, t.State))
					</div>
				}
			</div>
		}
		<p class="hint">{ placementText(ctx, c) }</p>
	</section>
	// The app's action forms stay outside the polled part: a refresh must not
	// replace a form whose confirmation is open. The buttons in the polled
	// part reach them through form=.
	<form id="deploy-again" method="post" action={ templ.SafeURL(c.base() + "/deploy") }></form>
	<form id="reload-form" method="post" action={ templ.SafeURL(c.base() + "/reload") }></form>
	<form id="rebuild-form" method="post" action={ templ.SafeURL(c.base() + "/rebuild") }></form>
	<form id="stop-form" method="post" hx-boost="false" action={ templ.SafeURL(c.base() + "/stop") } data-confirm={ i18n.Tf(ctx, "confirm.stop_app", c.App.Name) } data-more={ i18n.T(ctx, "app.stop_more") } data-ok={ i18n.T(ctx, "common.stop") } onsubmit="return krillConfirm(this)"></form>
	// innerHTML: the polling element itself stays, so it keeps polling.
	<div hx-get={ c.base() + "/deployments-list" } hx-trigger="every 3s" hx-swap="innerHTML">
		@DeploymentsList(c, c.Deps)
	</div>
}

// DeploymentsList is the polled part of the deployments tab: a failed
// deploy, the active one with the app's controls, and the history.
templ DeploymentsList(c AppCtx, deps []db.ListDeploymentSummariesByApplicationRow) {
	<div id="deployments-list">
		{{ running, failed, active, rest := splitDeployments(c.App.Status, deps) }}
		if running != nil {
			<section class="deploy" aria-label={ i18n.T(ctx, "deploy.running") }>
				<div class="deploy-top">
					<span class="tag">{ i18n.T(ctx, "deploy.running") }</span>
					<code title={ running.ImageTag }>{ shortImageRef(running.ImageTag) }</code>
					<span class="when">{ deployWhen(ctx, *running) }</span>
				</div>
				<p class="deploy-msg">{ i18n.T(ctx, "deploy.in_progress") }</p>
				<div class="deploy-keys">
					<a class="pill" href={ templ.SafeURL(c.base() + "/deployments/" + itoa(running.ID)) }>{ i18n.T(ctx, "deploy.view_log") }</a>
				</div>
			</section>
		}
		if failed != nil {
			<section class="deploy deploy--failed" aria-label={ i18n.T(ctx, "deploy.failed") }>
				<div class="deploy-top">
					<span class="tag tag--failed">{ i18n.T(ctx, "deploy.failed") }</span>
					<code title={ failed.ImageTag }>{ shortImageRef(failed.ImageTag) }</code>
					<span class="when">{ deployWhen(ctx, *failed) }</span>
				</div>
				if failed.ErrorMessage != "" {
					<p class="deploy-msg deploy-msg--err">{ failed.ErrorMessage }</p>
				}
				<div class="deploy-keys">
					<a class="pill" href={ templ.SafeURL(c.base() + "/deployments/" + itoa(failed.ID)) }>{ i18n.T(ctx, "deploy.view_log") }</a>
					if c.admin() {
						<button type="submit" form="deploy-again" class="pill">{ i18n.T(ctx, "app.deploy_again") }</button>
					}
				</div>
			</section>
		}
		<section class="deploy deploy--active" aria-label={ i18n.T(ctx, "deploy.active") }>
			<div class="deploy-top">
				if c.App.Status == "idle" && active != nil {
					<span class="tag">{ i18n.T(ctx, "state.stopped") }</span>
				} else if active != nil {
					<span class="tag tag--active">{ deployTagLabel(ctx, active.Status) }</span>
				} else {
					<span class="tag">{ i18n.T(ctx, "deploy.never") }</span>
				}
				if active != nil {
					<code title={ active.ImageTag }>{ shortImageRef(active.ImageTag) }</code>
					<span class="when">{ deployWhen(ctx, *active) }</span>
				}
			</div>
			if active != nil && active.Status == "running" {
				<p class="deploy-msg">{ i18n.T(ctx, "deploy.in_progress") }</p>
			}
			<div class="deploy-keys">
				if active != nil {
					// No rollback here: this is the release that runs now. Older
					// eligible releases in the history below keep theirs.
					<a class="pill" href={ templ.SafeURL(c.base() + "/deployments/" + itoa(active.ID)) }>{ i18n.T(ctx, "deploy.view_log") }</a>
				}
				if active != nil {
					<a class="pill" href={ templ.SafeURL(c.base() + "?tab=logs") }>{ i18n.T(ctx, "app.view_logs") }</a>
				}
				if c.admin() {
					if c.App.Status == "idle" || c.App.Status == "not_deployed" {
						if c.App.Status == "not_deployed" {
							<button type="submit" form="deploy-again" class="pill" title={ i18n.T(ctx, "app.deploy_hint") }>{ i18n.T(ctx, "app.deploy_first") }</button>
						} else {
							<button type="submit" form="deploy-again" class="pill" title={ i18n.T(ctx, "app.deploy_hint") }>{ i18n.T(ctx, "app.start") }</button>
						}
						if c.App.SourceType == "dockerfile" {
							<button type="submit" form="rebuild-form" class="pill" title={ i18n.T(ctx, "app.rebuild_hint") }>{ i18n.T(ctx, "app.rebuild") }</button>
						}
					} else {
						<button type="submit" form="reload-form" class="pill" title={ i18n.T(ctx, "app.reload_hint") }>{ i18n.T(ctx, "app.reload") }</button>
						<button type="submit" form="deploy-again" class="pill" title={ i18n.T(ctx, "app.deploy_hint") }>{ i18n.T(ctx, "app.deploy_again") }</button>
						if c.App.SourceType == "dockerfile" {
							<button type="submit" form="rebuild-form" class="pill" title={ i18n.T(ctx, "app.rebuild_hint") }>{ i18n.T(ctx, "app.rebuild") }</button>
						}
						<button type="submit" form="stop-form" class="pill pill--danger" title={ i18n.T(ctx, "app.stop_hint") }>{ i18n.T(ctx, "app.stop") }</button>
					}
				}
			</div>
		</section>
		if len(rest) > 0 {
			<h3 class="list-head">{ i18n.T(ctx, "deploy.history") }</h3>
			<ol class="history">
				for _, dp := range rest {
					<li class="deploy">
						<div class="deploy-top">
							<span class={ "tag", templ.KV("tag--failed", dp.Status == "error"), templ.KV("tag--removed", dp.Status == "done") }>{ historyTagLabel(ctx, dp.Status) }</span>
							<code title={ dp.ImageTag }>{ shortImageRef(dp.ImageTag) }</code>
							<span class="when">{ deployWhen(ctx, dp) }</span>
							if dp.RollbackSourceID != nil {
								<span class="run-meta">{ i18n.Tf(ctx, "deploy.rollback_source", *dp.RollbackSourceID) }</span>
							}
						</div>
						if dp.ErrorMessage != "" {
							<p class="deploy-msg deploy-msg--err">{ dp.ErrorMessage }</p>
						}
						<div class="deploy-keys">
							<a class="pill pill--small" href={ templ.SafeURL(c.base() + "/deployments/" + itoa(dp.ID)) }>{ i18n.T(ctx, "deploy.view_log") }</a>
							if dp.RollbackEligible && secret.Enabled() && c.admin() {
								<form method="post" action={ templ.SafeURL(c.base() + "/deployments/" + itoa(dp.ID) + "/rollback") } hx-boost="false" data-confirm={ i18n.T(ctx, "confirm.rollback_app") } data-ok={ i18n.T(ctx, "deploy.rollback") } data-kind="primary" onsubmit="return krillConfirm(this)">
									<button type="submit" class="pill pill--small">{ i18n.T(ctx, "deploy.rollback") }</button>
								</form>
							}
						</div>
					</li>
				}
			</ol>
		}
		if len(deps) > 0 {
			<p class="hint">{ i18n.T(ctx, "deploy.rollback_hint") }</p>
			if !secret.Enabled() {
				<p class="hint">{ i18n.T(ctx, "deploy.rollback_key_required") }</p>
			}
		}
	</div>
}

templ deploymentLog(c AppCtx, dep db.Deployment) {
	<section class="sec" aria-labelledby="dlog-h">
		<div class="sec-head">
			<h3 id="dlog-h">{ i18n.Tf(ctx, "deploy.log_title", dep.ID) }</h3>
			<a class="pill" href={ templ.SafeURL(c.base()) }>{ i18n.T(ctx, "deploy.back") }</a>
		</div>
		<div class="deploy-top">
			{{ kind, text := deployState(ctx, dep.Status) }}
			@ui.State(kind, text)
			<code>{ dep.ImageTag }</code>
			<span class="when">{ dep.StartedAt.Local().Format("2006-01-02 15:04:05") + ", " + dep.Trigger }</span>
		</div>
		<div
			class="term"
			data-term-log={ c.base() + "/deployments/" + itoa(dep.ID) + "/logs" }
			data-i18n-closed={ i18n.T(ctx, "term.log_closed") }
			data-i18n-empty={ i18n.T(ctx, "term.log_empty") }
			data-i18n-error={ i18n.T(ctx, "term.log_error") }
		></div>
		<script src="/static/xterm.js"></script>
		<script src="/static/addon-fit.js"></script>
	</section>
}

templ logsTab(c AppCtx) {
	@logViewer(c.base() + "/logs")
}

// logViewer is the structured log viewer bound to a log WebSocket.
templ logViewer(wsPath string) {
	<section class="sec" data-logs={ wsPath } data-empty={ i18n.T(ctx, "log.empty") } data-error={ i18n.T(ctx, "log.error") } aria-labelledby="lg-h">
		<div class="sec-head">
			<h3 id="lg-h">{ i18n.T(ctx, "log.runtime") }</h3>
			<div class="sec-keys" role="group" aria-label={ i18n.T(ctx, "log.level") }>
				<button type="button" class="chip chip--level" data-level="all" aria-pressed="true">{ i18n.T(ctx, "log.all") }</button>
				<button type="button" class="chip chip--level" data-level="debug" aria-pressed="false">debug</button>
				<button type="button" class="chip chip--level" data-level="info" aria-pressed="false">info</button>
				<button type="button" class="chip chip--level" data-level="warn" aria-pressed="false">warn</button>
				<button type="button" class="chip chip--level" data-level="error" aria-pressed="false">error</button>
			</div>
		</div>
		<label class="visually-hidden" for={ "lgq-" + logID(wsPath) }>{ i18n.T(ctx, "log.search") }</label>
		<input class="input" data-logs-search id={ "lgq-" + logID(wsPath) } type="search" placeholder={ i18n.T(ctx, "log.search") } autocomplete="off"/>
		<ol class="logs" data-logs-body aria-live="off"></ol>
	</section>
}

templ terminalTab(c AppCtx) {
	<section class="sec" aria-labelledby="term-h">
		<div class="sec-head"><h3 id="term-h">{ i18n.T(ctx, "tab.terminal") }</h3></div>
		<p class="hint">{ i18n.T(ctx, "term.hint") }</p>
		{{ noReplica := c.Running == 0 || (c.Running < 0 && (c.App.Status == "idle" || c.App.Status == "not_deployed")) }}
		<p class="callout" id="term-noreplica" hidden?={ !noReplica }>{ i18n.T(ctx, "term.no_replica") }</p>
		<div class="add-row">
			<div class="field">
				<label for="term-cmd">{ i18n.T(ctx, "term.command") }</label>
				<input id="term-cmd" class="input input--mono" value="/bin/sh" autocomplete="off" spellcheck="false"/>
			</div>
			<button type="button" class="pill" id="term-connect" onclick="krillExecConnect()" disabled?={ noReplica }>
				@ui.Icon("i-term")
				{ i18n.T(ctx, "term.connect") }
			</button>
		</div>
		<p id="term-status" class="hint" aria-live="polite"></p>
		<div
			class="term"
			data-term-ws={ c.base() + "/terminal/ws" }
			data-i18n-connecting={ i18n.T(ctx, "term.connecting") }
			data-i18n-ended={ i18n.T(ctx, "term.ended") }
			data-i18n-error={ i18n.T(ctx, "term.conn_error") }
		></div>
		<script src="/static/xterm.js"></script>
		<script src="/static/addon-fit.js"></script>
	</section>
}

// siblingURL is the page of another app of the same environment.
func (c AppCtx) siblingURL(appID int64) string {
	return "/orgs/" + itoa(c.Org.ID) + "/projects/" + itoa(c.Project.ID) +
		"/environments/" + itoa(c.Env.ID) + "/apps/" + itoa(appID)
}

func shareNames(rows []db.ListHostSharesByApplicationRow) string {
	names := make([]string, 0, len(rows))
	for _, r := range rows {
		names = append(names, r.AppName)
	}
	return strings.Join(names, ", ")
}

// primaryURL is where a redirecting domain sends requests: scheme://host of
// the app's primary domain (the same target traefik.AppLabels builds).
func primaryURL(domains []db.Domain) string {
	for _, d := range domains {
		if d.IsPrimary {
			if d.Tls {
				return "https://" + d.Host
			}
			return "http://" + d.Host
		}
	}
	return ""
}

templ TagOptions(tags []string, current string) {
	<select class="input input--mono" id="s-tag" name="tag">
		for _, t := range tags {
			<option value={ t } selected?={ t == current }>{ t }</option>
		}
	</select>
}

templ TagError(current, msg string) {
	<input class="input input--mono" id="s-tag" name="tag" value={ current }/>
	<p class="field-err">{ msg }</p>
}

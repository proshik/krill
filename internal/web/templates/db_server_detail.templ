package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/dbservice/drivers"
	"github.com/proshik/krill/internal/docker"
	"github.com/proshik/krill/internal/web/i18n"
)

type DBServerCtx struct {
	Org   db.Organization
	Role  string
	Inst  db.DbInstance
	DBs   []db.ListLogicalDatabasesByInstanceRow
	Nodes []docker.SwarmNode
	Conn  []drivers.ConnField // admin-only; the engine driver's connection panel (endpoint/creds)
	Base  string
	Host  string // control-plane host, for the external-access "host:port" line
}

templ DBServerDetail(c DBServerCtx) {
	@Layout(c.Inst.Name, c.Org, c.Role) {
		<p class="k-crumbs mb-3">
			<a href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID) + "/db-servers") }>{ i18n.T(ctx, "dbi.title") }</a> / { c.Inst.Name }
		</p>
		<div class="k-frame"><div class="k-panel">
			<div class="k-panel-head">
				<div><div class="k-panel-title">{ c.Inst.Name }</div><div class="k-panel-desc k-mono">{ c.Inst.Image }</div></div>
				<span hx-get={ c.Base + "/status" } hx-trigger="every 2s" hx-target="this" hx-swap="outerHTML">@StatusBadge(c.Inst.Status)</span>
			</div>
			<div class="k-panel-body flex flex-col gap-4">
				if c.Role == "owner" || c.Role == "admin" {
					<div class="flex gap-2 flex-wrap">
						<form method="post" action={ templ.SafeURL(c.Base + "/deploy") } onsubmit="krillBusy(this.querySelector('button'), 'Deploying…')"><button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "db.deploy") }</button></form>
						<form method="post" action={ templ.SafeURL(c.Base + "/start") }><button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "db.start") }</button></form>
						<form method="post" action={ templ.SafeURL(c.Base + "/stop") }><button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "db.stop") }</button></form>
						<form method="post" hx-boost="false" action={ templ.SafeURL(c.Base + "/delete") } data-confirm={ i18n.Tf(ctx, "confirm.delete_dbi", c.Inst.Name) } onsubmit="return krillConfirm(this, this.dataset.confirm)" class="flex items-center gap-2">
							<button class="k-btn k-btn-danger">{ i18n.T(ctx, "db.delete") }</button>
							<label class="k-label"><input class="k-check" type="checkbox" name="delete_databases"/> { i18n.T(ctx, "dbi.delete_databases") }</label>
							<label class="k-label"><input class="k-check" type="checkbox" name="destroy_data"/> { i18n.T(ctx, "db.delete.destroyData") }</label>
						</form>
					</div>
					<form method="post" action={ templ.SafeURL(c.Base + "/version") } class="flex items-end gap-2">
						<div class="flex-1">
							<label class="k-label">{ i18n.T(ctx, "db.change_version") }</label>
							<input class="k-input" name="image" value={ c.Inst.Image }/>
							<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "dbi.version_warning") }</p>
						</div>
						<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "db.deploy") }</button>
					</form>
					if len(c.Nodes) > 0 {
						<form method="post" hx-boost="false" action={ templ.SafeURL(c.Base + "/node") } data-confirm={ i18n.Tf(ctx, "confirm.migrate_dbi", c.Inst.Name) } onsubmit="return krillConfirm(this, this.dataset.confirm)" class="flex items-end gap-2 flex-wrap">
							<div class="flex-1">
								<label class="k-label">{ i18n.T(ctx, "dbnode.label") }</label>
								<select class="k-select" name="node_hostname">
									<option value="" selected?={ c.Inst.NodeHostname == "" }>{ i18n.T(ctx, "dbnode.manager") }</option>
									for _, n := range c.Nodes {
										if !n.Leader {
											<option value={ n.Hostname } selected?={ c.Inst.NodeHostname == n.Hostname }>{ n.Hostname }</option>
										}
									}
									if c.Inst.NodeHostname != "" && !hostnameInNodes(c.Nodes, c.Inst.NodeHostname) {
										<option value={ c.Inst.NodeHostname } selected>{ c.Inst.NodeHostname } — { i18n.T(ctx, "dbnode.removed") }</option>
									}
								</select>
								<p class="k-mono text-xs" style="color:var(--color-faint)">{ i18n.T(ctx, "dbnode.hint") }</p>
							</div>
							<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "dbnode.migrate") }</button>
							<label class="k-label" style="flex-basis:100%"><input class="k-check" type="checkbox" name="delete_source"/> { i18n.T(ctx, "dbnode.delete_source") }</label>
						</form>
					}
					<div class="mt-4">
						<label class="k-label">{ i18n.T(ctx, "dbinst.external.title") }</label>
						<form method="post" hx-boost="false" action={ templ.SafeURL(c.Base + "/external-port") } class="flex items-end gap-2 flex-wrap">
							<div>
								<input class="k-input k-mono w-32" name="external_port" type="number" min="1" max="65535"
									value={ i32v(c.Inst.ExternalPort) } placeholder="5433"/>
							</div>
							<button type="submit" class="k-btn k-btn-secondary">{ i18n.T(ctx, "dbinst.external.save") }</button>
							<p class="k-muted text-xs mt-1" style="flex-basis:100%">{ i18n.T(ctx, "dbinst.external.hint") }</p>
						</form>
						if c.Inst.ExternalPort != nil {
							<p class="k-muted text-xs mt-1 k-mono">{ c.Host }:{ itoa(int64(*c.Inst.ExternalPort)) }</p>
						}
					</div>
					for _, f := range c.Conn {
						<div>
							<div class="k-label">{ i18n.T(ctx, f.Label) }</div>
							if f.Secret {
								<div class="flex items-center gap-2">
									<input class="k-input k-mono" type="password" readonly value={ f.Value }/>
									<button type="button" class="k-copy" onclick="krillReveal(this)" aria-label={ i18n.T(ctx, "common.reveal") }>👁</button>
									<button type="button" class="k-copy" data-copy={ f.Value } onclick="krillCopyToClip(this.dataset.copy, 'Connection string')">{ i18n.T(ctx, "common.copy") }</button>
								</div>
							} else {
								<div class="flex items-center gap-2">
									<input class="k-input k-mono" readonly value={ f.Value }/>
									<button type="button" class="k-copy" data-copy={ f.Value } onclick="krillCopyToClip(this.dataset.copy, 'Connection string')">{ i18n.T(ctx, "common.copy") }</button>
								</div>
							}
						</div>
					}
				}
				if c.Inst.Engine == "postgres" {
					<div>
						<div class="k-label">{ i18n.T(ctx, "dbi.databases") }</div>
						if len(c.DBs) == 0 {
							<p class="k-muted">{ i18n.T(ctx, "dbi.no_databases") }</p>
						} else {
							<table class="k-table">
								<thead><tr><th>{ i18n.T(ctx, "dbi.db_name") }</th><th>{ i18n.T(ctx, "dbi.db_project") }</th><th>{ i18n.T(ctx, "dbi.db_env") }</th></tr></thead>
								<tbody>
									for _, d := range c.DBs {
										<tr>
											<td><a class="underline" href={ templ.SafeURL("/orgs/" + itoa(c.Org.ID) + "/projects/" + itoa(d.ProjectID) + "/environments/" + itoa(d.EnvironmentID) + "/databases/" + itoa(d.ID)) }>{ d.Name }</a> <span class="k-mono text-xs">({ d.DbName })</span></td>
											<td>{ d.ProjectName }</td>
											<td>{ d.EnvName }</td>
										</tr>
									}
								</tbody>
							</table>
						}
					</div>
				}
				<div>
					<div class="k-label">{ i18n.T(ctx, "common.logs") }</div>
					@logViewer(c.Base + "/logs")
				</div>
			</div>
		</div></div>
	}
}

package templates

import db "github.com/proshik/krill/internal/database/gen"

templ Apps(apps []db.Application) {
	@Layout("Приложения") {
		<div style="display:flex; justify-content:space-between; align-items:center;">
			<h2>Приложения</h2>
			<a href="/apps/new"><button>+ Создать</button></a>
		</div>
		<div class="card">
			if len(apps) == 0 {
				<p>Пока нет приложений. Создай первое.</p>
			} else {
				<table>
					<thead><tr><th>Имя</th><th>Образ</th><th>Домен</th><th>Статус</th></tr></thead>
					<tbody>
						for _, a := range apps {
							<tr>
								<td><a href={ templ.SafeURL("/apps/" + itoa(a.ID)) }>{ a.Name }</a></td>
								<td>{ a.Image }:{ a.Tag }</td>
								<td>{ a.Domain }</td>
								<td>@StatusBadge(a.Status)</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	}
}

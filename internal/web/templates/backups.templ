package templates

import (
	"github.com/proshik/krill/internal/backup"
	"github.com/proshik/krill/internal/web/i18n"
)

// BackupObjects lists a database backup schedule's stored backups. base is
// the logical database's URL; backupID scopes the restore/download actions.
templ BackupObjects(base string, backupID int64, objs []backup.Object) {
	@backupObjectList(objs, base+"/backups/"+itoa(backupID)+"/download", base+"/backups/"+itoa(backupID)+"/restore", i18n.T(ctx, "backup.restore_warn"))
}

// VolumeBackupObjects lists a volume backup schedule's stored backups. base is
// the app's URL; vbID scopes the restore/download actions.
templ VolumeBackupObjects(base string, vbID int64, objs []backup.Object) {
	@backupObjectList(objs, base+"/volumes/backups/"+itoa(vbID)+"/download", base+"/volumes/backups/"+itoa(vbID)+"/restore", i18n.T(ctx, "volumes.backup.restore_warn"))
}

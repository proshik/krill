package templates

import (
	"strconv"
	"strings"
	"time"

	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// ControlPlaneFirewall is the control plane's live firewall state. It has no
// cluster_nodes row, so the state is read from the host on every render.
type ControlPlaneFirewall struct {
	Available bool // false: no runner wired, or the state could not be read (e.g. no nft)
	Locked    bool // the lockdown table is present
	Pending   bool // applied but not yet confirmed: the dead-man switch will revert it
}

// FirewallNode is one node's firewall as read from the host on this render.
type FirewallNode struct {
	Name         string
	ControlPlane bool
	Managed      bool // worker: Krill recorded a confirmed lockdown
	// State: open, locked, pending, missing (managed or persisted, but no table
	// loaded), nft_missing, unavailable (the node could not be read).
	State          string
	Drift          []string // i18n keys of the differences found
	Iface          string   // interface holding the swarm address ("" unknown)
	MTU            int
	WireGuard      bool
	WireGuardPorts []int
	LastOK         time.Time // last successful read (now, when this one succeeded)
}

// OverlayMTU is the overlay MTU diagnosis on the Firewall page.
type OverlayMTU struct {
	Configured   int // KRILL_OVERLAY_MTU; 0 = Docker default
	Effective    int // what new networks get
	MinIface     int // smallest swarm-interface MTU found (0 = none read)
	MinIfaceNode string
	MinIfaceName string
	Recommended  int  // MinIface minus VXLAN overhead (0 = unknown)
	TooLarge     bool // Effective exceeds Recommended
	Available    bool // the engine reported network MTUs
	Networks     []NetworkMTU
}

// NetworkMTU is one existing Krill overlay network.
type NetworkMTU struct {
	Name     string
	MTU      int
	Differs  bool // differs from what a new network would get
	TooLarge bool // exceeds the recommended MTU
}

func firewallNet(n FirewallNode) string {
	if n.Iface == "" {
		return "—"
	}
	parts := []string{n.Iface}
	if n.MTU > 0 {
		parts = append(parts, "MTU "+strconv.Itoa(n.MTU))
	}
	if n.WireGuard {
		parts = append(parts, "WireGuard")
	}
	for _, p := range n.WireGuardPorts {
		parts = append(parts, "udp/"+strconv.Itoa(p))
	}
	return strings.Join(parts, ", ")
}

func firewallState(state string) string {
	switch state {
	case "locked":
		return "ok"
	case "pending":
		return "warn"
	case "missing":
		return "err"
	}
	return "idle"
}

templ firewallBadge(state string) {
	switch state {
		case "locked", "pending", "missing", "nft_missing", "unavailable":
			@ui.State(firewallState(state), i18n.T(ctx, "firewall."+state))
		default:
			@ui.State("idle", i18n.T(ctx, "firewall.open"))
	}
}

// Firewall renders the cluster-firewall page: the control plane's live state,
// the worker nodes with their firewall_managed state, and the lockdown, open
// and confirm actions.
templ Firewall(org db.Organization, role string, nodes []FirewallNode, cp ControlPlaneFirewall, mtu OverlayMTU) {
	@SettingsPage(org, role, "firewall", i18n.T(ctx, "firewall.title")) {
		if cp.Pending && isAdmin(role) {
			<div class="callout callout--warn">
				<div class="callout-body">
					@ui.State("warn", i18n.T(ctx, "firewall.cp_pending_title"))
					<p class="hint">{ i18n.T(ctx, "firewall.cp_pending_desc") }</p>
					<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/firewall/confirm") }>
						<button type="submit" class="btn btn--primary">{ i18n.T(ctx, "firewall.cp_confirm") }</button>
					</form>
				</div>
			</div>
		}
		<section class="sec" aria-labelledby="fw-h">
			<div class="sec-head"><h3 id="fw-h">{ i18n.T(ctx, "nodes.title") }</h3></div>
			<p class="hint">{ i18n.T(ctx, "firewall.desc") }</p>
			<ul class="fw">
				for _, n := range nodes {
					<li class="fw-node">
						<a class="run-node" href={ templ.SafeURL(orgURL(org.ID) + "/nodes#node-" + n.Name) }>{ n.Name }</a>
						@firewallBadge(n.State)
						<span class="run-meta">{ firewallNet(n) }</span>
						for _, d := range n.Drift {
							<p class="fw-note">
								@ui.State("warn", i18n.T(ctx, "firewall.attention"))
								<span>{ i18n.T(ctx, d) }</span>
							</p>
						}
						if n.State == "unavailable" {
							<p class="fw-note">
								if n.LastOK.IsZero() {
									{ i18n.T(ctx, "firewall.never_checked") }
								} else {
									{ i18n.Tf(ctx, "firewall.last_ok", n.LastOK.Local().Format("2006-01-02 15:04")) }
								}
							</p>
						}
					</li>
				}
			</ul>
			if isAdmin(role) {
				{{ noNft := fwNoNft(nodes) }}
				if len(noNft) > 0 {
					<p class="hint">{ i18n.Tf(ctx, "firewall.nft_missing_on", strings.Join(noNft, ", ")) }</p>
				}
				<div class="sec-add">
					<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/firewall/lockdown") } data-confirm={ i18n.T(ctx, "firewall.confirm.lockdown") } data-more={ i18n.T(ctx, "firewall.lockdown_more") } data-ok={ i18n.T(ctx, "firewall.lockdown") } data-kind="primary" onsubmit="return krillConfirm(this)">
						<button type="submit" class="pill" disabled?={ fwControlPlaneNoNft(nodes) }>{ i18n.T(ctx, "firewall.lockdown") }</button>
					</form>
					<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/firewall/open") } data-confirm={ i18n.T(ctx, "firewall.confirm.open") } data-more={ i18n.T(ctx, "firewall.open_more") } data-ok={ i18n.T(ctx, "firewall.open_action") } onsubmit="return krillConfirm(this)">
						<button type="submit" class="pill pill--danger">{ i18n.T(ctx, "firewall.open_action") }</button>
					</form>
				</div>
				<p class="hint">{ i18n.T(ctx, "firewall.revert_hint") }</p>
			}
		</section>
		<section class="sec" aria-labelledby="mtu-h">
			<h3 id="mtu-h">{ i18n.T(ctx, "mtu.title") }</h3>
			<p class="hint">{ i18n.T(ctx, "mtu.desc") }</p>
			<dl class="facts">
				<div>
					<dt>{ i18n.T(ctx, "mtu.configured") }</dt>
					<dd>
						if mtu.Configured == 0 {
							{ i18n.Tf(ctx, "mtu.default", mtu.Effective) }
						} else {
							{ strconv.Itoa(mtu.Configured) }
						}
					</dd>
				</div>
				<div>
					<dt>{ i18n.T(ctx, "mtu.smallest_iface") }</dt>
					<dd>
						if mtu.MinIface == 0 {
							{ "—" }
						} else {
							{ strconv.Itoa(mtu.MinIface) + " (" + mtu.MinIfaceNode + ", " + mtu.MinIfaceName + ")" }
						}
					</dd>
				</div>
				<div>
					<dt>{ i18n.T(ctx, "mtu.recommended") }</dt>
					<dd>
						if mtu.Recommended == 0 {
							{ "—" }
						} else {
							{ strconv.Itoa(mtu.Recommended) }
						}
					</dd>
				</div>
			</dl>
			if mtu.TooLarge {
				<div class="callout callout--warn"><p>{ i18n.Tf(ctx, "mtu.too_large", mtu.Effective, mtu.MinIfaceName, mtu.MinIfaceNode, mtu.MinIface, mtu.Recommended) }</p></div>
			}
			if mtu.Available && len(mtu.Networks) > 0 {
				<ul class="links">
					for _, n := range mtu.Networks {
						<li class="row-item">
							<code class="link-var">{ n.Name }</code>
							<span class="link-src">{ "MTU " + strconv.Itoa(n.MTU) }</span>
							if n.TooLarge {
								@ui.State("warn", i18n.T(ctx, "mtu.net_too_large"))
							} else if n.Differs {
								@ui.State("idle", i18n.T(ctx, "mtu.net_differs"))
							} else {
								<span></span>
							}
						</li>
					}
				</ul>
			}
		</section>
	}
}

package templates

import (
	"net/url"
	"time"

	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// UpdatesView is the state of Krill's self-update, as the Updates page shows it.
type UpdatesView struct {
	Wired          bool
	Current        string
	IsRelease      bool   // Current is a release build; only a release is offered updates
	Latest         string // "" when never discovered
	LatestURL      string
	CheckedAt      time.Time // zero when never checked
	CheckErr       string    // last check error text, "" when none
	Available      bool      // Latest is newer than Current
	Supported      bool
	UnsupportedKey string // "update.unsupported.<code>"
	BusyKey        string // "update.busy.<reason>" when busy, else ""
	StateLine      string // "update.state.<on|off|paused>": is Krill's state backed up first
	Phase          string // installer status phase
	PhaseActive    bool
	JobTag         string
	JobErr         string // the whole failure sentence, already translated
	Previous       string // version of krill.prev, "" when none
	HasLast        bool
	LastFrom       string
	LastTo         string
	LastReason     string
	LastOK         bool
}

// blocked reports whether installing or rolling back is refused right now.
func (v UpdatesView) blocked() bool {
	return !v.Supported || v.BusyKey != "" || v.PhaseActive
}

// updatesPath is the Updates page of an organization.
func updatesPath(orgID int64) string {
	return "/orgs/" + itoa(orgID) + "/updates"
}

// krillBackupsPath is the Krill backups settings page of an organization.
func krillBackupsPath(orgID int64) string {
	return "/orgs/" + itoa(orgID) + "/krill-backups"
}

// updateStatusURL is the status fragment's poll address; from is the version
// that rendered the page.
func updateStatusURL(orgID int64, current string) string {
	return updatesPath(orgID) + "/status?from=" + url.QueryEscape(current)
}

// Updates renders the running and latest versions, the update and rollback
// actions, the status of a running job and the outcome of the last one.
templ Updates(org db.Organization, role string, v UpdatesView) {
	@SettingsPage(org, role, "updates", i18n.T(ctx, "update.title")) {
		<p class="hint">{ i18n.T(ctx, "update.desc") }</p>
		if !v.Wired {
			<div class="callout callout--warn"><p>{ i18n.T(ctx, "update.unwired") }</p></div>
		} else {
			if v.HasLast {
				switch v.LastReason {
					case "reverted":
						@updateResult(false, i18n.Tf(ctx, "update.result.reverted", v.LastTo))
					case "interrupted":
						@updateResult(false, i18n.Tf(ctx, "update.result.interrupted", v.LastTo))
					case "rollback":
						@updateResult(true, i18n.Tf(ctx, "update.result.rollback", v.LastFrom, v.LastTo))
					default:
						if v.LastOK {
							@updateResult(true, i18n.Tf(ctx, "update.result.updated", v.LastFrom, v.LastTo))
						}
				}
			}
			<section class="sec" aria-labelledby="ver-h">
				<h3 id="ver-h">{ i18n.T(ctx, "update.versions") }</h3>
				<ul class="links">
					<li class="row-item">
						<span class="link-var">{ i18n.T(ctx, "update.current") }</span>
						<code class="link-src">{ v.Current }</code>
						if v.Available {
							@ui.State("warn", i18n.Tf(ctx, "update.available_short", v.Latest))
						} else if v.Latest != "" && v.IsRelease {
							@ui.State("ok", i18n.T(ctx, "update.up_to_date_short"))
						} else {
							<span></span>
						}
					</li>
					<li class="row-item">
						<span class="link-var">{ i18n.T(ctx, "update.latest") }</span>
						if v.Latest != "" {
							<code class="link-src">{ v.Latest }</code>
							<a class="pill pill--small" href={ templ.URL(v.LatestURL) } target="_blank" rel="noopener noreferrer">{ i18n.T(ctx, "update.release_notes") }</a>
						} else {
							<span class="link-src">{ i18n.T(ctx, "update.latest.none") }</span>
							<span></span>
						}
					</li>
				</ul>
				if !v.CheckedAt.IsZero() {
					<p class="hint">{ i18n.Tf(ctx, "update.checked_at", v.CheckedAt.UTC().Format("2006-01-02 15:04 UTC")) }</p>
				}
				if v.CheckErr != "" {
					<div class="callout callout--err"><p>{ i18n.Tf(ctx, "update.check_failed", v.CheckErr) }</p></div>
				}
				<form method="post" action={ templ.SafeURL(updatesPath(org.ID) + "/check") }>
					<button type="submit" class="pill">{ i18n.T(ctx, "update.check_now") }</button>
				</form>
			</section>
			if !v.IsRelease {
				<p class="hint">{ i18n.Tf(ctx, "update.dev_build", v.Current) }</p>
			} else if v.Available {
				<section class="sec" aria-labelledby="inst-h">
					<h3 id="inst-h">{ i18n.Tf(ctx, "update.available", v.Latest) }</h3>
					@updateBlockedReason(v)
					if v.StateLine != "" {
						@updateStateLine(org.ID, v.StateLine)
					}
					<form method="post" hx-boost="false" action={ templ.SafeURL(updatesPath(org.ID) + "/install") } data-confirm={ i18n.Tf(ctx, "update.confirm.install", v.Latest) } data-ok={ i18n.T(ctx, "update.install") } data-kind="primary" onsubmit="return krillConfirm(this)">
						<input type="hidden" name="tag" value={ v.Latest }/>
						<button type="submit" class="btn btn--primary" disabled?={ v.blocked() }>{ i18n.Tf(ctx, "update.install_to", v.Latest) }</button>
					</form>
				</section>
			} else if v.Latest != "" {
				<p class="hint">{ i18n.T(ctx, "update.up_to_date") }</p>
			}
			if v.Phase != "idle" {
				@UpdateStatus(org.ID, v.Current, v.Phase, v.PhaseActive, v.JobTag, v.JobErr)
			}
			if v.Previous != "" {
				<section class="sec" aria-labelledby="rb-h">
					<h3 id="rb-h">{ i18n.Tf(ctx, "update.previous", v.Previous) }</h3>
					<p class="hint">{ i18n.T(ctx, "update.rollback.desc") }</p>
					if !v.Available {
						@updateBlockedReason(v)
					}
					<form method="post" hx-boost="false" action={ templ.SafeURL(updatesPath(org.ID) + "/rollback") } data-confirm={ i18n.Tf(ctx, "update.confirm.rollback", v.Previous) } data-ok={ i18n.T(ctx, "update.rollback") } onsubmit="return krillConfirm(this)">
						<button type="submit" class="pill pill--danger" disabled?={ v.blocked() }>{ i18n.Tf(ctx, "update.rollback_to", v.Previous) }</button>
					</form>
				</section>
			}
		}
	}
}

// updateResult is the outcome of the previous process's update or rollback.
templ updateResult(ok bool, text string) {
	<div class={ "callout", templ.KV("callout--ok", ok), templ.KV("callout--err", !ok) }>
		if ok {
			@ui.State("ok", text)
		} else {
			@ui.State("err", text)
		}
	</div>
}

// updateBlockedReason says why the update and rollback buttons are disabled:
// the host cannot update itself, or other work must finish first.
templ updateBlockedReason(v UpdatesView) {
	if !v.Supported {
		<p class="hint">{ i18n.T(ctx, "update.unsupported.intro") + " " + i18n.T(ctx, v.UnsupportedKey) }</p>
	} else if v.BusyKey != "" {
		<p class="hint">{ i18n.Tf(ctx, "update.busy_intro", i18n.T(ctx, v.BusyKey)) }</p>
	}
}

// UpdateStatus is the status of the self-update job: an active phase or
// "failed" (the page never renders it for an idle installer). While the job is
// active it polls itself every 2 seconds; the poll answers with a full page
// refresh as soon as the job is no longer active, so the failed card only ever
// comes from a page render. errText is the whole, translated failure sentence.
templ UpdateStatus(orgID int64, current, phase string, active bool, tag, errText string) {
	<section
		id="k-update-status"
		class="sec"
		aria-live="polite"
		if active {
			hx-get={ updateStatusURL(orgID, current) }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		<div class="bk-top">
			if active {
				<span class="state state--warn"><span class="spin" aria-hidden="true"></span>{ i18n.T(ctx, "update.phase." + phase) }</span>
			} else {
				@ui.State("err", i18n.T(ctx, "update.phase." + phase))
			}
			if tag != "" {
				<code>{ i18n.Tf(ctx, "update.job_tag", tag) }</code>
			}
		</div>
		if phase == "restarting" {
			<p class="hint">{ i18n.T(ctx, "update.restarting_hint") }</p>
		}
		if phase == "failed" {
			<p class="deploy-msg deploy-msg--err">{ errText }</p>
		}
	</section>
}

// updateStateLine says whether Krill's state is backed up before the update:
// key is "update.state.on", "update.state.off" (with a link to set the
// backup up) or "update.state.paused".
templ updateStateLine(orgID int64, key string) {
	<p class="hint">
		{ i18n.T(ctx, key) }
		if key == "update.state.off" {
			{ " " }
			<a href={ templ.SafeURL(krillBackupsPath(orgID)) }>{ i18n.T(ctx, "update.state.off_link") }</a>
		}
	</p>
}

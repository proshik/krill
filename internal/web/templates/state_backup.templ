package templates

import (
	"time"

	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// StateBackupRun is one row of the recent runs table.
type StateBackupRun struct {
	At        time.Time
	Trigger   string
	OK        bool
	SizeBytes int64
	ObjectKey string
	Error     string
}

// StateBackupView is the Krill backups settings page. It never carries the
// stored secret key, only whether one is stored.
type StateBackupView struct {
	Wired        bool
	SecretKeySet bool // KRILL_SECRET_KEY is configured
	Enabled      bool
	Ready        bool // storage and a recipient are saved
	Running      bool
	Endpoint     string
	Bucket       string
	Region       string
	AccessKey    string
	HasSecret    bool
	Prefix       string
	Recipient    string
	Preset       string
	CustomCron   string
	Retention    int
	NextRun      time.Time // zero: none
	HasLast      bool
	LastAt       time.Time
	LastSize     int64
	Runs         []StateBackupRun
}

func stateBackupPath(orgID int64) string {
	return "/orgs/" + itoa(orgID) + "/krill-backups"
}

// stateBackupStateKey names the state badge: not set up, active, on demand
// only or paused.
func stateBackupStateKey(v StateBackupView) string {
	switch {
	case !v.Ready:
		return "sbk.state.none"
	case !v.Enabled:
		return "sbk.state.paused"
	case v.Preset == "off":
		return "sbk.state.ondemand"
	}
	return "sbk.state.active"
}

func sbkTime(t time.Time) string { return t.Local().Format("2006-01-02 15:04") }

templ StateBackupPage(org db.Organization, role string, v StateBackupView) {
	@SettingsPage(org, role, "krill", i18n.T(ctx, "sbk.title")) {
		<p class="hint">{ i18n.T(ctx, "sbk.desc") }</p>
		if !v.Wired {
			<div class="callout callout--warn"><p>{ i18n.T(ctx, "sbk.unwired") }</p></div>
		} else {
			<div class="callout">
				<div class="callout-body">
					<p>{ i18n.T(ctx, "sbk.warn_keys") }</p>
					if !v.SecretKeySet {
						@ui.State("err", i18n.T(ctx, "sbk.warn_plaintext"))
					}
				</div>
			</div>
			@stateBackupStatus(org.ID, v)
			@stateBackupForm(org.ID, v)
			@stateBackupRuns(v)
		}
	}
}

templ stateBackupStatus(orgID int64, v StateBackupView) {
	<section class="sec" aria-labelledby="kb-h">
		<div class="sec-head">
			<h3 id="kb-h">{ i18n.T(ctx, "sbk.schedule_title") }</h3>
			if v.Ready {
				<form method="post" action={ templ.SafeURL(stateBackupPath(orgID) + "/enabled") }>
					if v.Enabled {
						<input type="hidden" name="enabled" value="0"/>
					} else {
						<input type="hidden" name="enabled" value="1"/>
					}
					@SwitchButton(v.Enabled, i18n.T(ctx, "backup.on"), i18n.T(ctx, "backup.paused"))
				</form>
			}
		</div>
		<div class="bk-top">
			<span class="bk-what">
				<span class="bk-sched">{ i18n.T(ctx, stateBackupStateKey(v)) }</span>
				if !v.NextRun.IsZero() {
					<span class="run-meta">{ i18n.Tf(ctx, "sbk.next_run", sbkTime(v.NextRun)) }</span>
				}
			</span>
			if v.Running {
				<span class="state state--warn"><span class="spin" aria-hidden="true"></span>{ i18n.T(ctx, "sbk.state.running") }</span>
			} else if v.HasLast {
				@ui.State("ok", i18n.Tf(ctx, "sbk.last_ok", sbkTime(v.LastAt), humanSize(v.LastSize)))
			} else {
				@ui.State("idle", i18n.T(ctx, "sbk.last_never"))
			}
			<form method="post" action={ templ.SafeURL(stateBackupPath(orgID) + "/run") }>
				<button type="submit" class="pill" disabled?={ v.Running || !v.Ready }>{ i18n.T(ctx, "sbk.run_now") }</button>
			</form>
		</div>
		<p class="hint">{ i18n.T(ctx, "sbk.pre_update_hint") }</p>
	</section>
}

templ stateBackupForm(orgID int64, v StateBackupView) {
	<form class="sec bk-settings" method="post" action={ templ.SafeURL(stateBackupPath(orgID)) } autocomplete="off" aria-labelledby="kbs-h">
		<h3 id="kbs-h">{ i18n.T(ctx, "sbk.settings_title") }</h3>
		@schedulePresets("sbk", v.Preset, v.CustomCron)
		<div class="field">
			<label for="sbk_retention">{ i18n.T(ctx, "backup.keep_last") }</label>
			<input class="input input--mono" id="sbk_retention" name="retention" type="number" min="1" max="1000" value={ itoa(int64(v.Retention)) }/>
		</div>
		<h4 class="list-head">{ i18n.T(ctx, "sbk.storage") }</h4>
		<div class="field">
			<label for="sbk_endpoint">{ i18n.T(ctx, "dest.endpoint") }</label>
			<input class="input input--mono" id="sbk_endpoint" name="endpoint" value={ v.Endpoint } placeholder="https://s3.example.com" spellcheck="false" aria-describedby="sbk_endpoint_hint"/>
			<p class="field-hint" id="sbk_endpoint_hint">{ i18n.T(ctx, "dest.endpoint_hint") }</p>
		</div>
		<div class="row row--even">
			<div class="field">
				<label for="sbk_bucket">{ i18n.T(ctx, "dest.bucket") }</label>
				<input class="input input--mono" id="sbk_bucket" name="bucket" value={ v.Bucket } spellcheck="false"/>
			</div>
			<div class="field">
				<label for="sbk_region">{ i18n.T(ctx, "dest.region") }</label>
				<input class="input input--mono" id="sbk_region" name="region" value={ v.Region } placeholder="us-east-1"/>
			</div>
		</div>
		<div class="row row--even">
			<div class="field">
				<label for="sbk_access_key">{ i18n.T(ctx, "dest.access_key") }</label>
				<input class="input input--mono" id="sbk_access_key" name="access_key" value={ v.AccessKey } spellcheck="false"/>
			</div>
			<div class="field">
				<label for="sbk_secret_key">{ i18n.T(ctx, "dest.secret_key") }</label>
				if v.HasSecret {
					<input class="input input--mono" id="sbk_secret_key" name="secret_key" type="password" autocomplete="new-password" placeholder={ i18n.T(ctx, "sbk.secret_stored") } aria-describedby="sbk_secret_hint"/>
				} else {
					<input class="input input--mono" id="sbk_secret_key" name="secret_key" type="password" autocomplete="new-password" aria-describedby="sbk_secret_hint"/>
				}
				<p class="field-hint" id="sbk_secret_hint">{ i18n.T(ctx, "sbk.secret_hint") }</p>
			</div>
		</div>
		<details class="adv">
			<summary>{ i18n.T(ctx, "backup.advanced") }</summary>
			<div class="field">
				<label for="sbk_prefix">{ i18n.T(ctx, "sbk.prefix") }</label>
				<input class="input input--mono" id="sbk_prefix" name="prefix" value={ v.Prefix } aria-describedby="sbk_prefix_hint"/>
				<p class="field-hint" id="sbk_prefix_hint">{ i18n.T(ctx, "sbk.prefix_hint") }</p>
			</div>
		</details>
		<div class="field">
			<label for="sbk_recipient">{ i18n.T(ctx, "sbk.recipient") }</label>
			<input class="input input--mono" id="sbk_recipient" name="recipient" value={ v.Recipient } spellcheck="false" aria-describedby="sbk_recipient_hint"/>
			<p class="field-hint" id="sbk_recipient_hint">{ i18n.T(ctx, "sbk.recipient_help") }</p>
			<p class="field-hint">{ i18n.T(ctx, "sbk.rotation_note") }</p>
		</div>
		<div class="sec-add"><button type="submit" class="btn btn--primary">{ i18n.T(ctx, "sbk.save") }</button></div>
	</form>
}

templ stateBackupRuns(v StateBackupView) {
	<section class="sec" aria-labelledby="kbr-h">
		<h3 id="kbr-h">{ i18n.T(ctx, "sbk.runs") }</h3>
		if len(v.Runs) == 0 {
			<p class="empty">{ i18n.T(ctx, "sbk.runs_none") }</p>
		} else {
			<ul class="snaps">
				for _, r := range v.Runs {
					<li class="snap">
						<span class="snap-when">{ r.At.Local().Format("2006-01-02 15:04") }</span>
						<span class="run-meta">{ i18n.T(ctx, "sbk.trigger." + r.Trigger) + ", " + humanSize(r.SizeBytes) }</span>
						if r.OK {
							@ui.State("ok", i18n.T(ctx, "sbk.status.ok"))
						} else {
							@ui.State("err", i18n.T(ctx, "sbk.status.error"))
						}
						<span class="snap-keys"><code>{ r.ObjectKey }</code></span>
						if r.Error != "" {
							<p class="deploy-msg deploy-msg--err snap-err">{ r.Error }</p>
						}
					</li>
				}
			</ul>
			<p class="hint">
				{ i18n.T(ctx, "sbk.restore_hint") + " " }
				<a href="https://github.com/proshik/krill/blob/master/docs/install.md" target="_blank" rel="noopener">{ i18n.T(ctx, "sbk.restore_guide") }</a>
			</p>
		}
	</section>
}

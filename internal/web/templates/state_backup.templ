package templates

import (
	"time"

	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
)

// StateBackupRun is one row of the recent runs table.
type StateBackupRun struct {
	At        time.Time
	Trigger   string
	OK        bool
	SizeBytes int64
	ObjectKey string
	Error     string
}

// StateBackupView is the Krill backups settings page. It never carries the
// stored secret key, only whether one is stored.
type StateBackupView struct {
	Wired        bool
	SecretKeySet bool // KRILL_SECRET_KEY is configured
	Enabled      bool
	Ready        bool // storage and a recipient are saved
	Running      bool
	Endpoint     string
	Bucket       string
	Region       string
	AccessKey    string
	HasSecret    bool
	Prefix       string
	Recipient    string
	Preset       string
	CustomCron   string
	Retention    int
	NextRun      time.Time // zero: none
	HasLast      bool
	LastAt       time.Time
	LastSize     int64
	Runs         []StateBackupRun
}

func stateBackupPath(orgID int64) string {
	return "/orgs/" + itoa(orgID) + "/krill-backups"
}

// stateBackupStateKey names the state badge: not set up, active, on demand
// only or paused.
func stateBackupStateKey(v StateBackupView) string {
	switch {
	case !v.Ready:
		return "sbk.state.none"
	case !v.Enabled:
		return "sbk.state.paused"
	case v.Preset == "off":
		return "sbk.state.ondemand"
	}
	return "sbk.state.active"
}

func sbkTime(t time.Time) string { return t.Local().Format("2006-01-02 15:04") }

templ StateBackupPage(org db.Organization, role string, v StateBackupView) {
	@Layout(i18n.T(ctx, "sbk.title"), org, role) {
		@settingsNav(org.ID)
		<p class="mb-4" style="color:var(--color-muted);max-width:720px">{ i18n.T(ctx, "sbk.desc") }</p>
		if !v.Wired {
			<div class="k-card mb-4">
				<p style="max-width:720px">{ i18n.T(ctx, "sbk.unwired") }</p>
			</div>
		} else {
			<div class="k-card mb-4">
				<p class="mb-2" style="max-width:720px">{ i18n.T(ctx, "sbk.warn_keys") }</p>
				if !v.SecretKeySet {
					<p class="mb-2" style="max-width:720px;color:var(--color-err)">{ i18n.T(ctx, "sbk.warn_plaintext") }</p>
				}
			</div>
			@stateBackupStatus(org.ID, v)
			@stateBackupForm(org.ID, v)
			@stateBackupRuns(v)
		}
	}
}

templ stateBackupStatus(orgID int64, v StateBackupView) {
	<div class="k-card mb-4">
		<div class="flex items-center gap-2 mb-3">
			if !v.Ready || !v.Enabled {
				<span class="k-badge"><span class="k-dot"></span>{ i18n.T(ctx, stateBackupStateKey(v)) }</span>
			} else {
				<span class="k-badge k-badge-running"><span class="k-dot"></span>{ i18n.T(ctx, stateBackupStateKey(v)) }</span>
			}
			if v.Running {
				<span class="k-badge k-badge-deploying"><span class="k-dot"></span>{ i18n.T(ctx, "sbk.state.running") }</span>
			}
		</div>
		if !v.NextRun.IsZero() {
			<p class="mb-2">{ i18n.Tf(ctx, "sbk.next_run", sbkTime(v.NextRun)) }</p>
		}
		if v.HasLast {
			<p class="mb-3">{ i18n.Tf(ctx, "sbk.last_ok", sbkTime(v.LastAt), humanSize(v.LastSize)) }</p>
		} else {
			<p class="mb-3">{ i18n.T(ctx, "sbk.last_never") }</p>
		}
		<div class="flex gap-2">
			<form method="post" action={ templ.SafeURL(stateBackupPath(orgID) + "/run") }>
				if v.Running || !v.Ready {
					<button class="k-btn k-btn-primary" disabled>{ i18n.T(ctx, "sbk.run_now") }</button>
				} else {
					<button class="k-btn k-btn-primary">{ i18n.T(ctx, "sbk.run_now") }</button>
				}
			</form>
			if v.Ready {
				<form method="post" action={ templ.SafeURL(stateBackupPath(orgID) + "/enabled") }>
					if v.Enabled {
						<input type="hidden" name="enabled" value="0"/>
						<button class="k-btn k-btn-secondary">{ i18n.T(ctx, "sbk.pause") }</button>
					} else {
						<input type="hidden" name="enabled" value="1"/>
						<button class="k-btn k-btn-secondary">{ i18n.T(ctx, "sbk.resume") }</button>
					}
				</form>
			}
		</div>
	</div>
}

templ stateBackupForm(orgID int64, v StateBackupView) {
	<form method="post" action={ templ.SafeURL(stateBackupPath(orgID)) } class="k-card mb-4 flex flex-col gap-3" autocomplete="off">
		<h3 class="text-lg">{ i18n.T(ctx, "sbk.storage") }</h3>
		<div>
			<label class="k-label" for="sbk_endpoint">{ i18n.T(ctx, "dest.endpoint") }</label>
			<input class="k-input" id="sbk_endpoint" name="endpoint" value={ v.Endpoint }/>
			<p class="k-muted text-xs">{ i18n.T(ctx, "dest.endpoint_hint") }</p>
		</div>
		<div>
			<label class="k-label" for="sbk_bucket">{ i18n.T(ctx, "dest.bucket") }</label>
			<input class="k-input" id="sbk_bucket" name="bucket" value={ v.Bucket }/>
		</div>
		<div>
			<label class="k-label" for="sbk_region">{ i18n.T(ctx, "dest.region") }</label>
			<input class="k-input" id="sbk_region" name="region" value={ v.Region } placeholder="us-east-1"/>
		</div>
		<div>
			<label class="k-label" for="sbk_access_key">{ i18n.T(ctx, "dest.access_key") }</label>
			<input class="k-input" id="sbk_access_key" name="access_key" value={ v.AccessKey }/>
		</div>
		<div>
			<label class="k-label" for="sbk_secret_key">{ i18n.T(ctx, "dest.secret_key") }</label>
			if v.HasSecret {
				<input class="k-input" id="sbk_secret_key" name="secret_key" type="password" autocomplete="new-password" placeholder={ i18n.T(ctx, "sbk.secret_stored") }/>
			} else {
				<input class="k-input" id="sbk_secret_key" name="secret_key" type="password" autocomplete="new-password"/>
			}
			<p class="k-muted text-xs">{ i18n.T(ctx, "sbk.secret_hint") }</p>
		</div>
		<div>
			<label class="k-label" for="sbk_prefix">{ i18n.T(ctx, "sbk.prefix") }</label>
			<input class="k-input" id="sbk_prefix" name="prefix" value={ v.Prefix }/>
			<p class="k-muted text-xs">{ i18n.T(ctx, "sbk.prefix_hint") }</p>
		</div>
		<div>
			<label class="k-label" for="sbk_recipient">{ i18n.T(ctx, "sbk.recipient") }</label>
			<input class="k-input k-mono" id="sbk_recipient" name="recipient" value={ v.Recipient }/>
			<p class="k-muted text-xs" style="max-width:720px">{ i18n.T(ctx, "sbk.recipient_help") }</p>
			<p class="k-muted text-xs" style="max-width:720px">{ i18n.T(ctx, "sbk.rotation_note") }</p>
		</div>
		<div>
			<label class="k-label">{ i18n.T(ctx, "backup.schedule") }</label>
			<select class="k-select k-sched-preset" name="schedule_preset">
				<option value="off" selected?={ v.Preset == "off" }>{ i18n.T(ctx, "backup.sched.off") }</option>
				<option value="hourly" selected?={ v.Preset == "hourly" }>{ i18n.T(ctx, "backup.sched.hourly") }</option>
				<option value="daily" selected?={ v.Preset == "daily" }>{ i18n.T(ctx, "backup.sched.daily") }</option>
				<option value="weekly" selected?={ v.Preset == "weekly" }>{ i18n.T(ctx, "backup.sched.weekly") }</option>
				<option value="monthly" selected?={ v.Preset == "monthly" }>{ i18n.T(ctx, "backup.sched.monthly") }</option>
				<option value="custom" selected?={ v.Preset == "custom" }>{ i18n.T(ctx, "backup.sched.custom") }</option>
			</select>
			<div class="k-sched-custom" style="display:none">
				<input class="k-input mt-2" name="schedule_custom" placeholder="0 3 * * *" value={ v.CustomCron }/>
				<p class="k-muted text-xs">{ i18n.T(ctx, "backup.sched.custom_hint") }</p>
			</div>
		</div>
		<div>
			<label class="k-label" for="sbk_retention">{ i18n.T(ctx, "backup.retention") }</label>
			<input class="k-input" id="sbk_retention" name="retention" type="number" min="1" max="1000" value={ itoa(int64(v.Retention)) }/>
		</div>
		<div><button class="k-btn k-btn-primary">{ i18n.T(ctx, "sbk.save") }</button></div>
	</form>
}

templ stateBackupRuns(v StateBackupView) {
	<div class="k-card mb-4">
		<h3 class="text-lg mb-2">{ i18n.T(ctx, "sbk.runs") }</h3>
		if len(v.Runs) == 0 {
			<p class="k-muted">{ i18n.T(ctx, "sbk.runs_none") }</p>
		} else {
			<table class="k-table">
				<thead><tr><th>{ i18n.T(ctx, "sbk.col.time") }</th><th>{ i18n.T(ctx, "sbk.col.trigger") }</th><th>{ i18n.T(ctx, "sbk.col.status") }</th><th>{ i18n.T(ctx, "sbk.col.size") }</th><th>{ i18n.T(ctx, "sbk.col.object") }</th><th>{ i18n.T(ctx, "sbk.col.error") }</th></tr></thead>
				<tbody>
					for _, r := range v.Runs {
						<tr>
							<td class="k-mono">{ r.At.Local().Format("2006-01-02 15:04:05") }</td>
							<td>{ i18n.T(ctx, "sbk.trigger." + r.Trigger) }</td>
							<td>
								if r.OK {
									<span class="k-badge k-badge-running"><span class="k-dot"></span>{ i18n.T(ctx, "sbk.status.ok") }</span>
								} else {
									<span class="k-badge k-badge-error"><span class="k-dot"></span>{ i18n.T(ctx, "sbk.status.error") }</span>
								}
							</td>
							<td>{ humanSize(r.SizeBytes) }</td>
							<td class="k-mono">{ r.ObjectKey }</td>
							<td>{ r.Error }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

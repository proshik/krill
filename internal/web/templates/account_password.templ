package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
)

// AccountPassword is the standalone change-password page. It is what a user who
// still owes a password change is held on, so it deliberately has no
// navigation: there is nowhere else they may go yet. Everyone else reaches the
// same form inside the normal layout (AccountPasswordPage).
templ AccountPassword(errMsg string, forced bool) {
	@Bare(i18n.T(ctx, "account.password_title")) {
		<div class="k-card w-[420px] max-w-full">
			<div class="k-side-brand mb-4" style="font-size:20px">🦐 Krill</div>
			if forced {
				<div class="k-toast mb-3">{ i18n.T(ctx, "account.password_forced") }</div>
			}
			@accountPasswordForm("/account/password", errMsg)
			if !forced {
				<div class="mt-4">
					<a href="/">{ i18n.T(ctx, "account.password_back") }</a>
				</div>
			}
		</div>
	}
}

// AccountPasswordPage is the change-password form for a user who is not forced
// to change it, rendered inside the normal layout so they can navigate away.
templ AccountPasswordPage(org db.Organization, role string, errMsg string) {
	@Layout(i18n.T(ctx, "account.password_title"), org, role) {
		<h2 class="text-2xl mb-3">{ i18n.T(ctx, "account.password_title") }</h2>
		<div class="k-card w-[420px] max-w-full">
			@accountPasswordForm("/orgs/"+itoa(org.ID)+"/account/password", errMsg)
		</div>
	}
}

templ accountPasswordForm(action string, errMsg string) {
	if errMsg != "" {
		<div class="k-toast k-toast-err mb-3">{ errMsg }</div>
	}
	<form method="post" action={ templ.SafeURL(action) } hx-boost="false">
		<label class="k-label">{ i18n.T(ctx, "account.password_current") }</label>
		<input class="k-input" name="current" type="password" required autofocus/>
		<label class="k-label">{ i18n.T(ctx, "account.password_new") }</label>
		<input class="k-input" name="next" type="password" required/>
		<label class="k-label">{ i18n.T(ctx, "account.password_repeat") }</label>
		<input class="k-input" name="repeat" type="password" required/>
		<div class="mt-4">
			<button type="submit" class="k-btn k-btn-primary">{ i18n.T(ctx, "account.password_submit") }</button>
		</div>
	</form>
}

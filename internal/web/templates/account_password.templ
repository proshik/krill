package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
)

// AccountPassword is the standalone change-password page. It is what a user who
// still owes a password change is held on, so it deliberately has no
// navigation: there is nowhere else they may go yet. Everyone else reaches the
// same form inside the normal layout (AccountPasswordPage).
templ AccountPassword(errMsg string, forced bool) {
	@AuthPage(i18n.T(ctx, "account.password_title")) {
		<h1>{ i18n.T(ctx, "account.password_set_title") }</h1>
		if forced {
			<p class="hint">{ i18n.T(ctx, "account.password_forced") }</p>
		}
		@accountPasswordForm("/account/password", errMsg, forced)
		if !forced {
			<a class="pill" href="/">{ i18n.T(ctx, "account.password_back") }</a>
		}
	}
}

// AccountPasswordPage is the change-password form for a user who is not forced
// to change it, inside settings so they can navigate away.
templ AccountPasswordPage(org db.Organization, role string, errMsg string) {
	@SettingsPage(org, role, "password", i18n.T(ctx, "account.password_title")) {
		<section class="sec" aria-label={ i18n.T(ctx, "account.password_change") }>
			@accountPasswordForm("/orgs/"+itoa(org.ID)+"/account/password", errMsg, false)
		</section>
	}
}

templ accountPasswordForm(action string, errMsg string, forced bool) {
	if errMsg != "" {
		<div class="callout callout--err" role="alert"><p>{ errMsg }</p></div>
	}
	<form class="stack" method="post" action={ templ.SafeURL(action) } hx-boost="false">
		<div class="field">
			<label for="pcur">{ i18n.T(ctx, "account.password_current") }</label>
			<input class="input" id="pcur" name="current" type="password" autocomplete="current-password" required autofocus/>
		</div>
		<div class="field">
			<label for="pnew">{ i18n.T(ctx, "account.password_new") }</label>
			<input class="input" id="pnew" name="next" type="password" autocomplete="new-password" minlength="10" required aria-describedby="pnew-hint"/>
			<p class="field-hint" id="pnew-hint">{ i18n.T(ctx, "account.password_min") }</p>
		</div>
		<div class="field">
			<label for="prep">{ i18n.T(ctx, "account.password_repeat") }</label>
			<input class="input" id="prep" name="repeat" type="password" autocomplete="new-password" required/>
		</div>
		<div class="sec-add">
			<button type="submit" class="btn btn--primary">{ i18n.T(ctx, "account.password_submit") }</button>
		</div>
		<p class="hint">{ i18n.T(ctx, "account.password_others") }</p>
	</form>
	if forced {
		<form method="post" action="/logout" hx-boost="false">
			<button type="submit" class="pill">{ i18n.T(ctx, "nav.logout") }</button>
		</form>
	}
}

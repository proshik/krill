package templates

import db "github.com/proshik/krill/internal/database/gen"

templ Deployments(c AppCtx, deps []db.Deployment) {
	<div class="k-card">
		<div hx-get={ c.base() + "/deployments-list" } hx-trigger="every 2s" hx-target="this" hx-swap="outerHTML">
			@DeploymentsList(c, deps)
		</div>
	</div>
}

templ DeploymentsList(c AppCtx, deps []db.Deployment) {
	<table id="deployments-list" class="k-table">
		<thead><tr><th>Время</th><th>Статус</th><th>Триггер</th><th>Образ</th><th>Лог</th></tr></thead>
		<tbody>
			if len(deps) == 0 {
				<tr><td colspan="5" class="k-mono">Деплоев ещё не было.</td></tr>
			} else {
				for _, dp := range deps {
					<tr>
						<td class="k-mono">{ dp.StartedAt.Format("2006-01-02 15:04:05") }</td>
						<td>@StatusBadge(dp.Status)</td>
						<td class="k-mono">{ dp.Trigger }</td>
						<td class="k-mono">{ dp.ImageTag }</td>
						<td><a class="text-[color:var(--color-accent)]" href={ templ.SafeURL(c.base() + "/deployments/" + itoa(dp.ID)) }>открыть</a></td>
					</tr>
				}
			}
		</tbody>
	</table>
}

templ DeploymentLog(c AppCtx, dep db.Deployment) {
	@Layout("Деплой #"+itoa(dep.ID), c.Org, c.Role) {
		<p class="k-crumbs mb-3 flex items-center gap-2">
			<a href={ templ.SafeURL(c.base()) }>{ c.App.Name }</a>
			<span>/ Деплой #{ itoa(dep.ID) }</span>
			@StatusBadge(dep.Status)
		</p>
		<div class="k-card">
			<div id="terminal" data-ws={ c.base() + "/deployments/" + itoa(dep.ID) + "/logs" }></div>
			<script src="/static/xterm.js"></script>
			<script src="/static/addon-fit.js"></script>
			<script src="/static/app.js"></script>
			<script>
				mountLogTerminal(document.getElementById('terminal').dataset.ws);
			</script>
		</div>
	}
}

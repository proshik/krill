package templates

import (
	"strconv"
	"time"

	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// LinkView is the state of the Krill link, as Settings → Link shows it.
type LinkView struct {
	Available        bool   // the link is wired in this build
	Role             string // off | client | relay
	ListenAddr       string // KRILL_LINK_LISTEN_ADDR
	ListenFailed     bool   // the gateway listener could not bind
	RelayReqKey      string // why the relay role is unavailable, "" when it is
	ClientReqKey     string // why the client role is unavailable, "" when it is
	RelayCertsBroken bool   // the relay's certificates cannot be read
	FirewallStale    bool   // a lockdown is applied without the link's port
	FirewallURL      string
	// relay
	LinkHost    string
	DefaultAddr string // the address a pairing code carries by default
	NewCode     string // a pairing code just created, shown once
	Conflicts   []LinkConflict
	Peers       []LinkPeerRow
	OpenCodes   []LinkCodeRow
	// client
	Client    LinkClientState
	Paired    bool
	RelaySNI  string
	RelayAddr string
	PairedAt  time.Time
	// egress (KRL-002)
	Dests        []LinkDestRow     // relay: its list; client: the relay's, as last sent
	RelayEgress  bool              // client: the relay speaks egress
	Grants       []LinkGrantRow    // client: every organization
	Services     []LinkServiceRow  // client: its services
	Gate         LinkGate          // client: the rollback gate on granting
	EgressReqKey string            // client: why the sidecar cannot reach Krill
}

// LinkDestRow is one destination of the relay's list.
type LinkDestRow struct {
	Host string
	Port int
}

func (d LinkDestRow) String() string { return d.Host + ":" + strconv.Itoa(d.Port) }

// LinkGrantRow is one organization and whether the link is granted to it.
type LinkGrantRow struct {
	OrgID   int64
	Name    string
	Granted bool
}

// LinkServiceRow is one client service: an app with its destinations.
type LinkServiceRow struct {
	Path  string
	Dests []LinkServiceDest
}

// LinkServiceDest is one destination of a service with its state and the
// bytes it carried since this Krill started.
type LinkServiceDest struct {
	Dest    string
	Allowed bool
	Up      int64
	Down    int64
}

// LinkGate is the rollback gate on enabling egress: closed while the rollback
// binary is older than the link core release or cannot be read.
type LinkGate struct {
	Closed     bool
	Text       string // the reason, translated
	UpdatesURL string // Settings → Updates
}

// LinkConflict is a record holding the relay's link host besides the link.
type LinkConflict struct {
	Panel   bool
	Ingress bool
	App   string // project/environment/app
	URL   string // the app's domains tab
}

// LinkPeerRow is one peer of a relay.
type LinkPeerRow struct {
	ID            int64
	Name          string
	Connected     bool
	From          string
	Since         time.Time
	Version       string
	Latency       time.Duration
	CertNotAfter  time.Time
	LastSeen      time.Time
	Services      []LinkServiceRow // from the client's manifest
	// The latest refused session: duplicate or incompatible.
	RefusalCategory string
	RefusalProto    int
	RefusalFrom     string
	RefusalAt       time.Time
}

// LinkCodeRow is a pairing code waiting to be redeemed.
type LinkCodeRow struct {
	Peer      string
	ExpiresAt time.Time
}

// LinkClientState is a client's session state.
type LinkClientState struct {
	State        string // off | unpaired | connecting | connected
	Category     string // dns | tcp | tls | unauthorized | incompatible | duplicate
	Message      string
	FailedAt     time.Time
	Since        time.Time
	Latency      time.Duration
	RelayVersion string
	CertNotAfter time.Time
}

func linkURL(orgID int64, rest string) string { return orgURL(orgID) + "/link" + rest }

func linkDate(t time.Time) string { return t.Local().Format("2006-01-02") }

func linkClock(t time.Time) string { return t.Local().Format("2006-01-02 15:04") }

func linkMS(d time.Duration) string {
	if d <= 0 {
		return "—"
	}
	if d < time.Millisecond {
		return "< 1 ms"
	}
	return strconv.FormatInt(d.Milliseconds(), 10) + " ms"
}

// Link renders Settings → Link: the role and its requirements; on a relay its
// link host, pairing codes and peers; on a client its relay and session.
templ Link(org db.Organization, role string, v LinkView) {
	@SettingsPage(org, role, "link", i18n.T(ctx, "link.title")) {
		<p class="hint">{ i18n.T(ctx, "link.desc") }</p>
		if !v.Available {
			<div class="callout callout--warn"><p>{ i18n.T(ctx, "link.unwired") }</p></div>
		} else {
			if v.ListenFailed {
				<div class="callout callout--err"><p>{ i18n.Tf(ctx, "link.listen_failed", v.ListenAddr) }</p></div>
			}
			if v.FirewallStale {
				<div class="callout callout--warn">
					<div class="callout-body">
						<p>{ i18n.Tf(ctx, "link.firewall_stale", v.ListenAddr) }</p>
						<p><a href={ templ.SafeURL(v.FirewallURL) }>{ i18n.T(ctx, "link.firewall_open") }</a></p>
					</div>
				</div>
			}
			switch v.Role {
				case "relay":
					@linkRelay(org, v)
				case "client":
					@linkClient(org, v)
				default:
					@linkOff(org, v)
			}
		}
	}
}

templ linkOff(org db.Organization, v LinkView) {
	<section class="sec" aria-labelledby="lr-h">
		<div class="sec-head">
			<h3 id="lr-h">{ i18n.T(ctx, "link.role") }</h3>
			@ui.State("idle", i18n.T(ctx, "link.role.off"))
		</div>
		<p class="hint">{ i18n.T(ctx, "link.role_off_desc") }</p>
		<form class="sec" method="post" hx-boost="false" action={ templ.SafeURL(linkURL(org.ID, "/role")) } aria-labelledby="lc-h">
			<h3 id="lc-h">{ i18n.T(ctx, "link.become_client") }</h3>
			<p class="hint">{ i18n.T(ctx, "link.client_req") }</p>
			if v.ClientReqKey != "" {
				<div class="callout callout--warn"><p>{ i18n.T(ctx, v.ClientReqKey) }</p></div>
			} else {
				<input type="hidden" name="role" value="client"/>
				<div><button type="submit" class="pill">{ i18n.T(ctx, "link.become_client") }</button></div>
			}
		</form>
		<form class="sec" method="post" hx-boost="false" action={ templ.SafeURL(linkURL(org.ID, "/role")) } aria-labelledby="lv-h">
			<h3 id="lv-h">{ i18n.T(ctx, "link.become_relay") }</h3>
			<p class="hint">{ i18n.Tf(ctx, "link.relay_req", v.ListenAddr) }</p>
			if v.RelayReqKey != "" {
				<div class="callout callout--warn"><p>{ i18n.T(ctx, v.RelayReqKey) }</p></div>
			} else {
				<input type="hidden" name="role" value="relay"/>
				<div class="add-row">
					<div class="field">
						<label for="lhost">{ i18n.T(ctx, "link.host") }</label>
						<input class="input input--mono" id="lhost" name="link_host" value={ v.LinkHost } placeholder="link.relay.example.com" required autocomplete="off" spellcheck="false" aria-describedby="lhost-hint"/>
					</div>
					<button type="submit" class="pill">{ i18n.T(ctx, "link.become_relay") }</button>
					<p class="field-hint" id="lhost-hint">{ i18n.T(ctx, "link.host_hint") }</p>
				</div>
			}
		</form>
	</section>
}

// linkTurnOff is the destructive "turn the link off" form.
templ linkTurnOff(org db.Organization, more string) {
	<form method="post" hx-boost="false" action={ templ.SafeURL(linkURL(org.ID, "/role")) } data-confirm={ i18n.T(ctx, "link.confirm.off") } data-more={ more } data-ok={ i18n.T(ctx, "link.turn_off") } onsubmit="return krillConfirm(this)">
		<input type="hidden" name="role" value="off"/>
		<button type="submit" class="pill pill--danger">{ i18n.T(ctx, "link.turn_off") }</button>
	</form>
}

templ linkRelay(org db.Organization, v LinkView) {
	<section class="sec" aria-labelledby="lr-h" data-unsaved-scope>
		<div class="sec-head">
			<h3 id="lr-h">{ i18n.T(ctx, "link.role") }</h3>
			@ui.State("ok", i18n.T(ctx, "link.role.relay"))
		</div>
		if v.RelayCertsBroken {
			<div class="callout callout--err"><p>{ i18n.T(ctx, "link.relay_certs_broken") }</p></div>
		}
		if len(v.Conflicts) > 0 {
			<div class="callout callout--err">
				<div class="callout-body">
					<p>{ i18n.Tf(ctx, "link.conflict", v.LinkHost) }</p>
					<ul>
						for _, c := range v.Conflicts {
							<li>
								if c.Panel {
									{ i18n.T(ctx, "link.conflict_panel") }
								} else if c.Ingress {
									{ i18n.T(ctx, "link.conflict_ingress") }
								} else {
									{ i18n.T(ctx, "link.conflict_app") + " " }
									<a href={ templ.SafeURL(c.URL) }>{ c.App }</a>
								}
							</li>
						}
					</ul>
					<p>{ i18n.T(ctx, "link.conflict_resolve") }</p>
				</div>
			</div>
		}
		<form class="add-row" method="post" hx-boost="false" action={ templ.SafeURL(linkURL(org.ID, "/role")) }>
			<input type="hidden" name="role" value="relay"/>
			<div class="field">
				<label for="lhost">{ i18n.T(ctx, "link.host") }</label>
				<input class="input input--mono" id="lhost" name="link_host" value={ v.LinkHost } required autocomplete="off" spellcheck="false" aria-describedby="lhost-hint"/>
			</div>
			<button type="submit" class="pill">{ i18n.T(ctx, "common.save") }</button>
			<p class="field-hint" id="lhost-hint">{ i18n.T(ctx, "link.host_hint") }</p>
		</form>
		@linkTurnOff(org, i18n.T(ctx, "link.off_more_relay"))
	</section>
	if v.NewCode != "" {
		<div class="callout callout--ok" role="status">
			<div class="callout-body">
				@ui.State("ok", i18n.T(ctx, "link.code_created"))
				<p class="hint">{ i18n.T(ctx, "link.code_once") }</p>
				<div class="input-group">
					<input class="input input--mono" value={ v.NewCode } readonly aria-label={ i18n.T(ctx, "link.code") }/>
					@ui.CopyButton(v.NewCode, i18n.T(ctx, "common.copy"))
				</div>
			</div>
		</div>
	}
	<section class="sec" aria-labelledby="lp-h">
		<div class="sec-head"><h3 id="lp-h">{ i18n.T(ctx, "link.peers") }</h3></div>
		if len(v.Peers) == 0 {
			<p class="empty">{ i18n.T(ctx, "link.peers_empty") }</p>
		} else {
			<ul class="links">
				for _, p := range v.Peers {
					<li class="row-item">
						<span class="link-var">{ p.Name }</span>
						<span class="link-src">
							if p.Connected {
								{ i18n.Tf(ctx, "link.peer_session", p.From, linkClock(p.Since), linkMS(p.Latency), p.Version) }
							} else if !p.LastSeen.IsZero() {
								{ i18n.Tf(ctx, "link.peer_last_seen", linkClock(p.LastSeen)) }
							} else {
								{ i18n.T(ctx, "link.peer_never") }
							}
							<br/>
							{ i18n.Tf(ctx, "link.cert_until", linkDate(p.CertNotAfter)) }
							switch p.RefusalCategory {
								case "duplicate":
									<br/>
									{ i18n.Tf(ctx, "link.peer_duplicate", p.RefusalFrom, linkClock(p.RefusalAt)) }
								case "incompatible":
									<br/>
									{ i18n.Tf(ctx, "link.peer_incompatible", strconv.Itoa(p.RefusalProto), linkClock(p.RefusalAt)) }
							}
						</span>
						if p.Connected {
							@ui.State("ok", i18n.T(ctx, "link.state.connected"))
						} else {
							@ui.State("idle", i18n.T(ctx, "link.state.disconnected"))
						}
						if len(p.Services) > 0 {
							@linkServices(p.Services, "link.dest.off_list")
						}
						<form method="post" hx-boost="false" action={ templ.SafeURL(linkURL(org.ID, "/peers/"+itoa(p.ID)+"/remove")) } data-confirm={ i18n.Tf(ctx, "link.confirm.remove_peer", p.Name) } data-more={ i18n.T(ctx, "link.remove_peer_more") } data-ok={ i18n.T(ctx, "common.remove") } onsubmit="return krillConfirm(this)">
							<button type="submit" class="pill pill--icon pill--danger" aria-label={ i18n.Tf(ctx, "link.remove_peer_named", p.Name) } title={ i18n.T(ctx, "link.remove_peer") }>
								@ui.Icon("i-trash")
							</button>
						</form>
					</li>
				}
			</ul>
		}
		if len(v.OpenCodes) > 0 {
			<p class="hint">
				for i, c := range v.OpenCodes {
					if i > 0 {
						{ " · " }
					}
					{ i18n.Tf(ctx, "link.code_open", c.Peer, c.ExpiresAt.Local().Format("15:04")) }
				}
			</p>
		}
	</section>
	@linkRelayDests(org, v)
	<form class="sec" method="post" hx-boost="false" action={ templ.SafeURL(linkURL(org.ID, "/codes")) } aria-labelledby="lk-h">
		<h3 id="lk-h">{ i18n.T(ctx, "link.new_code") }</h3>
		<p class="hint">{ i18n.T(ctx, "link.new_code_desc") }</p>
		<div class="row row--even">
			<div class="field">
				<label for="lpeer">{ i18n.T(ctx, "link.peer_name") }</label>
				<input class="input input--mono" id="lpeer" name="peer" required placeholder="msk" autocomplete="off" spellcheck="false" maxlength="32"/>
			</div>
			<div class="field">
				<label for="laddr">{ i18n.T(ctx, "link.dial_addr") }</label>
				<input class="input input--mono" id="laddr" name="addr" placeholder={ v.DefaultAddr } autocomplete="off" spellcheck="false" aria-describedby="laddr-hint"/>
				<p class="field-hint" id="laddr-hint">{ i18n.T(ctx, "link.dial_addr_hint") }</p>
			</div>
		</div>
		<div><button type="submit" class="btn btn--primary">{ i18n.T(ctx, "link.create_code") }</button></div>
	</form>
}

templ linkClient(org db.Organization, v LinkView) {
	<section class="sec" aria-labelledby="lr-h">
		<div class="sec-head">
			<h3 id="lr-h">{ i18n.T(ctx, "link.role") }</h3>
			@ui.State("ok", i18n.T(ctx, "link.role.client"))
		</div>
		@linkTurnOff(org, i18n.T(ctx, "link.off_more_client"))
	</section>
	if v.Paired {
		<section class="sec" aria-labelledby="ls-h">
			<div class="sec-head">
				<h3 id="ls-h">{ v.RelaySNI }</h3>
				switch v.Client.State {
					case "connected":
						@ui.State("ok", i18n.T(ctx, "link.state.connected"))
					default:
						@ui.State("warn", i18n.T(ctx, "link.state.connecting"))
				}
			</div>
			<ul class="links">
				<li class="row-item">
					<span class="link-var">{ i18n.T(ctx, "link.relay_addr") }</span>
					<span class="link-src">{ v.RelayAddr }</span>
				</li>
				if v.Client.State == "connected" {
					<li class="row-item">
						<span class="link-var">{ i18n.T(ctx, "link.session") }</span>
						<span class="link-src">{ i18n.Tf(ctx, "link.client_session", linkClock(v.Client.Since), linkMS(v.Client.Latency), v.Client.RelayVersion) }</span>
					</li>
				}
				<li class="row-item">
					<span class="link-var">{ i18n.T(ctx, "link.last_error") }</span>
					<span class="link-src">
						if v.Client.Category == "" {
							{ "—" }
						} else {
							{ i18n.T(ctx, "link.cat."+v.Client.Category) + " · " + linkClock(v.Client.FailedAt) }
							<br/>
							<code>{ v.Client.Message }</code>
						}
					</span>
				</li>
				if !v.Client.CertNotAfter.IsZero() {
					<li class="row-item">
						<span class="link-var">{ i18n.T(ctx, "link.cert") }</span>
						<span class="link-src">{ i18n.Tf(ctx, "link.cert_until", linkDate(v.Client.CertNotAfter)) }</span>
					</li>
				}
			</ul>
			<form method="post" hx-boost="false" action={ templ.SafeURL(linkURL(org.ID, "/forget")) } data-confirm={ i18n.T(ctx, "link.confirm.forget") } data-more={ i18n.T(ctx, "link.forget_more") } data-ok={ i18n.T(ctx, "link.forget") } onsubmit="return krillConfirm(this)">
				<button type="submit" class="pill pill--danger">{ i18n.T(ctx, "link.forget") }</button>
			</form>
		</section>
	}
	@linkClientEgress(org, v)
	<form class="sec" method="post" hx-boost="false" action={ templ.SafeURL(linkURL(org.ID, "/pair")) } aria-labelledby="lq-h">
		<h3 id="lq-h">
			if v.Paired {
				{ i18n.T(ctx, "link.repair") }
			} else {
				{ i18n.T(ctx, "link.pair") }
			}
		</h3>
		<p class="hint">{ i18n.T(ctx, "link.pair_desc") }</p>
		<div class="field">
			<label for="lcode">{ i18n.T(ctx, "link.code") }</label>
			<textarea class="input input--mono textarea" id="lcode" name="code" rows="3" required spellcheck="false" autocomplete="off" placeholder="krl1_…"></textarea>
		</div>
		<div><button type="submit" class="btn btn--primary">{ i18n.T(ctx, "link.pair") }</button></div>
	</form>
}

// linkRelayDests is the relay's destination list: the hard boundary for
// every client.
templ linkRelayDests(org db.Organization, v LinkView) {
	<section class="sec" aria-labelledby="ld-h" data-unsaved-scope>
		<div class="sec-head"><h3 id="ld-h">{ i18n.T(ctx, "link.dests") }</h3></div>
		<p class="hint">{ i18n.T(ctx, "link.dests_desc") }</p>
		if len(v.Dests) == 0 {
			<p class="empty">{ i18n.T(ctx, "link.dests_empty") }</p>
		} else {
			<ul class="links">
				for _, d := range v.Dests {
					<li class="row-item">
						<code class="link-var">{ d.String() }</code>
						<form method="post" hx-boost="false" action={ templ.SafeURL(linkURL(org.ID, "/destinations/remove")) } data-confirm={ i18n.Tf(ctx, "link.confirm.remove_dest", d.String()) } data-more={ i18n.T(ctx, "link.remove_dest_more") } data-ok={ i18n.T(ctx, "common.remove") } onsubmit="return krillConfirm(this)">
							<input type="hidden" name="host" value={ d.Host }/>
							<input type="hidden" name="port" value={ strconv.Itoa(d.Port) }/>
							<button type="submit" class="pill pill--icon pill--danger" aria-label={ i18n.Tf(ctx, "link.remove_dest_named", d.String()) } title={ i18n.T(ctx, "common.remove") }>
								@ui.Icon("i-trash")
							</button>
						</form>
					</li>
				}
			</ul>
		}
		<form class="add-row" method="post" action={ templ.SafeURL(linkURL(org.ID, "/destinations")) }>
			<div class="field">
				<label for="ldh">{ i18n.T(ctx, "link.dest_host") }</label>
				<input class="input input--mono" id="ldh" name="host" required placeholder="api.example.com" autocomplete="off" spellcheck="false"/>
			</div>
			<div class="field">
				<label for="ldp">{ i18n.T(ctx, "link.dest_port") }</label>
				<input class="input input--mono" id="ldp" name="port" type="number" min="1" max="65535" value="443" required/>
			</div>
			<button type="submit" class="pill">{ i18n.T(ctx, "link.dest_add") }</button>
		</form>
	</section>
}

// linkClientEgress is a client's egress: the relay's list, the organization
// grants and the services sending through the link.
templ linkClientEgress(org db.Organization, v LinkView) {
	if v.EgressReqKey != "" {
		<div class="callout callout--warn">
			<div class="callout-body">
				<p>{ i18n.T(ctx, "link.egress_req") }</p>
				<p>{ i18n.T(ctx, v.EgressReqKey) }</p>
			</div>
		</div>
	}
	<section class="sec" aria-labelledby="lrd-h">
		<div class="sec-head"><h3 id="lrd-h">{ i18n.T(ctx, "link.relay_dests") }</h3></div>
		<p class="hint">{ i18n.T(ctx, "link.relay_dests_desc") }</p>
		if !v.RelayEgress && v.Client.State == "connected" {
			<div class="callout callout--warn"><p>{ i18n.T(ctx, "link.relay_no_egress") }</p></div>
		} else if len(v.Dests) == 0 {
			<p class="empty">{ i18n.T(ctx, "link.relay_dests_empty") }</p>
		} else {
			<ul class="links">
				for _, d := range v.Dests {
					<li class="row-item"><code class="link-var">{ d.String() }</code></li>
				}
			</ul>
		}
	</section>
	<section class="sec" aria-labelledby="lg-h">
		<div class="sec-head"><h3 id="lg-h">{ i18n.T(ctx, "link.grants") }</h3></div>
		<p class="hint">{ i18n.T(ctx, "link.grants_desc") }</p>
		@linkGateNote(v.Gate)
		<ul class="links">
			for _, g := range v.Grants {
				<li class="row-item">
					<span class="link-var">{ g.Name }</span>
					if g.Granted {
						@ui.State("ok", i18n.T(ctx, "link.granted"))
						<form method="post" hx-boost="false" action={ templ.SafeURL(linkURL(org.ID, "/grants")) } data-confirm={ i18n.Tf(ctx, "link.confirm.revoke", g.Name) } data-more={ i18n.T(ctx, "link.revoke_more") } data-ok={ i18n.T(ctx, "link.revoke") } onsubmit="return krillConfirm(this)">
							<input type="hidden" name="org_id" value={ itoa(g.OrgID) }/>
							<input type="hidden" name="enabled" value="0"/>
							<button type="submit" class="pill pill--danger" aria-label={ i18n.Tf(ctx, "link.revoke_named", g.Name) }>{ i18n.T(ctx, "link.revoke") }</button>
						</form>
					} else {
						@ui.State("idle", i18n.T(ctx, "link.not_granted"))
						<form method="post" action={ templ.SafeURL(linkURL(org.ID, "/grants")) }>
							<input type="hidden" name="org_id" value={ itoa(g.OrgID) }/>
							<input type="hidden" name="enabled" value="1"/>
							<button type="submit" class="pill" disabled?={ v.Gate.Closed } aria-label={ i18n.Tf(ctx, "link.grant_named", g.Name) }>{ i18n.T(ctx, "link.grant") }</button>
						</form>
					}
				</li>
			}
		</ul>
	</section>
	<section class="sec" aria-labelledby="lsv-h">
		<div class="sec-head"><h3 id="lsv-h">{ i18n.T(ctx, "link.services") }</h3></div>
		if len(v.Services) == 0 {
			<p class="empty">{ i18n.T(ctx, "link.services_empty") }</p>
		} else {
			@linkServices(v.Services, "link.dest.not_allowed")
		}
	</section>
}

// linkServices lists services with their destinations: state and the bytes
// carried since Krill started. offKey names a destination the relay's list
// does not hold.
templ linkServices(svcs []LinkServiceRow, offKey string) {
	<ul class="links">
		for _, s := range svcs {
			<li class="row-item">
				<span class="link-var">{ s.Path }</span>
				<span class="link-src">
					for i, d := range s.Dests {
						if i > 0 {
							<br/>
						}
						<code>{ d.Dest }</code>
						{ " · " }
						if d.Allowed {
							{ i18n.T(ctx, "link.dest.allowed") }
						} else {
							{ i18n.T(ctx, offKey) }
						}
						{ " · " + i18n.Tf(ctx, "link.svc_traffic", humanBytes(d.Up), humanBytes(d.Down)) }
					}
				</span>
			</li>
		}
	</ul>
}

// linkGateNote explains why egress cannot be enabled now, with a link to
// Settings → Updates.
templ linkGateNote(g LinkGate) {
	if g.Closed {
		<div class="callout callout--warn">
			<div class="callout-body">
				<p>{ g.Text }</p>
				<p><a href={ templ.SafeURL(g.UpdatesURL) }>{ i18n.T(ctx, "link.gate.updates") }</a></p>
			</div>
		</div>
	}
}

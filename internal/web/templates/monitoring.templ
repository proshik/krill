package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
)

// Monitoring is the cluster's CPU and memory: charts by node and a column per
// node with its containers. The data comes from /monitoring/data.
templ Monitoring(org db.Organization, role string) {
	@Page(Shell{Title: i18n.Sentence(i18n.T(ctx, "mon.title")), Org: org, Role: role, Tab: "monitoring"}) {
		<main class="wrap wrap--wide">
			<div
				class="mon"
				data-url={ orgURL(org.ID) + "/monitoring/data" }
				data-i18n-stale={ i18n.T(ctx, "mon.stale") }
				data-i18n-cores={ i18n.T(ctx, "mon.cpu_of_cores") }
				data-i18n-memory={ i18n.T(ctx, "mon.memory") }
				data-i18n-containers={ i18n.T(ctx, "mon.containers") }
				data-i18n-healthy={ i18n.T(ctx, "nodes.state_ready") }
				data-i18n-pressure={ i18n.T(ctx, "canvas.memory_pct") }
				data-i18n-error={ i18n.T(ctx, "mon.error") }
				data-i18n-of={ i18n.T(ctx, "mon.of") }
			>
				<div class="page-head">
					<h1>{ i18n.T(ctx, "mon.title") }</h1>
					<div class="page-keys">
						<div class="seg seg--tight" role="group" aria-label={ i18n.T(ctx, "mon.node") } data-mon-nodes>
							<button type="button" aria-pressed="true" data-node="">{ i18n.T(ctx, "mon.all_nodes") }</button>
						</div>
						<div class="seg seg--tight" role="group" aria-label={ i18n.T(ctx, "mon.range") }>
							<button type="button" aria-pressed="false" data-range="1h">1h</button>
							<button type="button" aria-pressed="false" data-range="6h">6h</button>
							<button type="button" aria-pressed="true" data-range="24h">24h</button>
						</div>
					</div>
				</div>
				<p class="hint mon-status" aria-live="polite"></p>
				<div class="charts">
					<section class="chart" data-chart="cpu" aria-label={ i18n.T(ctx, "mon.cpu") }>
						<div class="chart-head"><h2>{ i18n.T(ctx, "mon.cpu") }</h2><span class="run-meta">{ i18n.T(ctx, "mon.pct_of_node") }</span></div>
						<div class="plot"><svg viewBox="0 0 600 200" preserveAspectRatio="none" role="img" aria-label={ i18n.T(ctx, "mon.cpu") }></svg><span class="axis axis--top">100%</span><span class="axis axis--mid">50%</span></div>
						<ul class="ends"></ul>
					</section>
					<section class="chart" data-chart="mem" aria-label={ i18n.T(ctx, "mon.memory") }>
						<div class="chart-head"><h2>{ i18n.T(ctx, "mon.memory") }</h2><span class="run-meta">{ i18n.T(ctx, "mon.pct_of_node") }</span></div>
						<div class="plot"><svg viewBox="0 0 600 200" preserveAspectRatio="none" role="img" aria-label={ i18n.T(ctx, "mon.memory") }></svg><span class="axis axis--top">100%</span><span class="axis axis--mid">50%</span></div>
						<ul class="ends"></ul>
					</section>
				</div>
				<div class="nodecols"></div>
			</div>
		</main>
	}
}

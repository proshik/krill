package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/docker"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// NodeLane is one cluster node on the nodes page.
type NodeLane struct {
	Node      docker.SwarmNode
	Name      string // display name
	Label     string // the stored display label ("" when none)
	Managed   bool   // added through Krill (a worker it can remove)
	CPU, Mem  int    // percent, -1 when unknown
	Cores     int
	MemUsed   int64
	MemTotal  int64
	Apps      []LaneItem
	Servers   []LaneItem
	System    []LaneItem
}

// LaneItem is a card in a node lane.
type LaneItem struct {
	ElemID    string
	Name      string
	Sub       string
	Uses      string
	Href      string
	Glyph     string
	StateKind string
	StateText string
	To        []string
	// Origin says where one of Krill's own services comes from; OriginHref,
	// when set, links the setting that controls it.
	Origin     string
	OriginHref string
}

func laneWarn(l NodeLane) bool { return l.Mem >= 85 || l.Node.State != "ready" }

templ Nodes(org db.Organization, role string, lanes []NodeLane, newNode bool) {
	@Page(Shell{Title: i18n.Sentence(i18n.T(ctx, "nodes.title")), Org: org, Role: role, Tab: "nodes", Body: dashBody(newNode)}) {
		<main class="wrap wrap--wide">
			<div class="page-head">
				<h1>{ i18n.T(ctx, "nodes.title") }</h1>
				<div class="page-keys">
					<a class="pill" href={ templ.SafeURL(orgURL(org.ID) + "/firewall") }>
						@ui.Icon("i-lock")
						{ i18n.T(ctx, "firewall.link") }
					</a>
					if isAdmin(role) {
						<a class="btn btn--primary" href={ templ.SafeURL(orgURL(org.ID) + "/nodes?new=node") }>
							@ui.Icon("i-plus")
							{ i18n.T(ctx, "nodes.add") }
						</a>
					}
				</div>
			</div>
			if len(lanes) == 0 {
				<div class="empty-card"><p class="empty-title">{ i18n.T(ctx, "nodes.empty") }</p></div>
			} else {
				<div class="lanemap" style={ templ.SafeCSS(laneCols(len(lanes))) }>
					<svg class="wires" aria-hidden="true"></svg>
					for _, l := range lanes {
						<section class={ "lane", templ.KV("lane--warn", laneWarn(l)) } id={ "node-" + l.Name } aria-label={ l.Name }>
							<header class="lane-head">
								<div class="lane-title">
									<h2>{ l.Name }</h2>
									@ui.State(nodeStateKind(l.Node), nodeStateText(ctx, l.Node))
								</div>
								<p class="run-meta">{ nodeRoleLine(ctx, l) }</p>
								if l.CPU >= 0 {
									<div class="lane-use">
										<span class="use">
											{ i18n.T(ctx, "nodes.cpu") }
											@ui.Meter(l.CPU, false)
											{ i18n.Tf(ctx, "nodes.cpu_of", l.CPU, l.Cores) }
										</span>
										<span class="use">
											{ i18n.T(ctx, "nodes.memory") }
											@ui.Meter(l.Mem, l.Mem >= 85)
											{ humanBytes(l.MemUsed) + " / " + humanBytes(l.MemTotal) }
										</span>
									</div>
								}
								if isAdmin(role) {
									<div class="lane-keys">
										<form class="lane-label" method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/nodes/" + l.Node.ID + "/label") }>
											<label class="visually-hidden" for={ "nl-" + l.Node.ID }>{ i18n.T(ctx, "nodes.label_ph") }</label>
											<input class="input input--compact" id={ "nl-" + l.Node.ID } name="label" value={ l.Label } placeholder={ i18n.T(ctx, "nodes.label_ph") } maxlength="40" autocomplete="off"/>
											<button type="submit" class="pill pill--small">{ i18n.T(ctx, "nodes.rename") }</button>
										</form>
										if l.Node.Availability == "drain" {
											<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/nodes/" + l.Node.ID + "/availability") }>
												<input type="hidden" name="availability" value="active"/>
												<button type="submit" class="pill pill--small">{ i18n.T(ctx, "nodes.activate") }</button>
											</form>
										} else if !l.Node.Leader {
											<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/nodes/" + l.Node.ID + "/availability") } data-confirm={ i18n.Tf(ctx, "nodes.drain_q", l.Name) } data-more={ i18n.T(ctx, "nodes.drain_more") } data-ok={ i18n.T(ctx, "nodes.drain") } data-kind="primary" onsubmit="return krillConfirm(this)">
												<input type="hidden" name="availability" value="drain"/>
												<button type="submit" class="pill pill--small">{ i18n.T(ctx, "nodes.drain") }</button>
											</form>
										}
										if !l.Node.Leader && l.Managed {
											<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/nodes/" + l.Node.ID + "/remove") } data-confirm={ i18n.Tf(ctx, "confirm.remove_node", l.Name) } data-more={ i18n.T(ctx, "nodes.remove_more") } data-ok={ i18n.T(ctx, "common.remove") } onsubmit="return krillConfirm(this)">
												<button type="submit" class="pill pill--icon pill--danger" aria-label={ i18n.Tf(ctx, "common.remove_named", l.Name) } title={ i18n.T(ctx, "nodes.remove") }>
													@ui.Icon("i-trash")
												</button>
											</form>
										}
									</div>
								}
							</header>
							@laneGroup(i18n.T(ctx, "nodes.group_apps"), l.Apps)
							@laneGroup(i18n.T(ctx, "dbi.title"), l.Servers)
							@laneGroup("Krill", l.System)
							if len(l.Apps)+len(l.Servers)+len(l.System) == 0 {
								<p class="empty lane-empty">{ i18n.T(ctx, "nodes.nothing_here") }</p>
							}
						</section>
					}
				</div>
			}
		</main>
		if newNode {
			@Sheet(i18n.T(ctx, "nodes.add"), "i-node", orgURL(org.ID)+"/nodes") {
				<p class="hint">{ i18n.T(ctx, "nodes.add_hint") }</p>
				<form class="form" method="post" action={ templ.SafeURL(orgURL(org.ID) + "/nodes") }>
					<div class="field">
						<label for="nname">{ i18n.T(ctx, "common.name") }</label>
						<input class="input input--mono" id="nname" name="name" required placeholder="worker-1" autocomplete="off" spellcheck="false"/>
					</div>
					<div class="row">
						<div class="field">
							<label for="nhost">{ i18n.T(ctx, "nodes.ssh_host") }</label>
							<input class="input input--mono" id="nhost" name="ssh_host" required placeholder="203.0.113.21" autocomplete="off" spellcheck="false"/>
						</div>
						<div class="field">
							<label for="nport">{ i18n.T(ctx, "nodes.ssh_port") }</label>
							<input class="input input--mono" id="nport" name="ssh_port" placeholder="22" inputmode="numeric"/>
						</div>
					</div>
					<div class="field">
						<label for="nuser">{ i18n.T(ctx, "nodes.ssh_user") }</label>
						<input class="input input--mono" id="nuser" name="ssh_user" required value="root" autocomplete="off"/>
					</div>
					<div class="field">
						<label for="nkey">{ i18n.T(ctx, "nodes.ssh_key") }</label>
						<textarea class="input input--mono textarea" id="nkey" name="ssh_key" rows="5" spellcheck="false" required placeholder="-----BEGIN OPENSSH PRIVATE KEY-----"></textarea>
					</div>
					<div class="form-keys">
						<button type="submit" class="btn btn--primary">{ i18n.T(ctx, "nodes.add") }</button>
						<a class="pill" href={ templ.SafeURL(orgURL(org.ID) + "/nodes") }>{ i18n.T(ctx, "common.cancel") }</a>
					</div>
				</form>
			}
		}
	}
}

templ laneGroup(title string, items []LaneItem) {
	if len(items) > 0 {
		<div class="lane-group">
			<h3>{ title }</h3>
			for _, it := range items {
				if it.Href != "" {
					<a class="svc" id={ it.ElemID } href={ templ.SafeURL(it.Href) } data-to={ joinSpace(it.To) } data-nodes="">
						@laneItemBody(it)
					</a>
				} else {
					<div class="svc svc--sys" id={ it.ElemID } data-nodes="">
						@laneItemBody(it)
					</div>
				}
			}
		</div>
	}
}

templ laneItemBody(it LaneItem) {
	<span class="svc-head">
		@ui.Glyph(it.Glyph)
		<span class="svc-name">{ it.Name }</span>
		@ui.State(it.StateKind, it.StateText)
	</span>
	if it.Sub != "" {
		<span class="svc-sub">{ it.Sub }</span>
	}
	if it.Uses != "" {
		<span class="uses">{ it.Uses }</span>
	}
	if it.Origin != "" {
		<span class="svc-sub svc-origin">
			{ it.Origin }
			if it.OriginHref != "" {
				<a href={ templ.SafeURL(it.OriginHref) }>{ i18n.T(ctx, "nodes.sys_obs_link") }</a>
			}
		</span>
	}
}

// NodeRemoveConfirm warns that a node still has pinned servers or apps that
// would be orphaned, and asks for an explicit "remove anyway" (force=1).
templ NodeRemoveConfirm(org db.Organization, role string, node docker.SwarmNode, insts []db.ListDBInstancesByNodeHostnameRow, apps []db.ListPinnedApplicationsRow) {
	@Page(Shell{Title: i18n.Sentence(i18n.T(ctx, "nodes.remove_confirm_title")), Org: org, Role: role, Tab: "nodes"}) {
		<main class="wrap wrap--narrow">
			<div class="page-head"><h1>{ i18n.T(ctx, "nodes.remove_confirm_title") }</h1></div>
			<div class="callout callout--warn"><div class="callout-body"><p>{ i18n.Tf(ctx, "nodes.remove_confirm_warn", node.Hostname) }</p></div></div>
			if len(insts) > 0 {
				<section class="sec" aria-labelledby="aff-db-h">
					<h2 id="aff-db-h">{ i18n.T(ctx, "nodes.affected_dbs") }</h2>
					<ul class="links">
						for _, in := range insts {
							<li class="row-item"><span class="link-var">{ in.Name }</span><span class="link-src">{ engineLabel(in.Engine) }</span></li>
						}
					</ul>
				</section>
			}
			if len(apps) > 0 {
				<section class="sec" aria-labelledby="aff-app-h">
					<h2 id="aff-app-h">{ i18n.T(ctx, "nodes.affected_apps") }</h2>
					<ul class="links">
						for _, a := range apps {
							<li class="row-item"><span class="link-var">{ a.Name }</span><span class="link-src">{ a.PlacementMode }</span></li>
						}
					</ul>
				</section>
			}
			<div class="form-keys">
				<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/nodes/" + node.ID + "/remove") }>
					<input type="hidden" name="force" value="1"/>
					<button type="submit" class="btn btn--danger">{ i18n.T(ctx, "nodes.remove_anyway") }</button>
				</form>
				<a class="pill" href={ templ.SafeURL(orgURL(org.ID) + "/nodes") }>{ i18n.T(ctx, "common.cancel") }</a>
			</div>
		</main>
	}
}

package templates

import (
	"time"

	"github.com/proshik/krill/internal/observability"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

templ metricsTab(c AppCtx) {
	<section class="sec" aria-labelledby="col-h">
		<div class="sec-head">
			<h3 id="col-h">{ i18n.T(ctx, "metrics.collection") }</h3>
			if c.admin() {
				if c.MetricsEnabled {
					<form method="post" action={ templ.SafeURL(c.base() + "/metrics/disable") } hx-boost="false" data-confirm={ i18n.T(ctx, "metrics.disable_confirm") } data-ok={ i18n.T(ctx, "metrics.disable") } onsubmit="return krillConfirm(this)">
						@SwitchButton(true, i18n.T(ctx, "metrics.collect"), i18n.T(ctx, "metrics.collect"))
					</form>
				} else {
					<form method="post" action={ templ.SafeURL(c.base() + "/metrics/enable") }>
						@SwitchButton(false, i18n.T(ctx, "metrics.collect"), i18n.T(ctx, "metrics.collect"))
					</form>
				}
			} else if c.MetricsEnabled {
				@ui.State("ok", i18n.T(ctx, "metrics.on"))
			} else {
				@ui.State("idle", i18n.T(ctx, "metrics.off"))
			}
		</div>
		<p class="hint">{ i18n.T(ctx, "metrics.enable_hint") }</p>
	</section>
	<section class="sec" aria-labelledby="ep-h">
		<div class="sec-head"><h3 id="ep-h">{ i18n.T(ctx, "metrics.endpoints") }</h3></div>
		if len(c.MetricsEndpoints) == 0 {
			<p class="empty">{ i18n.T(ctx, "metrics.no_endpoints") }</p>
		} else {
			<ul class="links">
				for _, ep := range c.MetricsEndpoints {
					<li class="ep">
						<code class="link-var">{ ":" + itoa(int64(ep.Port)) + ep.Path }</code>
						<span class="link-src">
							if ep.Job == "" {
								{ i18n.T(ctx, "metrics.job_default") }
							} else {
								{ i18n.Tf(ctx, "metrics.job_named", ep.Job) }
							}
						</span>
						if c.MetricsEnabled && ep.Port == c.App.Port {
							<span class="tag">{ i18n.T(ctx, "metrics.hidden_on_domains") }</span>
						} else {
							<span></span>
						}
						if c.admin() {
							<form method="post" action={ templ.SafeURL(c.base() + "/metrics/endpoints/" + itoa(ep.ID) + "/delete") } hx-boost="false" data-confirm={ i18n.T(ctx, "metrics.remove_confirm") } data-ok={ i18n.T(ctx, "common.remove") } onsubmit="return krillConfirm(this)">
								<button type="submit" class="pill pill--icon" aria-label={ i18n.Tf(ctx, "common.remove_named", ":"+itoa(int64(ep.Port))+ep.Path) } title={ i18n.T(ctx, "common.remove") }>
									@ui.Icon("i-close")
								</button>
							</form>
						}
					</li>
				}
			</ul>
		}
		if c.admin() {
			<form class="link-form link-form--ep" method="post" action={ templ.SafeURL(c.base() + "/metrics/endpoints") }>
				<div class="field"><label for="mp">{ i18n.T(ctx, "metrics.port") }</label><input class="input input--mono" id="mp" type="number" name="port" min="1" max="65535" required value={ itoa(int64(c.App.Port)) }/></div>
				<div class="field"><label for="mpa">{ i18n.T(ctx, "metrics.path") }</label><input class="input input--mono" id="mpa" name="path" value="/metrics" required maxlength="129" spellcheck="false"/></div>
				<div class="field"><label for="mj">{ i18n.T(ctx, "metrics.job") }</label><input class="input input--mono" id="mj" name="job" maxlength="64" placeholder={ i18n.T(ctx, "metrics.job_placeholder") } spellcheck="false"/></div>
				<button type="submit" class="pill">
					@ui.Icon("i-plus")
					{ i18n.T(ctx, "metrics.add_endpoint") }
				</button>
			</form>
		}
	</section>
	if c.admin() {
		<section class="sec" aria-labelledby="tok-h">
			<div class="sec-head"><h3 id="tok-h">{ i18n.T(ctx, "metrics.token") }</h3></div>
			<form class="add-row" method="post" action={ templ.SafeURL(c.base() + "/metrics/token-env") }>
				<div class="field">
					<label for="mtenv">{ i18n.T(ctx, "metrics.token_env") }</label>
					<input class="input input--mono" id="mtenv" name="name" value={ c.MetricsTokenEnv } required maxlength="64" spellcheck="false"/>
				</div>
				<button type="submit" class="pill">{ i18n.T(ctx, "metrics.save_variable") }</button>
			</form>
			if c.MetricsTokenUnreadable {
				<p class="field-err">{ i18n.T(ctx, "metrics.token_unreadable") }</p>
			} else {
				@ui.CopyField("mtok", i18n.T(ctx, "metrics.token"), c.MetricsToken, true, i18n.T(ctx, "common.copy"), i18n.T(ctx, "common.reveal"))
			}
			<div class="sec-add">
				<form method="post" action={ templ.SafeURL(c.base() + "/metrics/token/rotate") } hx-boost="false" data-confirm={ i18n.T(ctx, "metrics.rotate_confirm") } data-ok={ i18n.T(ctx, "metrics.rotate") } data-kind="primary" onsubmit="return krillConfirm(this)">
					<button type="submit" class="pill">{ i18n.T(ctx, "metrics.rotate") }</button>
				</form>
				<span class="hint">{ i18n.T(ctx, "metrics.redeploy_hint") }</span>
			</div>
		</section>
	}
	<section class="sec" aria-labelledby="st-h">
		<div class="sec-head">
			<h3 id="st-h">{ i18n.T(ctx, "metrics.status.title") }</h3>
			<button type="button" class="pill" hx-get={ c.base() + "/metrics/status" } hx-target="#metrics-status">{ i18n.T(ctx, "metrics.status.refresh") }</button>
		</div>
		<div id="metrics-status" hx-get={ c.base() + "/metrics/status" } hx-trigger="load" hx-swap="innerHTML">
			<p class="empty">{ i18n.T(ctx, "metrics.status.loading") }</p>
		</div>
		<p class="hint"><a href="https://github.com/proshik/krill/blob/master/docs/guides/metrics.md" target="_blank" rel="noopener noreferrer">{ i18n.T(ctx, "metrics.guide_link") }</a></p>
	</section>
}

type MetricsStatus struct {
	Problem   string
	Endpoints []observability.EndpointStatus
}

templ AppMetricsStatus(v MetricsStatus) {
	if v.Problem != "" {
		<p class="callout">{ v.Problem }</p>
	} else if len(v.Endpoints) == 0 {
		<p class="empty">{ i18n.T(ctx, "metrics.no_endpoints") }</p>
	} else {
		for _, ep := range v.Endpoints {
			<h4 class="list-head">{ i18n.T(ctx, "metrics.endpoint") + " #" + itoa(ep.EndpointID) }</h4>
			if !ep.Found {
				<p class="empty">{ i18n.T(ctx, "metrics.status.not_in_module") }</p>
			} else if ep.Resolved == 0 {
				<p class="empty">{ i18n.T(ctx, "metrics.status.no_replicas_dns") }</p>
			} else if ep.Kept == 0 {
				<p class="empty">{ i18n.T(ctx, "metrics.status.no_replicas_node") }</p>
			} else {
				<ul class="targets">
					for _, target := range ep.Targets {
						<li>
							<code>{ target.Instance }</code>
							<span class="run-node">{ target.Node }</span>
							@ui.State(scrapeKind(target.Health), target.Health)
							<span class="run-meta">
								if target.LastScrape.IsZero() {
									{ i18n.T(ctx, "metrics.status.never") }
								} else {
									{ i18n.Tf(ctx, "metrics.status.ago", time.Since(target.LastScrape).Round(time.Second).String()) }
								}
							</span>
							if target.LastError != "" {
								<p class="deploy-msg deploy-msg--err target-err">{ target.LastError }</p>
							}
						</li>
					}
				</ul>
			}
		}
	}
}

func scrapeKind(health string) string {
	switch health {
	case "up":
		return "ok"
	case "down":
		return "err"
	}
	return "idle"
}

package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// GitCredentials lists the organization's git credentials with the apps
// that clone through each.
templ GitCredentials(org db.Organization, role string, creds []db.GitCredential, usedBy map[int64][]UsedBy) {
	@SettingsPage(org, role, "git", i18n.T(ctx, "gitcred.title")) {
		<section class="sec" aria-labelledby="gc-h">
			if len(creds) == 0 {
				<p class="empty" id="gc-h">{ i18n.T(ctx, "gitcred.empty") }</p>
			} else {
				<div class="sec-head"><h3 id="gc-h">{ i18n.Tn(ctx, "gitcred.n", len(creds)) }</h3></div>
				<ul class="regs">
					for _, gc := range creds {
						<li class="reg">
							<div class="reg-top">
								<span class="reg-name">{ gc.Name }</span>
								<code class="reg-host">{ gc.Host }</code>
								<span class="run-meta">{ i18n.Tf(ctx, "gitcred.as", gc.Username) }</span>
								if isAdmin(role) {
									<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/git-credentials/" + itoa(gc.ID) + "/delete") } data-confirm={ i18n.Tf(ctx, "confirm.delete_gitcred", gc.Name) } data-more={ i18n.T(ctx, "gitcred.delete_more") } data-ok={ i18n.T(ctx, "common.delete") } onsubmit="return krillConfirm(this)">
										<button type="submit" class="pill pill--icon pill--danger" aria-label={ i18n.Tf(ctx, "common.delete_named", gc.Name) } title={ i18n.T(ctx, "common.delete") }>
											@ui.Icon("i-trash")
										</button>
									</form>
								}
							</div>
							<div class="reg-used">
								<span class="field-label">{ i18n.T(ctx, "envdb.used_by") }</span>
								@usedByChips(usedBy[gc.ID])
							</div>
						</li>
					}
				</ul>
			}
			<p class="hint">{ i18n.T(ctx, "gitcred.desc") }</p>
		</section>
		if isAdmin(role) {
			<form class="sec" method="post" action={ templ.SafeURL(orgURL(org.ID) + "/git-credentials") } aria-labelledby="ag-h">
				<h3 id="ag-h">{ i18n.T(ctx, "gitcred.add_title") }</h3>
				<div class="row row--even">
					<div class="field"><label for="gname">{ i18n.T(ctx, "common.name") }</label><input class="input" id="gname" name="name" required placeholder="github" autocomplete="off"/></div>
					<div class="field">
						<label for="ghost">{ i18n.T(ctx, "gitcred.host") }</label>
						<input class="input input--mono" id="ghost" name="host" required placeholder="github.com" autocomplete="off" spellcheck="false" aria-describedby="ghost-hint"/>
						<p class="field-hint" id="ghost-hint">{ i18n.T(ctx, "gitcred.host_only") }</p>
					</div>
				</div>
				<div class="row row--even">
					<div class="field"><label for="guser">{ i18n.T(ctx, "gitcred.username") }</label><input class="input input--mono" id="guser" name="username" required placeholder="x-access-token" autocomplete="off" spellcheck="false"/></div>
					<div class="field"><label for="gtok">{ i18n.T(ctx, "gitcred.token") }</label><input class="input input--mono" id="gtok" name="token" type="password" required autocomplete="new-password"/></div>
				</div>
				<div><button type="submit" class="btn btn--primary">{ i18n.T(ctx, "gitcred.add") }</button></div>
			</form>
		}
	}
}

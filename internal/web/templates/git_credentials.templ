package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
)

templ GitCredentials(org db.Organization, role string, creds []db.GitCredential) {
	@Layout(i18n.T(ctx, "gitcred.title"), org, role) {
		@settingsNav(org.ID)
		<p class="mb-4" style="color:var(--color-muted);max-width:680px">{ i18n.T(ctx, "gitcred.desc") }</p>
		<div class="k-card">
			<table class="k-table">
				<thead>
					<tr>
						<th>{ i18n.T(ctx, "gitcred.name") }</th>
						<th>{ i18n.T(ctx, "gitcred.host") }</th>
						<th>{ i18n.T(ctx, "gitcred.username") }</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, gc := range creds {
						<tr>
							<td>{ gc.Name }</td><td class="k-mono">{ gc.Host }</td><td>{ gc.Username }</td>
							<td>
								if role == "owner" || role == "admin" {
									<form method="post" hx-boost="false" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/git-credentials/" + itoa(gc.ID) + "/delete") } data-confirm={ i18n.Tf(ctx, "confirm.delete_gitcred", gc.Name) } onsubmit="return krillConfirm(this, this.dataset.confirm)">
										<button class="k-btn k-btn-danger">{ i18n.T(ctx, "gitcred.delete") }</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			if role == "owner" || role == "admin" {
				<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/git-credentials") } class="mt-4 flex flex-col gap-2">
					<div>
						<label class="k-label k-label-required">{ i18n.T(ctx, "gitcred.name") }</label>
						<input class="k-input" name="name" required/>
					</div>
					<div>
						<label class="k-label k-label-required">{ i18n.T(ctx, "gitcred.host") }</label>
						<input class="k-input" name="host" required placeholder="github.com"/>
					</div>
					<div>
						<label class="k-label k-label-required">{ i18n.T(ctx, "gitcred.username") }</label>
						<input class="k-input" name="username" required placeholder="x-access-token"/>
					</div>
					<div>
						<label class="k-label k-label-required">{ i18n.T(ctx, "gitcred.token") }</label>
						<input class="k-input" name="token" type="password" required/>
					</div>
					<div><button class="k-btn k-btn-primary">{ i18n.T(ctx, "gitcred.add") }</button></div>
				</form>
			}
		</div>
	}
}

package ui

// Badge рендерит статус-бейдж со статус-точкой.
templ Badge(status string) {
	<span class={ "k-badge", "k-badge-" + status }><span class="k-dot"></span>{ status }</span>
}

// PrimaryButton — основная кнопка (submit по умолчанию).
templ PrimaryButton(label string) {
	<button type="submit" class="k-btn k-btn-primary">{ label }</button>
}

// Toast — баннер успеха/ошибки/инфо. kind: "ok" | "err".
templ Toast(kind, msg string) {
	<div class={ "k-toast", "k-toast-" + kind }>{ msg }</div>
}

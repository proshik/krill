package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// APITokens renders the signed-in user's personal access tokens. plainToken
// is non-empty exactly once, right after creation — it comes from a one-shot
// flash cookie (see Server.takeFlashToken) and is never persisted, so it can
// never appear here on a later page load.
templ APITokens(org db.Organization, role string, tokens []db.ApiToken, plainToken, baseURL string) {
	@SettingsPage(org, role, "tokens", i18n.T(ctx, "api_tokens.title")) {
		if plainToken != "" {
			<div class="callout callout--ok" role="status">
				<div class="callout-body">
					@ui.State("ok", i18n.T(ctx, "api_tokens.created"))
					<p class="hint">{ i18n.T(ctx, "api_tokens.created_once") }</p>
					<div class="input-group">
						<input class="input input--mono" value={ plainToken } readonly aria-label={ i18n.T(ctx, "api_tokens.new_token") }/>
						@ui.CopyButton(plainToken, i18n.T(ctx, "common.copy"))
					</div>
				</div>
			</div>
		}
		<section class="sec" aria-labelledby="ep-h">
			<h3 id="ep-h">{ i18n.T(ctx, "api_tokens.endpoints") }</h3>
			<div class="row row--even">
				@ui.CopyField("rest", "REST", baseURL+"/api/v1", false, i18n.T(ctx, "common.copy"), "")
				@ui.CopyField("mcp", "MCP", baseURL+"/mcp", false, i18n.T(ctx, "common.copy"), "")
			</div>
			<p class="hint">{ i18n.T(ctx, "api_tokens.header_hint") }</p>
		</section>
		<section class="sec" aria-labelledby="tk-h">
			<div class="sec-head"><h3 id="tk-h">{ i18n.T(ctx, "api_tokens.yours") }</h3></div>
			if len(tokens) == 0 {
				<p class="empty">{ i18n.T(ctx, "api_tokens.empty") }</p>
			} else {
				<ul class="tokens">
					for _, t := range tokens {
						<li class="token">
							<span class="token-who">
								<span class="token-name">{ t.Name }</span>
								<span class={ "tag", templ.KV("tag--level", t.Level != "read") }>{ i18n.T(ctx, "api_tokens.level_"+t.Level) }</span>
							</span>
							<code class="token-prefix">{ tokenPrefixDisplay(t.Prefix) }</code>
							<span class="run-meta">
								if t.ExpiresAt.Valid {
									{ i18n.Tf(ctx, "api_tokens.expires_at", t.ExpiresAt.Time.Local().Format("2006-01-02")) }
								} else {
									{ i18n.T(ctx, "api_tokens.expires_never") }
								}
							</span>
							<span class="run-meta">
								if t.LastUsedAt.Valid {
									{ i18n.Tf(ctx, "api_tokens.used_ago", ago(ctx, t.LastUsedAt.Time)) }
								} else {
									{ i18n.T(ctx, "api_tokens.never_used") }
								}
							</span>
							<form method="post" hx-boost="false" action={ templ.SafeURL(orgURL(org.ID) + "/api-tokens/" + itoa(t.ID) + "/delete") } data-confirm={ i18n.Tf(ctx, "api_tokens.revoke_confirm", t.Name) } data-more={ i18n.T(ctx, "api_tokens.revoke_more") } data-ok={ i18n.T(ctx, "api_tokens.revoke") } onsubmit="return krillConfirm(this)">
								<button type="submit" class="pill pill--icon pill--danger" aria-label={ i18n.Tf(ctx, "api_tokens.revoke_named", t.Name) } title={ i18n.T(ctx, "api_tokens.revoke") }>
									@ui.Icon("i-trash")
								</button>
							</form>
						</li>
					}
				</ul>
			}
			<p class="hint">{ i18n.T(ctx, "api_tokens.desc") }</p>
		</section>
		if isAdmin(role) {
			<form class="sec" method="post" action={ templ.SafeURL(orgURL(org.ID) + "/api-tokens") } aria-labelledby="ct-h">
				<h3 id="ct-h">{ i18n.T(ctx, "api_tokens.create_title") }</h3>
				<div class="row row--even">
					<div class="field">
						<label for="tname">{ i18n.T(ctx, "api_tokens.name") }</label>
						<input class="input input--mono" id="tname" name="name" required placeholder="release-bot" autocomplete="off" spellcheck="false"/>
					</div>
					<div class="field">
						<label for="texp">{ i18n.T(ctx, "api_tokens.expires") }</label>
						<select class="input" id="texp" name="expires">
							<option value="30d">{ i18n.T(ctx, "api_tokens.expires_30d") }</option>
							<option value="90d" selected>{ i18n.T(ctx, "api_tokens.expires_90d") }</option>
							<option value="never">{ i18n.T(ctx, "api_tokens.never") }</option>
						</select>
					</div>
				</div>
				<fieldset class="choice choice--three">
					<legend>{ i18n.T(ctx, "api_tokens.level") }</legend>
					<label class="choice-card"><input type="radio" name="level" value="read" checked/><span class="choice-name">{ i18n.T(ctx, "api_tokens.level_read") }</span><span class="choice-sub">{ i18n.T(ctx, "api_tokens.level_read_sub") }</span></label>
					<label class="choice-card"><input type="radio" name="level" value="write"/><span class="choice-name">{ i18n.T(ctx, "api_tokens.level_write") }</span><span class="choice-sub">{ i18n.T(ctx, "api_tokens.level_write_sub") }</span></label>
					<label class="choice-card"><input type="radio" name="level" value="provision"/><span class="choice-name">{ i18n.T(ctx, "api_tokens.level_provision") }</span><span class="choice-sub">{ i18n.T(ctx, "api_tokens.level_provision_sub") }</span></label>
				</fieldset>
				<div><button type="submit" class="btn btn--primary">{ i18n.T(ctx, "api_tokens.create") }</button></div>
			</form>
		}
	}
}

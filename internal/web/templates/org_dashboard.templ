package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// ProjectCard is one project on the projects page: its environments with a
// health summary and a miniature of the first one.
type ProjectCard struct {
	Project db.Project
	Envs    []ProjectEnv
	Mini    []string // state kinds of the first environment's cards
}

// ProjectEnv is one environment row of a project card.
type ProjectEnv struct {
	ID        int64
	Name      string
	StateKind string
	StateText string
}

// ClusterNode is one node of the cluster strip (instance operators only).
type ClusterNode struct {
	Name      string
	CPU, Mem  int
	StateKind string
	StateText string
}

templ OrgDashboard(org db.Organization, role string, projects []ProjectCard, cluster []ClusterNode, newProject bool) {
	@Page(Shell{Title: i18n.Sentence(i18n.T(ctx, "projects.page_title")), Org: org, Role: role, Tab: "projects", Body: dashBody(newProject)}) {
		<main class="wrap wrap--wide">
			<div class="page-head"><h1>{ i18n.T(ctx, "projects.title") }</h1></div>
			if len(projects) == 0 {
				<div class="empty-card">
					<p class="empty-title">{ i18n.T(ctx, "projects.empty") }</p>
					<p class="hint">{ i18n.T(ctx, "projects.empty_hint") }</p>
					if isAdmin(role) {
						<a class="btn btn--primary" href={ templ.SafeURL(orgURL(org.ID) + "?new=project") }>
							@ui.Icon("i-plus")
							{ i18n.T(ctx, "projects.new") }
						</a>
					}
				</div>
			} else {
				<ul class="projects">
					for _, pc := range projects {
						<li class="project">
							<a class="project-main" href={ templ.SafeURL(projectURL(org.ID, pc.Project.ID)) }>
								<span class="mini" aria-hidden="true">
									for _, k := range pc.Mini {
										<span class={ "mini-svc", "mini-svc--" + k }></span>
									}
								</span>
								<span class="project-name">{ pc.Project.Name }</span>
								if pc.Project.Description != "" {
									<span class="run-meta project-desc">{ pc.Project.Description }</span>
								}
							</a>
							if len(pc.Envs) == 0 {
								<p class="empty project-none">{ i18n.T(ctx, "project.no_envs") }</p>
							} else {
								<ul class="project-envs" aria-label={ i18n.Tf(ctx, "projects.envs_of", pc.Project.Name) }>
									for _, e := range pc.Envs {
										<li>
											<a href={ templ.SafeURL(envURL(org.ID, pc.Project.ID, e.ID)) }>
												<span class="project-env">{ e.Name }</span>
												@ui.State(e.StateKind, e.StateText)
											</a>
										</li>
									}
								</ul>
							}
						</li>
					}
				</ul>
			}
			if len(cluster) > 0 {
				<section class="nodes-strip" aria-labelledby="cluster-h">
					<h2 id="cluster-h">{ i18n.T(ctx, "projects.cluster") }</h2>
					<ul>
						for _, n := range cluster {
							<li>
								<a href={ templ.SafeURL(orgURL(org.ID) + "/nodes#node-" + n.Name) }>
									<span class="run-node">{ n.Name }</span>
									<span class="run-meta">{ i18n.Tf(ctx, "projects.node_use", n.CPU, n.Mem) }</span>
									@ui.State(n.StateKind, n.StateText)
								</a>
							</li>
						}
					</ul>
				</section>
			}
		</main>
		if newProject {
			@Sheet(i18n.T(ctx, "project.new_modal_title"), "", orgURL(org.ID)) {
				<form class="form" method="post" action={ templ.SafeURL(orgURL(org.ID) + "/projects") }>
					<div class="field">
						<label for="np-name">{ i18n.T(ctx, "common.name") }</label>
						<input class="input" id="np-name" name="name" required placeholder="payments" autocomplete="off" autofocus/>
					</div>
					<div class="field">
						<label for="np-desc">{ i18n.T(ctx, "common.description") }</label>
						<textarea class="input textarea" id="np-desc" name="description" rows="2" placeholder={ i18n.T(ctx, "common.optional") }></textarea>
					</div>
					<p class="hint">{ i18n.T(ctx, "project.new_then_env") }</p>
					<div class="form-keys">
						<button type="submit" class="btn btn--primary">{ i18n.T(ctx, "projects.create") }</button>
						<a class="pill" href={ templ.SafeURL(orgURL(org.ID)) }>{ i18n.T(ctx, "common.cancel") }</a>
					</div>
				</form>
			}
		}
	}
}

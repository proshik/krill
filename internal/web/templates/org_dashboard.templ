package templates

import db "github.com/proshik/krill/internal/database/gen"

type ProjectCard struct {
	Project  db.Project
	EnvCount int64
}

templ OrgDashboard(org db.Organization, role string, projects []ProjectCard) {
	@Layout("Проекты", org, role) {
		<div class="flex justify-between items-center mb-4">
			<h2 class="text-2xl">Проекты</h2>
			if role == "owner" || role == "admin" {
				<details>
					<summary class="cursor-pointer"><span class="k-btn k-btn-primary">+ Проект</span></summary>
					<form method="post" action={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects") } class="k-card mt-2">
						<label class="k-label">Имя</label>
						<input class="k-input" name="name" required placeholder="My App"/>
						<label class="k-label">Описание</label>
						<input class="k-input" name="description" placeholder="(необязательно)"/>
						<div class="mt-2"><button type="submit" class="k-btn k-btn-primary">Создать</button></div>
					</form>
				</details>
			}
		</div>
		if len(projects) == 0 {
			<div class="k-card"><p class="k-mono">Пока нет проектов.</p></div>
		} else {
			<div class="grid grid-cols-2 gap-3">
				for _, pc := range projects {
					<a class="k-card hover:border-[color:var(--color-border-strong)]" href={ templ.SafeURL("/orgs/" + itoa(org.ID) + "/projects/" + itoa(pc.Project.ID)) }>
						<div class="font-semibold text-base mb-1">{ pc.Project.Name }</div>
						<div class="k-mono text-xs">{ itoa(pc.EnvCount) } окружений</div>
					</a>
				}
			</div>
		}
	}
}

package templates

import (
	db "github.com/proshik/krill/internal/database/gen"
	"github.com/proshik/krill/internal/web/i18n"
	"github.com/proshik/krill/internal/web/templates/ui"
)

// Orgs is the organization list: where a person lands with no organization
// to go to, and where they create another one.
templ Orgs(orgs []db.Organization) {
	@Bare(i18n.T(ctx, "orgs.page_title")) {
		<h1>{ i18n.T(ctx, "orgs.title") }</h1>
		if len(orgs) == 0 {
			<p class="hint">{ i18n.T(ctx, "orgs.empty") }</p>
		} else {
			<ul class="links">
				for _, o := range orgs {
					<li class="row-item row-item--link">
						<a class="link-var" href={ templ.SafeURL(orgURL(o.ID)) }>{ o.Name }</a>
					</li>
				}
			</ul>
		}
		<form method="post" action="/orgs" class="stack">
			<div class="field">
				<label for="org-new">{ i18n.T(ctx, "orgs.new_label") }</label>
				<input class="input" id="org-new" name="name" required placeholder="harbor" autocomplete="off"/>
			</div>
			<button type="submit" class="btn btn--primary btn--wide">{ i18n.T(ctx, "orgs.create") }</button>
		</form>
	}
}

// OrgSwitcher fills the organization crumb's menu: the person's organizations
// (the current one marked) and the way to the full list.
templ OrgSwitcher(orgs []db.Organization, currentID int64) {
	for _, o := range orgs {
		<a href={ templ.SafeURL(orgURL(o.ID)) } aria-current?={ o.ID == currentID }>{ o.Name }</a>
	}
	<a class="envmenu-add" href="/orgs">
		@ui.Icon("i-plus")
		{ i18n.T(ctx, "orgs.all") }
	</a>
}

package templates

import db "github.com/proshik/krill/internal/database/gen"

templ Orgs(orgs []db.Organization) {
	@Bare("Организации") {
		<div class="card" style="width:420px;">
			<h2>Ваши организации</h2>
			if len(orgs) == 0 {
				<p>Нет организаций.</p>
			} else {
				<ul style="list-style:none; padding:0;">
					for _, o := range orgs {
						<li style="margin:8px 0;">
							<a href={ templ.SafeURL("/orgs/" + itoa(o.ID)) }>{ o.Name }</a>
						</li>
					}
				</ul>
			}
			<form method="post" action="/orgs" style="margin-top:16px;">
				<label>Новая организация</label>
				<input name="name" required placeholder="My Company"/>
				<button type="submit" style="margin-top:8px;">Создать</button>
			</form>
		</div>
	}
}

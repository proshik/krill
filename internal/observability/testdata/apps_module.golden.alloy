// Generated by Krill (app Metrics tabs). Served at /_krill/alloy/apps.
declare "targets" {
  argument "forward_to" {}

  discovery.dns "app_7_3" {
    names = ["tasks.krill-7"]
    type  = "A"
    port  = 27015
  }

  discovery.relabel "app_7_3" {
    targets = discovery.dns.app_7_3.targets

    rule {
      source_labels = ["__address__"]
      regex         = "10\\.0\\.1\\.5:27015"
      target_label  = "__tmp_krill_node"
      replacement   = "krill-cp-msk"
    }

    rule {
      source_labels = ["__tmp_krill_node"]
      regex         = ".+"
      action        = "keep"
    }

    rule {
      source_labels = ["__tmp_krill_node"]
      target_label  = "krill_node"
    }

    rule {
      target_label = "krill_org"
      replacement  = "Acme"
    }

    rule {
      target_label = "krill_org_id"
      replacement  = "1"
    }

    rule {
      target_label = "krill_project"
      replacement  = "bots"
    }

    rule {
      target_label = "krill_env"
      replacement  = "prod"
    }

    rule {
      target_label = "krill_app"
      replacement  = "base13"
    }

    rule {
      target_label = "krill_app_id"
      replacement  = "7"
    }

    rule {
      action = "labeldrop"
      regex  = "__tmp_krill_node"
    }
  }

  prometheus.scrape "app_7_3" {
    targets         = discovery.relabel.app_7_3.output
    job_name        = "relay"
    metrics_path    = "/metrics"
    scrape_interval = "30s"
    scrape_timeout  = "10s"
    honor_labels    = false

    // One collector serves every tenant: a target over these limits fails
    // alone (up=0, visible on its Metrics tab) instead of exhausting the
    // collector's memory for everyone.
    sample_limit             = 5000
    body_size_limit          = "5MiB"
    label_limit              = 40
    label_value_length_limit = 2048

    authorization {
      type        = "Bearer"
      credentials = "t0k"
    }
    forward_to = argument.forward_to.value
  }

  discovery.dns "app_9_4" {
    names = ["tasks.krill-9"]
    type  = "A"
    port  = 3000
  }

  discovery.relabel "app_9_4" {
    targets = discovery.dns.app_9_4.targets

    rule {
      source_labels = ["__address__"]
      regex         = "10\\.0\\.2\\.7:3000"
      target_label  = "__tmp_krill_node"
      replacement   = "db узел"
    }

    rule {
      source_labels = ["__address__"]
      regex         = "10\\.0\\.2\\.8:3000"
      target_label  = "__tmp_krill_node"
      replacement   = "worker.1"
    }

    rule {
      source_labels = ["__tmp_krill_node"]
      regex         = ".+"
      action        = "keep"
    }

    rule {
      source_labels = ["__tmp_krill_node"]
      target_label  = "krill_node"
    }

    rule {
      target_label = "krill_org"
      replacement  = "Org $$1"
    }

    rule {
      target_label = "krill_org_id"
      replacement  = "2"
    }

    rule {
      target_label = "krill_project"
      replacement  = "p"
    }

    rule {
      target_label = "krill_env"
      replacement  = "e"
    }

    rule {
      target_label = "krill_app"
      replacement  = "gitea"
    }

    rule {
      target_label = "krill_app_id"
      replacement  = "9"
    }

    rule {
      action = "labeldrop"
      regex  = "__tmp_krill_node"
    }
  }

  prometheus.scrape "app_9_4" {
    targets         = discovery.relabel.app_9_4.output
    job_name        = "gitea"
    metrics_path    = "/metrics"
    scrape_interval = "30s"
    scrape_timeout  = "10s"
    honor_labels    = false

    // One collector serves every tenant: a target over these limits fails
    // alone (up=0, visible on its Metrics tab) instead of exhausting the
    // collector's memory for everyone.
    sample_limit             = 5000
    body_size_limit          = "5MiB"
    label_limit              = 40
    label_value_length_limit = 2048

    authorization {
      type        = "Bearer"
      credentials = "t1k"
    }
    forward_to = argument.forward_to.value
  }
}

// Generated by Krill (Settings → Observability). Krill replaces this file on
// every settings change; edits made here are lost.

prometheus.remote_write "default" {
  endpoint {
    url              = "https://m.example/api/v1/push"
    protobuf_message = "prometheus.WriteRequest"

    basic_auth {
      username = "u"
      password_file = "/run/secrets/krill_metrics_password"
    }
  }
}

remote.http "apps" {
  url            = "http://10.0.0.1:8080/_krill/alloy/apps"
  poll_frequency = "30s"
  poll_timeout   = "10s"
  is_secret      = true

  client {
    authorization {
      type             = "Bearer"
      credentials_file = "/run/secrets/krill_apps_provider"
    }
  }
}

import.string "apps" {
  content = remote.http.apps.content
}

apps.targets "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}
